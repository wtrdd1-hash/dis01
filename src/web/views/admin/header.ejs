        </a>
        <a class="channel-item <%= activeMenu === 'console' ? 'active' : '' %>" href="/admin/console"><span class="channel-hash">#</span>명령-조작</a>
        <a class="channel-item <%= activeMenu === 'security' ? 'active' : '' %>" href="/admin/security"><span class="channel-hash">#</span>보안-차단</a>
        <a class="channel-item <%= activeMenu === 'inquiries' ? 'active' : '' %>" href="/admin/inquiries"><span class="channel-hash">#</span>1:1문의</a>
        
        <div class="channel-cat">📋 실시간 로그</div>
        <a class="channel-item <%= activeMenu === 'logs' ? 'active' : '' %>" href="/admin/logs"><span class="channel-hash">#</span>종합-로그뷰어</a>
      </div>
      <div class="user-panel">
        <div class="user-avatar-wrap">
          <img src="<%= adminUser && adminUser.avatar ? `https://cdn.discordapp.com/avatars/${adminUser.id}/${adminUser.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" class="user-avatar">
          <span class="user-status-dot online"></span>
        </div>
        <div class="user-meta">
          <div class="user-name"><%= adminUser && adminUser.username ? adminUser.username : '관리자' %></div>
          <div class="user-tag">관리자</div>
        </div>
      </div>
    </aside>

    <!-- 우측 메인 컨텐츠 영역 -->
    <div class="chat-main admin-main">
      <header class="channel-topbar">
        <button type="button" class="drawer-toggle" onclick="toggleAdminDrawers('channels')" aria-label="메뉴 열기">☰</button>
        <div class="channel-title">
          <span class="hash">#</span>
          <h1><%= pageHeader || '관리자 관제' %></h1>
        </div>
        <div class="topbar-actions" style="display:flex; align-items:center; gap:10px; margin-left:auto;">
          <div id="admin-live-badge" style="display:flex; align-items:center; gap:6px; background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.35); padding:4px 10px; border-radius:20px; font-size:0.75rem; color:#34d399; font-weight:700;">
            <span style="width:7px; height:7px; background:#10b981; border-radius:50%; display:inline-block; box-shadow:0 0 8px #10b981;"></span>
            <span>실시간 자동 동기화 ON</span>
          </div>
          <a href="/" class="btn-logout" style="text-decoration:none; padding:6px 12px; background:rgba(255,255,255,0.06); border:1px solid var(--border); border-radius:8px; color:#fff; font-size:12px; font-weight:700;">← 사이트 홈</a>
          <a href="/auth/logout" class="btn-logout" style="text-decoration:none; padding:6px 12px; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:8px; color:#f87171; font-size:12px; font-weight:700;">로그아웃</a>
        </div>
      </header>

      <main class="admin-content">
        <div id="admin-action-result" style="display:none; padding:12px 16px; border-radius:8px; margin-bottom:16px; font-weight:600;"></div>
