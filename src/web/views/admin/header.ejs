  <style>
    :root {
      --bg: #090d16;
      --card: #0f172a;
      --card-alt: #131d33;
      --border: rgba(255, 255, 255, 0.08);
      --border-focus: rgba(99, 102, 241, 0.5);
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; width: 100%; }
    body {
      font-family: var(--font, Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif);
      background-color: var(--bg);
      color: var(--text-main);
      line-height: 1.5;
      overflow-x: hidden;
    }
    
    /* 레이아웃 & 컨테이너 유동형 자동 조절 */
    .app-shell { display: flex; height: 100vh; width: 100vw; overflow: hidden; }
    .chat-main.admin-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
      min-width: 0;
      background: #090d16;
      overflow: hidden;
    }
    .admin-content {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding: clamp(12px, 1.5vw, 24px);
    }
    .admin-container {
      width: 100%;
      max-width: 1800px;
      margin: 0 auto;
    }

    /* 카드 & 컨테이너 */
    .card {
      background-color: var(--card);
      border-radius: 14px;
      padding: clamp(14px, 1.5vw, 24px);
      margin-bottom: clamp(14px, 1.5vw, 24px);
      border: 1px solid var(--border);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      transition: border-color 0.2s ease;
      width: 100%;
    }
    .card:hover { border-color: rgba(255, 255, 255, 0.12); }
    .card h2 { margin-bottom: 12px; font-size: clamp(1.1rem, 1rem + 0.3vw, 1.35rem); font-weight: 800; color: #f8fafc; letter-spacing: -0.01em; }
    .card h3 { font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.1rem); font-weight: 700; color: #e2e8f0; }

    /* 테이블 유동형 디자인 */
    table { width: 100%; border-collapse: separate; border-spacing: 0; margin-top: 10px; font-size: clamp(0.8rem, 0.76rem + 0.15vw, 0.88rem); }
    th, td { padding: clamp(8px, 0.8vw, 14px) clamp(10px, 1vw, 15px); text-align: left; border-bottom: 1px solid var(--border); vertical-align: middle; }
    th { color: #94a3b8; font-weight: 700; background-color: rgba(255, 255, 255, 0.02); font-size: clamp(0.72rem, 0.7rem + 0.1vw, 0.8rem); letter-spacing: 0.02em; white-space: nowrap; }
    tbody tr { transition: background-color 0.12s ease; }
    tbody tr:hover { background-color: rgba(255, 255, 255, 0.035); }
    tbody tr:last-child td { border-bottom: none; }

    /* 커스텀 슬림 스크롤바 */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }

    /* 공통 뱃지 & 태그 */
    .status-ok { color: #34d399; font-weight: 700; }
    .status-err { color: #f87171; font-weight: 700; }
    .badge-admin { background: rgba(217, 119, 6, 0.15); color: #fbbf24; border: 1px solid rgba(217, 119, 6, 0.3); font-size: 0.75rem; padding: 3px 8px; border-radius: 6px; font-weight: 700; white-space: nowrap; }
    .btn-rollback { background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; font-weight: 700; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 0.75rem; transition: all 0.15s ease; white-space: nowrap; }
    .btn-rollback:hover { background: #ef4444; color: #fff; transform: translateY(-1px); }

    /* 인풋 & 셀렉트 */
    input[type="text"], input[type="number"], select, textarea {
      background: #030712;
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #fff;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: clamp(0.8rem, 0.78rem + 0.15vw, 0.88rem);
      font-family: inherit;
      outline: none;
      transition: all 0.15s ease;
    }
    input[type="text"]:focus, input[type="number"]:focus, select:focus, textarea:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
    }

    /* 토스트 알림 */
    .admin-toast { position: fixed; bottom: 24px; right: 24px; z-index: 1000; padding: 14px 22px; border-radius: 10px; font-size: 0.92rem; font-weight: 700; display: none; box-shadow: 0 12px 32px rgba(0,0,0,0.6); backdrop-filter: blur(8px); animation: toastIn 0.25s ease-out; }
    @keyframes toastIn { from { transform: translateY(12px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .admin-toast.is-on { display: flex; align-items: center; gap: 8px; }
    .admin-toast.is-ok { background: rgba(6, 95, 70, 0.95); color: #a7f3d0; border: 1px solid #10b981; }
    .admin-toast.is-err { background: rgba(127, 29, 29, 0.95); color: #fecaca; border: 1px solid #ef4444; }
    
    /* 사이드바 메뉴 활성화 */
    .channel-item { transition: all 0.15s ease; border-radius: 6px; margin: 1px 0; }
    .channel-item:hover { background: rgba(255, 255, 255, 0.05); color: #fff; }
    .channel-item.active { background: rgba(99, 102, 241, 0.2) !important; color: #818cf8 !important; font-weight: 800; border-left: 3px solid #6366f1; }

    /* 반응형 화면 미디어 쿼리 */
    @media (max-width: 1024px) {
      .channel-sidebar { position: fixed; left: -260px; z-index: 100; transition: left 0.25s ease; height: 100vh; }
      .channel-sidebar.open { left: 72px; }
      .drawer-toggle { display: inline-flex !important; }
    }
    @media (max-width: 768px) {
      .admin-content { padding: 12px; }
      .server-rail { width: 56px; }
      .channel-sidebar.open { left: 56px; }
    }
  </style>

  <script>
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    async function adminFetch(url, opts) {
      const init = Object.assign({
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
      }, opts || {});
      if (init.body && typeof init.body === 'object' && !(init.body instanceof FormData)) {
        init.body = JSON.stringify(init.body);
      }
      const res = await fetch(url, init);
      const data = await res.json().catch(function() {
        return { success: false, error: '응답 파싱 실패 (HTTP ' + res.status + ')' };
      });
      if (!res.ok && !data.error) data.error = '요청 실패 (HTTP ' + res.status + ')';
      return data;
    }

    function adminNotice(ok, msg) {
      const text = msg || (ok ? '처리되었습니다.' : '처리에 실패했습니다.');
      const el = document.getElementById('admin-action-result');
      if (el) {
        el.style.display = 'block';
        el.style.background = ok ? 'rgba(16,185,129,0.12)' : 'rgba(239,68,68,0.12)';
        el.style.border = '1px solid ' + (ok ? '#10b981' : '#ef4444');
        el.style.color = ok ? '#6ee7b7' : '#fca5a5';
        el.textContent = text;
      }
      let toast = document.getElementById('admin-toast');
      if (toast) {
        toast.className = 'admin-toast is-on ' + (ok ? 'is-ok' : 'is-err');
        toast.textContent = text;
        clearTimeout(adminNotice._hide);
        adminNotice._hide = setTimeout(function() { toast.classList.remove('is-on'); }, 4200);
      }
    }
  </script>
</head>
