<%- include('header', { activeMenu: 'users', pageTitle: '실시간 유저 자산 순위 & 포트폴리오 - 관리자', pageHeader: '유저-자산' }) %>

<div class="admin-container">
<!-- 🌟 유저 자산 관리 메인 카드 -->
<div class="card dx-card--padded" style="border: 1px solid rgba(99, 102, 241, 0.35); background: #0b1120; width: 100%;">

  <!-- 상단 헤더 & 검색 컨트롤 -->
  <div class="dx-page-header">
    <div>
      <h2 class="dx-page-title">
        <span style="font-size:24px;">💎</span>
        실시간 유저 자산 순위 & 포트폴리오
      </h2>
      <p class="dx-page-subtitle">서버 내 모든 유저의 현금, 은행 예금, 주식 평가액 및 총 순자산을 실시간으로 모니터링합니다.</p>
    </div>

    <div class="dx-flex dx-gap-2">
      <div class="dx-search-bar" style="width:280px;">
        <span style="color:#94a3b8;font-size:16px;">🔍</span>
        <input type="text" id="admin-user-search" placeholder="닉네임 / Discord ID 실시간 검색..." oninput="filterAdminUsers()" aria-label="유저 검색">
      </div>
      <button type="button" onclick="openDirectUserDeletePrompt()" class="dx-btn dx-btn--danger" style="background:#b91c1c; border-color:#ef4444;" title="특정 유저의 Discord ID를 직접 입력하여 삭제/초기화">
        <span style="font-size:14px;">🗑️</span>
        <span>특정 유저 삭제</span>
      </button>
      <button type="button" onclick="refreshUserWealthTable()" class="dx-btn dx-btn--primary">
        <span style="font-size:14px;">↻</span>
        <span>자산 갱신</span>
      </button>
    </div>
  </div>

  <!-- 📊 전체 서버 경제 요약 타일 -->
  <div class="admin-stat-grid">
    <div class="admin-stat-card users">
      <div class="stat-label">👥 총 일반 유저 수</div>
      <div class="stat-value" style="color:#c084fc;"><%= summaryStats.totalUsersCount %>명</div>
      <div class="stat-sub">관리자 <%= summaryStats.adminCount || 0 %>명 별도</div>
    </div>
    <div class="admin-stat-card cash">
      <div class="stat-label">💵 총 유통 현금</div>
      <div class="stat-value" style="color:#34d399;"><%= formatMoney(summaryStats.totalCash) %></div>
      <div class="stat-sub">유저 지갑 합계</div>
    </div>
    <div class="admin-stat-card bank">
      <div class="stat-label">🏦 총 은행 예치금</div>
      <div class="stat-value" style="color:#60a5fa;"><%= formatMoney(summaryStats.totalBank) %></div>
      <div class="stat-sub">이자 시간당 0.05%</div>
    </div>
    <div class="admin-stat-card stock">
      <div class="stat-label">📊 총 주식 평가액</div>
      <div class="stat-value" style="color:#fbbf24;"><%= formatMoney(summaryStats.totalStock) %></div>
      <div class="stat-sub">시세 변동 실시간</div>
    </div>
    <div class="admin-stat-card" style="--accent-color:#c084fc;">
      <div class="stat-label">💎 전체 순자산 총합</div>
      <div class="stat-value" style="color:#c084fc;"><%= formatMoney(summaryStats.totalNet) %></div>
      <div class="stat-sub">현금 + 예금 + 주식</div>
    </div>
  </div>

  <!-- 일반 유저 테이블 -->
  <div style="margin-bottom: 25px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <h3 style="color:#fbbf24; margin:0; display:flex; align-items:center; gap:6px;">
        <span>👤 일반 유저 자산 순위</span>
      </h3>
      <span id="user-filter-count" style="font-size:0.8rem; color:#94a3b8;"></span>
    </div>

    <div class="admin-table-wrap">
      <table style="min-width:880px; width:100%;">
        <thead>
          <tr>
            <th style="width:180px;">유저 계정</th>
            <th style="text-align:right; width:150px;">💵 보유 현금</th>
            <th style="text-align:right; width:150px;">🏦 은행 예금 (0.05%/h)</th>
            <th style="text-align:right; width:150px;">📊 보유 주식 평가액</th>
            <th style="text-align:right; width:170px;">💎 총 순자산</th>
            <th style="text-align:center; width:160px;">빠른 관리 작업</th>
          </tr>
        </thead>
        <tbody id="admin-users-tbody">
          <%- userRowsHtml %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 관리자 계정 테이블 -->
  <% if (adminUserRowsHtml) { %>
  <div style="margin-top: 30px; border-top: 1px dashed rgba(255,255,255,0.1); padding-top: 20px;">
    <h3 style="color:#c084fc; margin-bottom:12px; display:flex; align-items:center; gap:6px;">
      <span>👑 봇 관리자 계정 (운영진)</span>
    </h3>
    <div class="admin-table-wrap">
      <table style="min-width:880px; width:100%;">
        <thead>
          <tr>
            <th style="width:180px;">관리자 계정</th>
            <th style="text-align:right; width:150px;">💵 보유 현금</th>
            <th style="text-align:right; width:150px;">🏦 은행 예금</th>
            <th style="text-align:right; width:150px;">📊 보유 주식 평가액</th>
            <th style="text-align:right; width:170px;">💎 총 순자산</th>
            <th style="text-align:center; width:160px;">빠른 관리 작업</th>
          </tr>
        </thead>
        <tbody>
          <%- adminUserRowsHtml %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<!-- 🧹 유저 데이터 초기화 & 삭제 컨트롤 센터 (관리자 전용) -->
<div style="margin-top:24px; border:2px solid rgba(251, 146, 60, 0.45); background: #130e0a; border-radius:16px; padding:24px; box-shadow:0 10px 30px rgba(0,0,0,0.6);">
  
  <!-- 상단 탭 스위처: [전체 일괄 초기화] vs [특정 유저 개별 삭제] -->
  <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(251, 146, 60, 0.3); padding-bottom:16px; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
    <div>
      <h3 style="color:#fdba74; margin:0; font-size:20px; font-weight:900; display:flex; align-items:center; gap:8px;">
        <span style="font-size:24px;">🧹</span> 유저 데이터 초기화 & 삭제 관리 센터
      </h3>
      <p style="color:#94a3b8; font-size:13px; margin:4px 0 0 0;">
        관리자 <strong style="color:#34d399;"><%= (typeof adminIds !== 'undefined' ? adminIds.length : 3) %></strong>개 계정은 영구 보존되며, 전체 또는 특정 1명의 데이터를 안전하게 초기화/삭제합니다.
      </p>
    </div>

    <!-- 모드 전환 탭 버튼 -->
    <div style="display:flex; gap:8px; background:rgba(0,0,0,0.5); padding:4px; border-radius:10px; border:1px solid rgba(255,255,255,0.1);">
      <button type="button" id="tab-btn-bulk" onclick="switchResetTab('bulk')" style="padding:8px 16px; border-radius:8px; font-weight:800; font-size:13px; border:none; cursor:pointer; background:#ea580c; color:#fff; transition:all 0.2s ease;">
        🌐 전체 일반 유저 일괄 초기화
      </button>
      <button type="button" id="tab-btn-single" onclick="switchResetTab('single')" style="padding:8px 16px; border-radius:8px; font-weight:800; font-size:13px; border:none; cursor:pointer; background:transparent; color:#94a3b8; transition:all 0.2s ease;">
        🎯 특정 유저 1명 지정 삭제/초기화
      </button>
    </div>
  </div>

  <!-- [탭 1] 🌐 전체 일반 유저 일괄 초기화 섹션 -->
  <div id="reset-tab-bulk-content">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:10px; margin-bottom:16px;">
      <label class="reset-table-option" style="display:flex; align-items:center; gap:8px; padding:12px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">
        <input type="checkbox" id="reset-table-users" checked style="width:18px; height:18px; accent-color:#f97316;">
        <span style="font-weight:800; color:#f8fafc;">👤 users</span>
        <span style="font-size:11px; color:#94a3b8;">(현금 1만, 주식 0 리셋)</span>
      </label>
      <label class="reset-table-option" style="display:flex; align-items:center; gap:8px; padding:12px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">
        <input type="checkbox" id="reset-table-user_stocks" checked style="width:18px; height:18px; accent-color:#f97316;">
        <span style="font-weight:800; color:#f8fafc;">📊 user_stocks</span>
        <span style="font-size:11px; color:#94a3b8;">(보유 주식 전량 삭제)</span>
      </label>
      <label class="reset-table-option" style="display:flex; align-items:center; gap:8px; padding:12px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">
        <input type="checkbox" id="reset-table-user_businesses" checked style="width:18px; height:18px; accent-color:#f97316;">
        <span style="font-weight:800; color:#f8fafc;">🏢 user_businesses</span>
        <span style="font-size:11px; color:#94a3b8;">(사업체 전량 초기화)</span>
      </label>
      <label class="reset-table-option" style="display:flex; align-items:center; gap:8px; padding:12px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">
        <input type="checkbox" id="reset-table-user_loan_credit" checked style="width:18px; height:18px; accent-color:#f97316;">
        <span style="font-weight:800; color:#f8fafc;">💳 user_loan_credit</span>
        <span style="font-size:11px; color:#94a3b8;">(대출/신용도 리셋)</span>
      </label>
      <label class="reset-table-option" style="display:flex; align-items:center; gap:8px; padding:12px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">
        <input type="checkbox" id="reset-table-gambling_logs" checked style="width:18px; height:18px; accent-color:#f97316;">
        <span style="font-weight:800; color:#f8fafc;">🎰 gambling_logs</span>
        <span style="font-size:11px; color:#94a3b8;">(도박 로그 삭제)</span>
      </label>
      <label class="reset-table-option" style="display:flex; align-items:center; gap:8px; padding:12px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">
        <input type="checkbox" id="reset-table-stock_transactions" style="width:18px; height:18px; accent-color:#f97316;">
        <span style="font-weight:800; color:#f8fafc;">📈 stock_transactions</span>
        <span style="font-size:11px; color:#94a3b8;">(주식 체결 로그)</span>
      </label>
      <label class="reset-table-option" style="display:flex; align-items:center; gap:8px; padding:12px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">
        <input type="checkbox" id="reset-table-economy_logs" style="width:18px; height:18px; accent-color:#f97316;">
        <span style="font-weight:800; color:#f8fafc;">📜 economy_logs</span>
        <span style="font-size:11px; color:#94a3b8;">(경제 이동 로그)</span>
      </label>
    </div>

    <div style="background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.35); border-radius:12px; padding:14px 18px; margin-bottom:18px; display:flex; gap:12px; align-items:center;">
      <span style="font-size:24px;">⚠️</span>
      <div style="font-size:13px; color:#fca5a5; line-height:1.5;">
        <strong style="color:#fff; font-size:14px; display:block; margin-bottom:2px;">이 작업은 되돌릴 수 없습니다 (전체 일반 유저 대상)</strong>
        체크한 테이블의 모든 일반 유저 데이터가 즉시 초기화됩니다. 봇은 다운타임 없이 정상 가동되며, 관리자 3개 계정은 완벽히 보존됩니다.
      </div>
    </div>

    <!-- 🔥 크고 선명한 전체 초기화 실행 버튼 -->
    <div>
      <button type="button" id="btn-reset-all-confirm" style="width:100%; padding:18px 24px; font-size:17px; font-weight:900; background:linear-gradient(135deg, #dc2626, #991b1b); color:#ffffff; border:2px solid #f87171; border-radius:12px; cursor:pointer; box-shadow:0 6px 25px rgba(220,38,38,0.6); display:flex; align-items:center; justify-content:center; gap:10px; transition:all 0.2s ease;">
        <span style="font-size:20px;">🧹</span>
        <span>체크한 테이블 전체 일반 유저 일괄 초기화 실행</span>
      </button>
    </div>
  </div>

  <!-- [탭 2] 🎯 특정 유저 1명 지정 삭제/초기화 섹션 -->
  <div id="reset-tab-single-content" style="display:none;">
    <div style="background:rgba(30,41,59,0.6); border:1px solid rgba(255,255,255,0.1); border-radius:12px; padding:18px; margin-bottom:16px;">
      <label style="font-size:14px; color:#38bdf8; font-weight:900; display:block; margin-bottom:8px;">
        🎯 대상 유저 Discord ID (숫자) 또는 닉네임 입력
      </label>
      <div style="display:flex; gap:10px;">
        <input type="text" id="panel-single-user-id" placeholder="예: 1398148023393058846 또는 닉네임 입력..." style="flex:1; background:#030712; border:1px solid rgba(255,255,255,0.2); padding:12px 16px; border-radius:10px; color:#fff; font-size:15px; font-weight:700;">
        <button type="button" onclick="openSingleUserModalFromPanel()" style="padding:12px 24px; background:linear-gradient(135deg, #0284c7, #38bdf8); border:none; border-radius:10px; color:#fff; font-weight:900; font-size:14px; cursor:pointer; white-space:nowrap; box-shadow:0 4px 15px rgba(2,132,199,0.4);">
          🔍 유저 조회 및 삭제 옵션 열기
        </button>
      </div>
      <p style="font-size:12px; color:#94a3b8; margin:8px 0 0 0;">
        💡 위 테이블 목록 우측의 <span style="background:#b91c1c; color:#fff; padding:2px 6px; border-radius:4px; font-size:11px; font-weight:800;">🗑️ 삭제</span> 버튼을 눌러도 즉시 해당 유저 삭제/초기화 모달을 띄울 수 있습니다.
      </p>
    </div>
  </div>

  <div id="reset-all-toast" style="margin-top:14px;"></div>
</div>

<script>
  function switchResetTab(tab) {
    const bulkContent = document.getElementById('reset-tab-bulk-content');
    const singleContent = document.getElementById('reset-tab-single-content');
    const bulkBtn = document.getElementById('tab-btn-bulk');
    const singleBtn = document.getElementById('tab-btn-single');

    if (tab === 'bulk') {
      bulkContent.style.display = 'block';
      singleContent.style.display = 'none';
      bulkBtn.style.background = '#ea580c';
      bulkBtn.style.color = '#fff';
      singleBtn.style.background = 'transparent';
      singleBtn.style.color = '#94a3b8';
    } else {
      bulkContent.style.display = 'none';
      singleContent.style.display = 'block';
      bulkBtn.style.background = 'transparent';
      bulkBtn.style.color = '#94a3b8';
      singleBtn.style.background = '#0284c7';
      singleBtn.style.color = '#fff';
    }
  }

  function openSingleUserModalFromPanel() {
    const val = (document.getElementById('panel-single-user-id') || {}).value;
    if (!val || !val.trim()) {
      alert('대상 유저의 Discord ID 또는 닉네임을 입력하세요.');
      return;
    }
    openSingleUserDeleteModal(val.trim(), val.trim());
  }

  (function() {
    const btn = document.getElementById('btn-reset-all-confirm');
    const toast = document.getElementById('reset-all-toast');
    if (!btn) return;

    btn.addEventListener('click', function() {
      const checked = Array.from(document.querySelectorAll('.reset-table-option input[type="checkbox"]:checked'))
        .map(el => el.id.replace('reset-table-', ''));
      if (checked.length === 0) {
        alert('최소 1개 테이블을 선택하세요.');
        return;
      }
      
      const confirmText = `🚨 [경고] 다음 선택한 테이블의 '전체 일반 유저' 데이터를 초기화합니다.\n(관리자 3계정은 보존됩니다)\n\n• 대상 테이블: ${checked.join(', ')}\n\n정말로 실행하시겠습니까?`;
      if (!confirm(confirmText)) return;

      btn.disabled = true;
      btn.innerHTML = '<span>⏳</span> <span>전체 초기화 트랜잭션 실행 중... 잠시만 기다려 주세요.</span>';
      
      fetch('/admin/action/reset-all', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tables: checked })
      })
      .then(r => r.json())
      .then(data => {
        btn.disabled = false;
        btn.innerHTML = '<span>🧹</span> <span>체크한 테이블 전체 일반 유저 일괄 초기화 실행</span>';
        if (!data.success) {
          alert('초기화 실패: ' + (data.error || '알 수 없는 오류'));
          return;
        }
        const s = data.summary || {};
        alert(`🎉 전체 일반 유저 데이터 초기화 완료!\n- 초기화 유저: ${s.usersReset || 0}명\n- 삭제된 주식: ${s.stocksDeleted || 0}건\n- 삭제된 사업: ${s.businessesDeleted || 0}건\n- 삭제된 도박로그: ${s.gamblingLogsDeleted || 0}건`);
        location.reload();
      })
      .catch(e => {
        btn.disabled = false;
        btn.innerHTML = '<span>🧹</span> <span>체크한 테이블 전체 일반 유저 일괄 초기화 실행</span>';
        alert('서버 통신 실패: ' + e.message);
      });
    });
  })();
</script>

<!-- 🚫 유저 로그인 차단 / 해제 모달 -->
<div id="user-ban-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); backdrop-filter:blur(6px); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:#0f172a; border:1px solid rgba(239,68,68,0.4); border-radius:16px; padding:28px; width:100%; max-width:460px; box-shadow:0 20px 40px rgba(0,0,0,0.8);">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:12px; margin-bottom:18px;">
      <h3 id="ban-modal-title" style="margin:0; font-size:1.2rem; color:#f87171; font-weight:800; display:flex; align-items:center; gap:8px;">
        <span>🚫 유저 로그인 차단 설정</span>
      </h3>
      <button type="button" onclick="closeUserBanModal()" style="background:none; border:none; color:#94a3b8; font-size:1.5rem; cursor:pointer;">&times;</button>
    </div>

    <input type="hidden" id="ban-target-id">
    
    <div style="margin-bottom:16px;">
      <div style="font-size:0.85rem; color:#94a3b8; margin-bottom:4px;">대상 유저</div>
      <div id="ban-target-name" style="font-size:1.1rem; font-weight:800; color:#f8fafc;">@유저</div>
    </div>

    <div id="ban-form-inputs">
      <div style="margin-bottom:14px;">
        <label style="font-size:0.8rem; color:#94a3b8; font-weight:700; display:block; margin-bottom:6px;">차단 기간 (시간 단위 설정 가능)</label>
        <select id="ban-duration" style="width:100%; background:#030712; border:1px solid rgba(255,255,255,0.15); padding:10px; border-radius:8px; color:#fff; font-weight:700; font-size:0.9rem;">
          <option value="1">⏳ 1시간 정지 (단기 경고)</option>
          <option value="3">⏳ 3시간 정지</option>
          <option value="6">⏳ 6시간 정지</option>
          <option value="12">⏳ 12시간 정지</option>
          <option value="24" selected>⏳ 24시간 정지 (1일)</option>
          <option value="72">⏳ 3일 정지 (72시간)</option>
          <option value="168">⏳ 7일 정지 (1주일)</option>
          <option value="720">⏳ 30일 정지 (1개월)</option>
          <option value="0">🔒 영구 차단 (Permanent Ban)</option>
        </select>
      </div>

      <div style="margin-bottom:20px;">
        <label style="font-size:0.8rem; color:#94a3b8; font-weight:700; display:block; margin-bottom:6px;">차단 사유</label>
        <input type="text" id="ban-reason" placeholder="예: 악성 도배 / 버그 악용 / 규정 위반" style="width:100%; background:#030712; border:1px solid rgba(255,255,255,0.15); padding:10px; border-radius:8px; color:#fff; font-size:0.9rem;">
      </div>

      <div style="display:flex; gap:10px;">
        <button type="button" onclick="submitUserBan()" style="flex:1; background:linear-gradient(135deg, #b91c1c, #ef4444); border:none; color:#fff; padding:12px; border-radius:8px; font-weight:800; font-size:0.95rem; cursor:pointer; box-shadow:0 4px 12px rgba(239,68,68,0.35);">
          🚫 로그인 즉시 차단 실행
        </button>
        <button type="button" onclick="closeUserBanModal()" style="background:#334155; border:1px solid rgba(255,255,255,0.15); color:#cbd5e1; padding:12px 18px; border-radius:8px; font-weight:700; cursor:pointer;">
          취소
        </button>
      </div>
    </div>

    <div id="unban-form-inputs" style="display:none;">
      <p style="color:#cbd5e1; font-size:0.9rem; line-height:1.5; margin-bottom:20px;">
        현재 이 유저는 로그인이 차단되어 있습니다.<br>
        차단을 즉시 해제하여 정상 서비스 이용을 허용하시겠습니까?
      </p>
      <div style="display:flex; gap:10px;">
        <button type="button" onclick="submitUserUnban()" style="flex:1; background:linear-gradient(135deg, #059669, #10b981); border:none; color:#fff; padding:12px; border-radius:8px; font-weight:800; font-size:0.95rem; cursor:pointer; box-shadow:0 4px 12px rgba(16,185,129,0.35);">
          🔓 즉시 차단 해제 (정상 복구)
        </button>
        <button type="button" onclick="closeUserBanModal()" style="background:#334155; border:1px solid rgba(255,255,255,0.15); color:#cbd5e1; padding:12px 18px; border-radius:8px; font-weight:700; cursor:pointer;">
          취소
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // ⌨️ Ctrl+K / Cmd+K 검색창 단축키
  document.addEventListener('keydown', function(e){
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      const input = document.getElementById('admin-user-search');
      if (input) { input.focus(); input.select(); }
    }
    if (e.key === 'Escape') {
      const input = document.getElementById('admin-user-search');
      if (input && document.activeElement === input) {
        input.value = '';
        filterAdminUsers();
        input.blur();
      }
    }
  });

  function filterAdminUsers() {
    const q = String((document.getElementById('admin-user-search') || {}).value || '').toLowerCase().trim();
    let count = 0;
    document.querySelectorAll('#admin-users-tbody tr').forEach(function(tr) {
      const txt = tr.textContent.toLowerCase();
      const match = !q || txt.includes(q);
      tr.style.display = match ? '' : 'none';
      if (match) count++;
    });
    const info = document.getElementById('user-filter-count');
    if (info) {
      info.textContent = q ? '🔍 검색 결과: ' + count + '명' : '총 ' + document.querySelectorAll('#admin-users-tbody tr').length + '명';
    }
  }

  // 페이지 로드 시 카운트 초기 표시
  setTimeout(filterAdminUsers, 50);

  async function refreshUserWealthTable() {
    location.reload();
  }

  function openUserBanModal(userId, username, isBanned) {
    document.getElementById('ban-target-id').value = userId;
    document.getElementById('ban-target-name').textContent = '@' + username + ' (' + userId + ')';
    
    const banInputs = document.getElementById('ban-form-inputs');
    const unbanInputs = document.getElementById('unban-form-inputs');
    const title = document.getElementById('ban-modal-title');
    
    if (isBanned) {
      banInputs.style.display = 'none';
      unbanInputs.style.display = 'block';
      title.innerHTML = '<span>🔓 유저 로그인 차단 해제</span>';
      title.style.color = '#34d399';
    } else {
      banInputs.style.display = 'block';
      unbanInputs.style.display = 'none';
      title.innerHTML = '<span>🚫 유저 로그인 차단 설정</span>';
      title.style.color = '#f87171';
      document.getElementById('ban-reason').value = '';
    }
    
    const modal = document.getElementById('user-ban-modal');
    modal.style.display = 'flex';
  }

  function closeUserBanModal() {
    document.getElementById('user-ban-modal').style.display = 'none';
  }

  async function submitUserBan() {
    const userId = document.getElementById('ban-target-id').value;
    const durationHours = document.getElementById('ban-duration').value;
    const reason = document.getElementById('ban-reason').value || '관리자 직권 로그인 차단';

    if (!userId) return;

    try {
      const res = await adminFetch('/api/admin/action/user-ban', {
        method: 'POST',
        body: { userId, durationHours, reason, confirm: true }
      });

      if (res.success) {
        adminNotice(true, res.message || '유저 차단 완료');
        closeUserBanModal();
        setTimeout(() => location.reload(), 800);
      } else {
        adminNotice(false, res.error || '유저 차단 실패');
      }
    } catch (e) {
      adminNotice(false, '유저 차단 통신 오류');
    }
  }

  async function submitUserUnban() {
    const userId = document.getElementById('ban-target-id').value;
    if (!userId) return;

    try {
      const res = await adminFetch('/api/admin/action/user-unban', {
        method: 'POST',
        body: { userId, reason: '관리자 차단 해제', confirm: true }
      });

      if (res.success) {
        adminNotice(true, res.message || '유저 차단 해제 완료');
        closeUserBanModal();
        setTimeout(() => location.reload(), 800);
      } else {
        adminNotice(false, res.error || '차단 해제 실패');
      }
    } catch (e) {
      adminNotice(false, '차단 해제 통신 오류');
    }
  }

  // 🗑️ 특정 유저 개별 삭제/초기화 모달 컨트롤
  function openDirectUserDeletePrompt() {
    const input = prompt('삭제/초기화할 대상 유저의 Discord ID (숫자) 또는 닉네임을 입력하세요:');
    if (!input || !input.trim()) return;
    openSingleUserDeleteModal(input.trim(), input.trim());
  }

  function openSingleUserDeleteModal(userId, username) {
    document.getElementById('delete-target-id').value = userId;
    document.getElementById('delete-target-name').textContent = '@' + username + ' (' + userId + ')';
    document.getElementById('delete-mode-complete').checked = true;
    toggleDeleteModeUI();
    document.getElementById('user-delete-modal').style.display = 'flex';
  }

  function closeSingleUserDeleteModal() {
    document.getElementById('user-delete-modal').style.display = 'none';
  }

  function toggleDeleteModeUI() {
    const isComplete = document.getElementById('delete-mode-complete').checked;
    const tableOptions = document.getElementById('delete-table-options-container');
    const warningText = document.getElementById('delete-mode-warning-text');
    const submitBtn = document.getElementById('btn-submit-user-delete');
    
    if (isComplete) {
      tableOptions.style.opacity = '0.4';
      tableOptions.style.pointerEvents = 'none';
      warningText.innerHTML = '⚠️ <b>[완전 삭제 모드]</b> 유저 계정과 모든 보유 자산(현금/예금/주식/사업/로그/인벤토리)이 DB에서 <b>영구히 완전히 삭제(DELETE)</b>됩니다.';
      submitBtn.textContent = '🔥 계정 및 전 데이터 영구 삭제 실행';
      submitBtn.style.background = 'linear-gradient(135deg, #991b1b, #dc2626)';
    } else {
      tableOptions.style.opacity = '1';
      tableOptions.style.pointerEvents = 'auto';
      warningText.innerHTML = '🧹 <b>[데이터 초기화 모드]</b> 유저 계정은 보존되며, 아래 체크된 항목만 삭제되고 <b>현금 10,000원 기본값</b>으로 리셋됩니다.';
      submitBtn.textContent = '🧹 선택 데이터 초기화 실행';
      submitBtn.style.background = 'linear-gradient(135deg, #d97706, #f59e0b)';
    }
  }

  function toggleAllDeleteTables(selectAll) {
    document.querySelectorAll('.single-delete-table-checkbox').forEach(cb => {
      cb.checked = selectAll;
    });
  }

  async function submitSingleUserDelete() {
    const userId = document.getElementById('delete-target-id').value;
    if (!userId) return;

    const isComplete = document.getElementById('delete-mode-complete').checked;
    const mode = isComplete ? 'complete' : 'reset';
    const checkedTables = Array.from(document.querySelectorAll('.single-delete-table-checkbox:checked')).map(cb => cb.value);

    if (!isComplete && checkedTables.length === 0) {
      return dx.showToast('초기화할 테이블을 최소 1개 이상 선택하세요.', 'warning');
    }

    const confirmMsg = isComplete
      ? `🚨 정말로 유저 [${userId}]의 계정과 모든 데이터를 완전히 영구 삭제하시겠습니까?\n이 작업은 절대 되돌릴 수 없습니다!`
      : `⚠️ 유저 [${userId}]의 선택된 데이터를 초기화하시겠습니까? (현금 1만 기본값으로 리셋)`;

    if (!confirm(confirmMsg)) return;

    const btn = document.getElementById('btn-submit-user-delete');
    btn.disabled = true;
    btn.textContent = '⏳ 처리 중...';

    try {
      const res = await adminFetch('/api/admin/action/delete-single-user', {
        method: 'POST',
        body: {
          userId,
          deleteMode: mode,
          tables: checkedTables
        }
      });

      if (res.success) {
        alert(res.message || '삭제/초기화 처리가 완료되었습니다.');
        closeSingleUserDeleteModal();
        location.reload();
      } else {
        alert('삭제 실패: ' + (res.error || '오류가 발생했습니다.'));
      }
    } catch (e) {
      alert('서버 통신 오류가 발생했습니다.');
    } finally {
      btn.disabled = false;
      toggleDeleteModeUI();
    }
  }
</script>

<!-- 🗑️ 특정 유저 개별 삭제 / 초기화 모달 -->
<div id="user-delete-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.88); backdrop-filter:blur(8px); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:#0f172a; border:2px solid rgba(239,68,68,0.5); border-radius:20px; padding:28px; width:100%; max-width:540px; box-shadow:0 25px 60px rgba(0,0,0,0.9); max-height:90vh; overflow-y:auto;">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:14px; margin-bottom:18px;">
      <h3 style="margin:0; font-size:1.25rem; color:#f87171; font-weight:900; display:flex; align-items:center; gap:8px;">
        <span>🗑️</span> 특정 유저 데이터 삭제 및 초기화
      </h3>
      <button type="button" onclick="closeSingleUserDeleteModal()" style="background:none; border:none; color:#94a3b8; font-size:1.6rem; cursor:pointer;">&times;</button>
    </div>

    <input type="hidden" id="delete-target-id">

    <div style="background:rgba(30,41,59,0.7); border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:14px; margin-bottom:16px;">
      <div style="font-size:0.8rem; color:#94a3b8; font-weight:700;">대상 유저</div>
      <div id="delete-target-name" style="font-size:1.15rem; font-weight:900; color:#38bdf8; margin-top:2px;">@유저</div>
    </div>

    <!-- 삭제 모드 선택 -->
    <div style="margin-bottom:16px;">
      <label style="font-size:0.85rem; color:#cbd5e1; font-weight:800; display:block; margin-bottom:8px;">삭제/초기화 모드 선택</label>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <label style="display:flex; align-items:center; gap:8px; padding:12px; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.4); border-radius:10px; cursor:pointer;">
          <input type="radio" name="deleteModeRadio" id="delete-mode-complete" value="complete" checked onchange="toggleDeleteModeUI()">
          <div>
            <div style="font-weight:900; color:#f87171; font-size:0.88rem;">🔥 완전 영구 삭제</div>
            <div style="font-size:0.75rem; color:#94a3b8;">계정 자체를 완전히 제거</div>
          </div>
        </label>
        <label style="display:flex; align-items:center; gap:8px; padding:12px; background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.4); border-radius:10px; cursor:pointer;">
          <input type="radio" name="deleteModeRadio" id="delete-mode-reset" value="reset" onchange="toggleDeleteModeUI()">
          <div>
            <div style="font-weight:900; color:#fbbf24; font-size:0.88rem;">🧹 데이터 초기화</div>
            <div style="font-size:0.75rem; color:#94a3b8;">계정 유지 + 1만 리셋</div>
          </div>
        </label>
      </div>
    </div>

    <div id="delete-mode-warning-text" style="font-size:0.82rem; color:#fbbf24; background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.25); border-radius:10px; padding:10px 14px; margin-bottom:16px; line-height:1.4;">
      <!-- 동적 경고 문구 -->
    </div>

    <!-- 테이블 선택 (초기화 모드일 때 선택 가능) -->
    <div id="delete-table-options-container" style="margin-bottom:20px; transition:opacity 0.2s ease;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <span style="font-size:0.82rem; color:#94a3b8; font-weight:700;">초기화 대상 테이블 선택</span>
        <div style="display:flex; gap:6px;">
          <button type="button" onclick="toggleAllDeleteTables(true)" style="background:none; border:none; color:#38bdf8; font-size:0.75rem; font-weight:700; cursor:pointer;">전체선택</button>
          <span style="color:#64748b;">|</span>
          <button type="button" onclick="toggleAllDeleteTables(false)" style="background:none; border:none; color:#94a3b8; font-size:0.75rem; font-weight:700; cursor:pointer;">선택해제</button>
        </div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
        <label style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#cbd5e1; background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); cursor:pointer;">
          <input type="checkbox" class="single-delete-table-checkbox" value="user_stocks" checked> 📊 보유 주식 전량
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#cbd5e1; background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); cursor:pointer;">
          <input type="checkbox" class="single-delete-table-checkbox" value="user_businesses" checked> 🏢 사업체 및 메타
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#cbd5e1; background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); cursor:pointer;">
          <input type="checkbox" class="single-delete-table-checkbox" value="user_loan_credit" checked> 💳 대출 및 신용도
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#cbd5e1; background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); cursor:pointer;">
          <input type="checkbox" class="single-delete-table-checkbox" value="gambling_logs" checked> 🎰 도박 기록 로그
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#cbd5e1; background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); cursor:pointer;">
          <input type="checkbox" class="single-delete-table-checkbox" value="stock_transactions" checked> 📈 주식 체결 내역
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#cbd5e1; background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); cursor:pointer;">
          <input type="checkbox" class="single-delete-table-checkbox" value="economy_logs" checked> 📜 자금 이동 기록
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#cbd5e1; background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); cursor:pointer; grid-column:span 2;">
          <input type="checkbox" class="single-delete-table-checkbox" value="items" checked> ⛏️ 드릴/아이템/칭호/로또/경마/출석 기록 전량
        </label>
      </div>
    </div>

    <div style="display:flex; gap:10px;">
      <button type="button" id="btn-submit-user-delete" onclick="submitSingleUserDelete()" style="flex:1; background:linear-gradient(135deg, #991b1b, #dc2626); border:none; color:#fff; padding:14px; border-radius:10px; font-weight:900; font-size:0.95rem; cursor:pointer; box-shadow:0 4px 15px rgba(239,68,68,0.4);">
        🔥 계정 및 전 데이터 영구 삭제 실행
      </button>
      <button type="button" onclick="closeSingleUserDeleteModal()" style="background:#334155; border:1px solid rgba(255,255,255,0.15); color:#cbd5e1; padding:14px 20px; border-radius:10px; font-weight:700; cursor:pointer;">
        취소
      </button>
    </div>
  </div>
</div>
</div>

<%- include('footer') %>
