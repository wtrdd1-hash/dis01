    <table>
      <thead>
        <tr>
          <th>번호</th>
          <th>시간 (KST)</th>
          <th>유저 (@계정)</th>
          <th>유형</th>
          <th style="text-align:right;">금액</th>
          <th style="text-align:right;">변동 전</th>
          <th style="text-align:right;">변동 후</th>
          <th>비고</th>
        </tr>
      </thead>
      <tbody>
        <%- economyRowsHtml %>
      </tbody>
    </table>
  </div>

  <!-- 2. 도박 기록 -->
  <div id="log-sec-gamble" style="display:none;">
    <table>
      <thead>
        <tr>
          <th>번호</th>
          <th>시간 (KST)</th>
          <th>유저</th>
          <th>게임</th>
          <th style="text-align:right;">배팅금</th>
          <th style="text-align:right;">순손익</th>
          <th style="text-align:right;">변동 전</th>
          <th style="text-align:right;">변동 후</th>
          <th>작업</th>
        </tr>
      </thead>
      <tbody>
        <%- gambleRowsHtml %>
      </tbody>
    </table>
  </div>

  <!-- 3. 주식 체결 -->
  <div id="log-sec-trades" style="display:none;">
    <table>
      <thead>
        <tr>
          <th>번호</th>
          <th>시간 (KST)</th>
          <th>체결 유저</th>
          <th>종목</th>
          <th>유형</th>
          <th style="text-align:right;">체결 수량</th>
          <th style="text-align:right;">체결 단가</th>
          <th style="text-align:right;">총 거래액</th>
        </tr>
      </thead>
      <tbody>
        <%- tradeRowsHtml %>
      </tbody>
    </table>
  </div>

  <!-- 4. 주가 틱 -->
  <div id="log-sec-prices" style="display:none;">
    <table>
      <thead>
        <tr>
          <th>번호</th>
          <th>시간 (KST)</th>
          <th>종목</th>
          <th style="text-align:right;">이전가</th>
          <th style="text-align:right;">변동가</th>
          <th style="text-align:right;">변동률</th>
          <th>시장 국면</th>
          <th>사유 / 뉴스</th>
        </tr>
      </thead>
      <tbody>
        <%- priceRowsHtml %>
      </tbody>
    </table>
  </div>

  <!-- 5. 웹 접속 -->
  <div id="log-sec-access" style="display:none;">
    <table>
      <thead>
        <tr>
          <th>번호</th>
          <th>시간 (KST)</th>
          <th>유저</th>
          <th>국가/도시</th>
          <th>요청 경로</th>
          <th>상태</th>
          <th>응답</th>
        </tr>
      </thead>
      <tbody>
        <%- webRowsHtml %>
      </tbody>
    </table>
  </div>

  <!-- 6. 슬래시 명령어 -->
  <div id="log-sec-commands" style="display:none;">
    <table>
      <thead>
        <tr>
          <th>번호</th>
          <th>시간 (KST)</th>
          <th>실행 유저</th>
          <th>명령어</th>
          <th>입력 옵션</th>
          <th>결과</th>
          <th>처리 속도</th>
        </tr>
      </thead>
      <tbody>
        <%- cmdRowsHtml %>
      </tbody>
    </table>
  </div>
</div>

<script>
  let currentLogFile = 'system_all.log';
  let autoRefreshTimer = null;
  let rawLogLinesCache = [];
  let isFetchingLog = false;
  let searchDebounceTimer = null;
  let activeQuickFilter = '';
  let currentFontSize = 0.84;
  let isFullscreen = false;

  function switchLogView(type) {
    ['eco', 'gamble', 'trades', 'prices', 'access', 'commands'].forEach(function(t) {
      const el = document.getElementById('log-sec-' + t);
      const btn = document.getElementById('btn-log-' + t);
      if (el) el.style.display = (t === type) ? 'block' : 'none';
      if (btn) btn.classList.toggle('is-active', t === type);
    });
  }

  function changeActiveLogFile(fileName) {
    currentLogFile = fileName || 'system_all.log';
    fetchRawLogData(true);
  }

  function toggleAutoRefresh(enabled) {
    clearInterval(autoRefreshTimer);
    const badge = document.getElementById('log-status-badge');
    if (enabled) {
      autoRefreshTimer = setInterval(function() {
        fetchRawLogData(false);
      }, 3000);
      if (badge) {
        badge.style.background = 'rgba(16,185,129,0.15)';
        badge.style.color = '#34d399';
        badge.style.borderColor = 'rgba(16,185,129,0.3)';
        badge.textContent = '● 실시간 스트리밍 중';
      }
    } else {
      if (badge) {
        badge.style.background = 'rgba(156,163,175,0.15)';
        badge.style.color = '#9ca3af';
        badge.style.borderColor = 'rgba(156,163,175,0.3)';
        badge.textContent = '⏸ 일시 정지됨';
      }
    }
  }

  function handleLogSearchInput() {
    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(function() {
      fetchRawLogData(false);
    }, 250);
  }

  function clearLogSearch() {
    const input = document.getElementById('log-search-input');
    if (input) input.value = '';
    fetchRawLogData(false);
  }

  function applyQuickFilter(keyword) {
    activeQuickFilter = keyword || '';
    document.querySelectorAll('.log-chip').forEach(function(btn) {
      btn.classList.remove('is-active');
    });
    const targetBtn = keyword ? document.getElementById('chip-' + keyword.toLowerCase().replace('_access', '')) : document.getElementById('chip-all');
    if (targetBtn) targetBtn.classList.add('is-active');

    renderTerminalContent();
  }

  function adjustFontSize(delta) {
    currentFontSize = Math.max(0.7, Math.min(1.3, currentFontSize + (delta * 0.06)));
    const container = document.getElementById('log-terminal-container');
    if (container) container.style.fontSize = currentFontSize.toFixed(2) + 'rem';
  }

  function clearTerminalView() {
    const container = document.getElementById('log-terminal-container');
    if (container) container.innerHTML = '<div style="color:#64748b; text-align:center; padding:20px;">화면이 비워졌습니다. 3초 후 다음 로그가 수신됩니다.</div>';
  }

  function toggleFullscreenTerminal() {
    const card = document.getElementById('log-main-card');
    const container = document.getElementById('log-terminal-container');
    const btn = document.getElementById('btn-fullscreen');
    isFullscreen = !isFullscreen;

    if (card && container) {
      if (isFullscreen) {
        card.classList.add('is-fullscreen-terminal');
        container.style.height = 'calc(100vh - 160px)';
        if (btn) btn.textContent = '✕ 창 복원';
      } else {
        card.classList.remove('is-fullscreen-terminal');
        container.style.height = '520px';
        if (btn) btn.textContent = '🖵 전체화면';
      }
    }
  }

  async function fetchRawLogData(isManual) {
    if (isFetchingLog) return;
    isFetchingLog = true;

    const termContainer = document.getElementById('log-terminal-container');
    const linesSelect = document.getElementById('log-lines-select');
    const searchInput = document.getElementById('log-search-input');

    const maxLines = linesSelect ? linesSelect.value : 200;
    const search = searchInput ? searchInput.value.trim() : '';

    try {
      const url = '/api/admin/logs/raw?file=' + encodeURIComponent(currentLogFile) + '&lines=' + encodeURIComponent(maxLines) + '&search=' + encodeURIComponent(search);
      const res = await adminFetch(url);

      if (!res.success) {
        if (termContainer) {
          termContainer.innerHTML = '<div style="color:#f87171; padding:20px;">⚠️ 로그를 불러오지 못했습니다: ' + escapeHtml(res.error || '권한 부족 또는 파일 접근 오류') + '</div>';
        }
        return;
      }

      rawLogLinesCache = res.lines || [];
      const totalBytes = res.totalBytes || 0;
      const sizeKb = (totalBytes / 1024).toFixed(1);

      renderTerminalContent(sizeKb, search);
    } catch (e) {
      if (termContainer) {
        termContainer.innerHTML = '<div style="color:#f87171; padding:20px;">통신 오류가 발생했습니다: ' + escapeHtml(e.message || '네트워크 오류') + '</div>';
      }
    } finally {
      isFetchingLog = false;
    }
  }

  function renderTerminalContent(sizeKb, searchVal) {
    const termContainer = document.getElementById('log-terminal-container');
    const metaInfo = document.getElementById('log-meta-info');
    const autoScrollCheck = document.getElementById('log-autoscroll');
    const search = searchVal !== undefined ? searchVal : ((document.getElementById('log-search-input') || {}).value || '').trim();

    if (!rawLogLinesCache.length) {
      if (termContainer) termContainer.innerHTML = '<div style="color:#6b7280; padding:20px; text-align:center;">기록된 로그가 아직 없습니다.</div>';
      if (metaInfo) metaInfo.textContent = '출력: 0줄';
      return;
    }

    let filtered = rawLogLinesCache;
    if (activeQuickFilter) {
      filtered = filtered.filter(function(l) {
        return l.includes('[' + activeQuickFilter + ']') || l.includes(activeQuickFilter);
      });
    }

    if (metaInfo) {
      metaInfo.textContent = '출력: ' + filtered.length + '줄' + (sizeKb ? ' (' + sizeKb + ' KB)' : '');
    }

    if (!filtered.length) {
      if (termContainer) termContainer.innerHTML = '<div style="color:#6b7280; padding:20px; text-align:center;">필터 조건에 맞는 로그가 없습니다.</div>';
      return;
    }

    let html = '';
    filtered.forEach(function(line, idx) {
      const lineNum = String(idx + 1).padStart(3, '0');
      let isErr = line.includes('[ERROR]');
      let isWarn = line.includes('[WARN]');
      let lineClass = isErr ? 'log-err-line' : (isWarn ? 'log-warn-line' : '');

      let formatted = escapeHtml(line);

      // 타임스탬프
      formatted = formatted.replace(/\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}(?:\.\d{3})? KST)\]/g, '<span style="color:#64748b;">[$1]</span>');
      
      // 레벨
      formatted = formatted.replace(/\[INFO\]/g, '<span style="color:#38bdf8; font-weight:700;">[INFO]</span>');
      formatted = formatted.replace(/\[WARN\]/g, '<span style="color:#fbbf24; font-weight:700;">[WARN]</span>');
      formatted = formatted.replace(/\[ERROR\]/g, '<span style="color:#f87171; font-weight:700; background:rgba(239,68,68,0.25); padding:1px 4px; border-radius:3px;">[ERROR]</span>');
      formatted = formatted.replace(/\[AUDIT\]/g, '<span style="color:#fda4af; font-weight:700; background:rgba(244,63,94,0.25); padding:1px 4px; border-radius:3px;">[AUDIT]</span>');

      // 카테고리
      formatted = formatted.replace(/\[(WEB_ACCESS|ECONOMY|GAMBLE|STOCK|COMMAND|SECURITY|ADMIN|GENERAL)\]/g, '<span style="color:#c084fc; font-weight:700;">[$1]</span>');

      // 유저명
      formatted = formatted.replace(/\[USER: @([^\]]+)\]/g, '<span style="color:#818cf8; font-weight:700;">[USER: @$1]</span>');

      // 액션
      formatted = formatted.replace(/\[ACTION: ([^\]]+)\]/g, '<span style="color:#34d399; font-weight:700;">[ACTION: $1]</span>');

      // 검색어 하이라이트
      if (search) {
        const reg = new RegExp('(' + escapeRegex(search) + ')', 'gi');
        formatted = formatted.replace(reg, '<span style="background:#fbbf24; color:#000; font-weight:800; padding:0 3px; border-radius:3px;">$1</span>');
      }

      html += '<div class="log-line-wrap ' + lineClass + '"><span class="log-line-num">' + lineNum + '</span><span class="log-line-content">' + formatted + '</span></div>';
    });

    if (termContainer) {
      termContainer.innerHTML = html;
      if (autoScrollCheck && autoScrollCheck.checked) {
        termContainer.scrollTop = termContainer.scrollHeight;
      }
    }
  }

  function downloadCurrentLogFile() {
    window.location.href = '/api/admin/logs/download/' + encodeURIComponent(currentLogFile);
  }

  function copyLogContent() {
    if (!rawLogLinesCache.length) return adminNotice(false, '복사할 로그 내용이 없습니다.');
    const text = rawLogLinesCache.join('\n');
    navigator.clipboard.writeText(text).then(function() {
      adminNotice(true, rawLogLinesCache.length + '줄의 로그를 클립보드에 복사했습니다.');
    }).catch(function() {
      adminNotice(false, '클립보드 복사 실패');
    });
  }

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function escapeRegex(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  // 초기 시작
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      fetchRawLogData(true);
      toggleAutoRefresh(true);
    });
  } else {
    fetchRawLogData(true);
    toggleAutoRefresh(true);
  }
</script>
</div>

<%- include('footer') %>
