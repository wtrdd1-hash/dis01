        <div class="lotto-grid" id="lottoGrid"></div>

        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; border-top:1px solid var(--border-color); padding-top:20px;">
          <div>
            <div style="font-size:13px; color:var(--text-muted);">선택된 번호:</div>
            <div style="font-size:18px; font-weight:900; color:#38bdf8;" id="selectedNumbersDisplay">[ 번호를 선택해주세요 ]</div>
          </div>
