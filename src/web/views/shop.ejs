        <div class="drill-anvil">
          <div class="drill-icon-bounce">⛏️</div>
          <div style="margin-top:16px;">
            <span class="rarity-tag rarity-LEGENDARY" id="drillLevelBadge" style="font-size:16px; padding:6px 18px;">+0강 채굴 드릴</span>
          </div>
          <p id="drillBonusText" style="font-size:14px; color:#34d399; font-weight:800; margin-top:10px;">채굴 효율 버프: +0%</p>
        </div>

        <div style="background:rgba(0,0,0,0.4); border-radius:16px; padding:20px; margin:24px 0; text-align:left; font-size:13px; color:var(--text-muted); line-height:1.6;">
          • 강화 성공 시 자동 채굴 수입이 영구 증가합니다 (+1강당 +10% ~ +200%).<br>
          • 고단계 강화 실패 시 수치가 하락하거나 파괴될 수 있습니다.<br>
          • 강화 비용은 시장에서 <b>100% 완전 소각</b>됩니다.
        </div>

        <button class="btn-action" style="width:100%; padding:14px; font-size:16px; justify-content:center; background:linear-gradient(135deg, #f59e0b, #d97706);" onclick="enhanceDrillAction()">
          <i class="fa-solid fa-hammer"></i> 드릴 강화 시도하기
        </button>
      </div>
    </div>

    <!-- 📦 8. 내 보관함 탭 -->
    <div id="tab-inventory" class="tab-pane">
      <div id="inventoryList" class="grid-cards">
        <p style="color:var(--text-muted); padding:30px;">인벤토리를 불러오는 중입니다...</p>
      </div>
    </div>

  </div>

  <script>
    let selectedLottoBalls = [];

    function switchTab(tabId) {
      document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
      const targetPane = document.getElementById(tabId);
      if (targetPane) targetPane.classList.add('active');
      if (event && event.currentTarget) event.currentTarget.classList.add('active');

      if (tabId === 'tab-prestige') loadPrestigeCatalog();
      if (tabId === 'tab-workshop') loadWorkshopData();
      if (tabId === 'tab-duckhouse') loadDuckHouseData();
      if (tabId === 'tab-cosmetics') loadCosmeticsData();
      if (tabId === 'tab-lotto') loadLottoInfo();
      if (tabId === 'tab-forge') loadDrillInfo();
      if (tabId === 'tab-inventory') loadInventory();
    }

    // ─── 🛍️ 주간 명예 상점 로드 & 구매 ───────────────────────
    async function loadPrestigeCatalog() {
      try {
        const res = await fetch('/api/economy/prestige-store');
        const data = await res.json();
        const grid = document.getElementById('prestigeCatalogGrid');
        if (data.success && data.items.length) {
          grid.innerHTML = data.items.map(item => `
            <div class="item-card">
              <div>
                <div class="card-top">
                  <div class="item-icon-box">${item.icon}</div>
                  <span class="rarity-tag rarity-${item.rarity}">${item.rarity}</span>
                </div>
                <div class="item-title" style="${item.itemType === 'NAME_COLOR' ? item.previewCss : ''}">${escapeHtml(item.name)}</div>
                <div class="item-desc">${escapeHtml(item.description || '')}</div>
                <div class="item-duration">
                  <i class="fa-regular fa-clock"></i> 유효 기간: <b>${item.isPermanent ? '영구 보유' : (item.durationSeconds / 86400) + '일'}</b>
                </div>
              </div>
              <div class="item-footer">
                <div class="item-price">${Number(item.price).toLocaleString()}원</div>
                ${item.isOwned && item.isPermanent 
                  ? `<button class="btn-action" disabled><i class="fa-solid fa-check"></i> 보유중</button>`
                  : `<button class="btn-action" onclick="buyPrestigeItem('${item.itemKey}', '${escapeHtml(item.name)}')"><i class="fa-solid fa-cart-shopping"></i> ${item.isOwned ? '기간 연장' : '구매하기'}</button>`
                }
              </div>
            </div>
          `).join('');
        } else {
          grid.innerHTML = '<p style="color:var(--text-muted); padding:30px;">현재 판매 중인 명예 상품이 없습니다.</p>';
        }
      } catch (e) {
        console.error(e);
      }
    }

    async function buyPrestigeItem(itemKey, name) {
      if (!confirm(`[${name}] 상품을 구매하시겠습니까? (구매 금액 100% 완전 소각)`)) return;
      try {
        const res = await fetch('/api/economy/prestige-store/purchase', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ itemKey })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          if (data.newCash) document.getElementById('userCashDisplay').textContent = Number(data.newCash).toLocaleString() + '원';
          loadPrestigeCatalog();
        } else {
          alert('구매 실패: ' + data.error);
        }
      } catch (e) {
        alert('서버 통신 오류');
      }
    }

    // ─── 🔨 컬렉션 제작소 로드 & 제작 ─────────────────────────
    async function loadWorkshopData() {
      try {
        const res = await fetch('/api/economy/workshop/recipes');
        const data = await res.json();
        if (data.success) {
          const shards = data.goldenFeatherShards || 0;
          document.getElementById('userFeatherShards').textContent = shards;
          document.getElementById('userShardHeaderDisplay').innerHTML = `🪶 황금 깃털 조각: <b>${shards}개</b>`;
          const grid = document.getElementById('workshopRecipesGrid');
          if (data.recipes.length) {
            grid.innerHTML = data.recipes.map(r => `
              <div class="item-card">
                <div>
                  <div class="card-top">
                    <div class="item-icon-box">${r.icon}</div>
                    <span class="rarity-tag rarity-${r.rarity}">${r.rarity}</span>
                  </div>
                  <div class="item-title">${escapeHtml(r.name)}</div>
                  <div class="item-desc">${escapeHtml(r.description || '')}</div>
                  <div style="margin-top:10px; padding:12px; background:rgba(0,0,0,0.3); border-radius:10px; font-size:12px; line-height:1.6;">
                    필요 재료: <b style="color:#fbbf24;">🪶 황금 깃털 조각 ${r.materialCost}개</b><br>
                    제작비: <b style="color:#34d399;">${Number(r.cashCost).toLocaleString()}원 (소각)</b>
                  </div>
                </div>
                <div class="item-footer" style="margin-top:14px;">
                  <button class="btn-action" style="width:100%; justify-content:center; background:linear-gradient(135deg, #10b981, #059669);" onclick="craftRecipeAction('${r.recipeKey}', '${escapeHtml(r.name)}')">
                    <i class="fa-solid fa-hammer"></i> 100% 확정 제작하기
                  </button>
                </div>
              </div>
            `).join('');
          }
        }
      } catch (e) {}
    }

    async function craftRecipeAction(recipeKey, name) {
      if (!confirm(`[${name}] 아이템을 제작하시겠습니까? (조각 및 제작비가 즉시 소각됩니다)`)) return;
      try {
        const res = await fetch('/api/economy/workshop/craft', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipeKey })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          if (data.newCash) document.getElementById('userCashDisplay').textContent = Number(data.newCash).toLocaleString() + '원';
          loadWorkshopData();
        } else {
          alert('제작 실패: ' + data.error);
        }
      } catch (e) {
        alert('서버 통신 오류');
      }
    }

    async function openSalvageModal() {
      const invRes = await fetch('/api/economy/cosmetics');
      const invData = await invRes.json();
      if (!invData.success || !invData.items.length) {
        return alert('분해 가능한 보유 아이템이 없습니다.');
      }
      const choices = invData.items.map(i => `${i.id}: [${i.name}] (${i.itemType})`).join('\n');
      const inputId = prompt(`분해할 아이템의 ID 번호를 입력하세요 (황금 깃털 조각이 추출됩니다):\n\n${choices}`);
      if (!inputId) return;

      const res = await fetch('/api/economy/workshop/salvage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ inventoryId: parseInt(inputId, 10) })
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
        loadWorkshopData();
      } else {
        alert('분해 실패: ' + data.error);
      }
    }

    // ─── 🏰 덕하우스 로드 & 업그레이드 ──────────────────────────
    async function loadDuckHouseData() {
      try {
        const res = await fetch('/api/economy/duck-house');
        const data = await res.json();
        if (data.success) {
          const h = data.house;
          document.getElementById('duckHouseTitle').textContent = h.houseName || '나만의 덕하우스';
          document.getElementById('duckHouseLevelBadge').textContent = `Lv.${h.level} ${h.levelName}`;
          document.getElementById('duckHouseSlotsDesc').textContent = `전시 슬롯: ${h.maxSlots}개 (현재 거치: ${data.slots.length}개)`;

          const upWrap = document.getElementById('duckHouseUpgradeWrap');
          if (h.nextLevel) {
            upWrap.innerHTML = `
              <button class="btn-action" onclick="upgradeDuckHouseAction()" style="background:linear-gradient(135deg, #f59e0b, #d97706); color:#000; font-weight:900;">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Lv.${h.nextLevel.level} [${h.nextLevel.name}] 확장 (${Number(h.nextLevel.cost).toLocaleString()}원)
              </button>
            `;
          } else {
            upWrap.innerHTML = `<span style="color:#fbbf24; font-weight:800;"><i class="fa-solid fa-crown"></i> 최고 등급 궁전 확장 완료</span>`;
          }

          const slotGrid = document.getElementById('duckHouseSlotsGrid');
          let slotsHtml = '';
          for (let i = 0; i < h.maxSlots; i++) {
            const placed = data.slots.find(s => s.slotIndex === i);
            if (placed) {
              slotsHtml += `
                <div class="pedestal-slot filled">
                  <div style="font-size:28px; margin-bottom:6px;">🏆</div>
                  <div style="font-size:12px; font-weight:800; color:#fff; word-break:break-all;">${escapeHtml(placed.itemName)}</div>
                  <button type="button" onclick="removeDuckHouseSlotAction(${i})" style="margin-top:8px; font-size:11px; background:rgba(239,68,68,0.2); border:1px solid #ef4444; color:#fca5a5; border-radius:6px; padding:3px 8px; cursor:pointer;">회수하기</button>
                </div>
              `;
            } else {
              slotsHtml += `
                <div class="pedestal-slot" onclick="openPlaceItemModal(${i}, ${JSON.stringify(data.placeableItems).replace(/"/g, '&quot;')})">
                  <div style="font-size:24px; color:var(--text-muted); margin-bottom:4px;">+</div>
                  <div style="font-size:12px; color:var(--text-muted); font-weight:700;">슬롯 ${i + 1} 비어있음</div>
                  <div style="font-size:10px; color:#64748b; margin-top:2px;">클릭하여 거치</div>
                </div>
              `;
            }
          }
          slotGrid.innerHTML = slotsHtml;
        }
      } catch (e) {}
    }

    async function upgradeDuckHouseAction() {
      if (!confirm('덕하우스 공간 확장 공사를 진행하시겠습니까? (비용 100% 완전 소각)')) return;
      try {
        const res = await fetch('/api/economy/duck-house/upgrade', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          if (data.newCash) document.getElementById('userCashDisplay').textContent = Number(data.newCash).toLocaleString() + '원';
          loadDuckHouseData();
        } else {
          alert('확장 실패: ' + data.error);
        }
      } catch (e) {
        alert('서버 통신 오류');
      }
    }

    function openPlaceItemModal(slotIndex, items) {
      if (!items || !items.length) return alert('배치할 수 있는 아이템이 없습니다. 상점이나 제작소에서 트로피/외형을 획득하세요!');
      const choices = items.map(i => `${i.id}: [${i.name}] (${i.itemType})`).join('\n');
      const inputId = prompt(`슬롯 ${slotIndex + 1}번에 거치할 아이템의 ID를 입력하세요:\n\n${choices}`);
      if (!inputId) return;

      fetch('/api/economy/duck-house/slot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slotIndex, inventoryId: parseInt(inputId, 10) })
      }).then(r => r.json()).then(data => {
        if (data.success) {
          alert(data.message);
          loadDuckHouseData();
        } else {
          alert('거치 실패: ' + data.error);
        }
      });
    }

    async function removeDuckHouseSlotAction(slotIndex) {
      if (!confirm('해당 슬롯의 아이템을 보관함으로 회수하시겠습니까?')) return;
      const res = await fetch('/api/economy/duck-house/slot/' + slotIndex, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        loadDuckHouseData();
      } else {
        alert('회수 실패: ' + data.error);
      }
    }

    // ─── 🎨 외형 로드아웃 & 장착 ──────────────────────────────
    async function loadCosmeticsData() {
      try {
        const res = await fetch('/api/economy/cosmetics');
        const data = await res.json();
        if (data.success) {
          const slots = ['PROFILE_FRAME', 'NAME_COLOR', 'BUSINESS_SKIN', 'HOUSE_SKIN', 'BADGE', 'AURA'];
          const eqGrid = document.getElementById('equippedSlotsGrid');
          eqGrid.innerHTML = slots.map(slot => {
            const item = data.loadout[slot];
            return `
              <div style="background:rgba(0,0,0,0.4); border:1px solid var(--border-color); border-radius:14px; padding:16px;">
                <div style="font-size:11px; color:var(--text-muted); font-weight:800;">${slot}</div>
                <div style="font-size:14px; font-weight:900; color:#fff; margin:8px 0;">${item ? `${item.icon} ${escapeHtml(item.name)}` : '<span style="color:#64748b;">미장착</span>'}</div>
                ${item ? `<button type="button" onclick="unequipCosmeticAction('${slot}')" style="font-size:11px; background:rgba(239,68,68,0.2); border:1px solid #ef4444; color:#fca5a5; border-radius:6px; padding:4px 10px; cursor:pointer;">해제하기</button>` : ''}
              </div>
            `;
          }).join('');

          const invGrid = document.getElementById('cosmeticInventoryGrid');
          if (data.items.length) {
            invGrid.innerHTML = data.items.map(item => `
              <div class="item-card">
                <div>
                  <div class="card-top">
                    <div class="item-icon-box">${item.icon}</div>
                    <span class="rarity-tag rarity-${item.rarity}">${item.itemType}</span>
                  </div>
                  <div class="item-title">${escapeHtml(item.name)}</div>
                  <div class="item-duration">
                    <i class="fa-regular fa-clock"></i> ${item.isPermanent ? '영구 보유' : '만료: ' + new Date(item.expiresAt).toLocaleDateString()}
                  </div>
                </div>
                <div class="item-footer">
                  <button class="btn-action" onclick="equipCosmeticAction('${item.itemType}', '${item.itemKey}')">
                    <i class="fa-solid fa-shirt"></i> 장착하기
                  </button>
                </div>
              </div>
            `).join('');
          } else {
            invGrid.innerHTML = '<p style="color:var(--text-muted); padding:30px;">보유한 외형 아이템이 없습니다.</p>';
          }
        }
      } catch (e) {}
    }

    async function equipCosmeticAction(slot, itemKey) {
      const res = await fetch('/api/economy/cosmetics/equip', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slot, itemKey })
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
        loadCosmeticsData();
      } else {
        alert('장착 실패: ' + data.error);
      }
    }

    async function unequipCosmeticAction(slot) {
      const res = await fetch('/api/economy/cosmetics/unequip', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slot })
      });
      const data = await res.json();
      if (data.success) {
        loadCosmeticsData();
      } else {
        alert('해제 실패: ' + data.error);
      }
    }

    // ─── 🎫 로또 6/45 ──────────────────────────────────────────
    function renderLottoGrid() {
      const grid = document.getElementById('lottoGrid');
      grid.innerHTML = '';
      for (let i = 1; i <= 45; i++) {
        const btn = document.createElement('button');
        btn.className = 'ball-btn';
        btn.textContent = i;
        btn.onclick = () => toggleLottoBall(i, btn);
        grid.appendChild(btn);
      }
    }
    renderLottoGrid();

    function toggleLottoBall(num, btn) {
      if (selectedLottoBalls.includes(num)) {
        selectedLottoBalls = selectedLottoBalls.filter(n => n !== num);
        btn.classList.remove('selected');
      } else {
        if (selectedLottoBalls.length >= 6) {
          alert('번호는 최대 6개까지만 선택할 수 있습니다.');
          return;
        }
        selectedLottoBalls.push(num);
        btn.classList.add('selected');
      }
      updateLottoDisplay();
    }

    function updateLottoDisplay() {
      const disp = document.getElementById('selectedNumbersDisplay');
      if (!selectedLottoBalls.length) {
        disp.textContent = '[ 번호를 선택해주세요 ]';
      } else {
        disp.textContent = '[ ' + selectedLottoBalls.sort((a,b)=>a-b).join(', ') + ' ] (' + selectedLottoBalls.length + '/6)';
      }
    }

    function pickRandomLotto() {
      selectedLottoBalls = [];
      const set = new Set();
      while (set.size < 6) {
        set.add(Math.floor(Math.random() * 45) + 1);
      }
      selectedLottoBalls = Array.from(set).sort((a,b)=>a-b);
      document.querySelectorAll('.ball-btn').forEach((btn, idx) => {
        if (selectedLottoBalls.includes(idx + 1)) btn.classList.add('selected');
        else btn.classList.remove('selected');
      });
      updateLottoDisplay();
    }

    async function loadLottoInfo() {
      try {
        const res = await fetch('/api/lotto/current');
        const data = await res.json();
        if (data.success && data.round) {
          document.getElementById('lottoRoundDisplay').textContent = data.round.round_number;
          document.getElementById('lottoJackpotDisplay').textContent = Number(data.round.jackpot_pool).toLocaleString() + '원';
        }
      } catch (e) {}
    }

    async function buyLottoTicketAction() {
      if (selectedLottoBalls.length !== 6) return alert('번호 6개를 모두 선택해주세요!');
      if (!confirm('선택한 번호로 로또를 구매하시겠습니까? (1,000원)')) return;
      try {
        const res = await fetch('/api/lotto/buy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ numbers: selectedLottoBalls.sort((a,b)=>a-b) })
        });
        const data = await res.json();
        if (data.success) {
          alert('🎉 로또 티켓 구매 완료!');
          if (data.result?.afterCash) document.getElementById('userCashDisplay').textContent = Number(data.result.afterCash).toLocaleString() + '원';
          loadLottoInfo();
        } else {
          alert('구매 실패: ' + data.error);
        }
      } catch (e) {
        alert('서버 오류');
      }
    }

    // ─── ⚒️ 드릴 대장간 & 보관함 ─────────────────────────────
    async function loadDrillInfo() {
      try {
        const res = await fetch('/api/drill/info');
        const data = await res.json();
        if (data.success) {
          const d = data.drill;
          document.getElementById('drillLevelBadge').textContent = '+' + d.enhancementLevel + '강 채굴 드릴';
          document.getElementById('drillBonusText').textContent = '채굴 효율 버프: +' + d.bonusPercent + '%';
        }
      } catch (e) {}
    }

    async function enhanceDrillAction() {
      if (!confirm('드릴 강화를 시도하시겠습니까? (강화 비용 100% 완전 소각)')) return;
      try {
        const res = await fetch('/api/drill/enhance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ useProtection: false })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.result.message);
          if (data.result.afterCash) document.getElementById('userCashDisplay').textContent = Number(data.result.afterCash).toLocaleString() + '원';
          loadDrillInfo();
        } else {
          alert('강화 오류: ' + data.error);
        }
      } catch (e) {
        alert('서버 통신 오류');
      }
    }

    async function buyItem(key) {
      if (!confirm('이 아이템을 구매하시겠습니까? (비용 100% 완전 소각)')) return;
      try {
        const res = await fetch('/api/shop/buy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ itemKey: key })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message || '아이템 구매가 완료되었습니다!');
          if (data.afterCash) document.getElementById('userCashDisplay').textContent = Number(data.afterCash).toLocaleString() + '원';
        } else {
          alert('구매 실패: ' + data.error);
        }
      } catch (e) {
        alert('서버 통신 오류');
      }
    }

    async function loadInventory() {
      try {
        const res = await fetch('/api/shop/inventory');
        const data = await res.json();
        const list = document.getElementById('inventoryList');
        if (data.success && data.inventory.items.length) {
          list.innerHTML = data.inventory.items.map(i => `
            <div class="item-card">
              <div>
                <div class="item-title">${escapeHtml(i.item_name)}</div>
                <div class="item-desc">보유 수량: <b>${i.quantity}개</b><br>${i.expires_at ? '만료: ' + new Date(i.expires_at).toLocaleDateString() : '영구 보유'}</div>
              </div>
            </div>
          `).join('');
        } else {
          list.innerHTML = '<p style="color:var(--text-muted);padding:30px;">보관 중인 아이템이 없습니다.</p>';
        }
      } catch (e) {}
    }

    function openMegaphoneModal() {
      const msg = prompt('전체 서버 및 웹 상단에 송출할 확성기 메시지를 입력하세요 (비용: 50,000원):');
      if (!msg) return;
      fetch('/api/shop/megaphone', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg, theme: 'gold' })
      }).then(r => r.json()).then(data => {
        if (data.success) {
          alert(data.message);
          if (data.afterCash) document.getElementById('userCashDisplay').textContent = Number(data.afterCash).toLocaleString() + '원';
        } else {
          alert('발송 실패: ' + data.error);
        }
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    // 초기 활성 탭 로드
    loadPrestigeCatalog();
  </script>
</body>
</html>
