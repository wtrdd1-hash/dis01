            <button class="btn-action" style="background:rgba(255,255,255,0.08); box-shadow:none;" onclick="pickRandomLotto()"><i class="fa-solid fa-shuffle"></i> 자동 선택</button>
            <button class="btn-action" style="background:linear-gradient(135deg, #f59e0b, #ef4444);" onclick="buyLottoTicketAction()"><i class="fa-solid fa-ticket"></i> 로또 구매 (1,000원)</button>
