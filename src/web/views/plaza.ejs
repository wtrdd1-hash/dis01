<%- include('layout/header', { pageTitle: 'VIP 메타버스 라운지', activePage: 'plaza' }) %>

<main style="flex:1; display:flex; flex-direction:column; align-items:center; padding:16px; width:100%; max-width:1240px; margin:0 auto;">
  
  <% if (typeof isUnlocked !== 'undefined' && isUnlocked) { %>
    <!-- 👑 1. 캐릭터 해금 자산가 전용 2D 메타버스 라운지 -->
    <div style="width:100%; display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:12px;">
      <div>
        <h1 style="font-size:22px; font-weight:900; color:#fbbf24; margin:0; display:flex; align-items:center; gap:8px;">
          <span>👑</span> 월덕 VIP 하이롤러 메타버스 광장
        </h1>
        <p style="font-size:13px; color:#94a3b8; margin:4px 0 0 0;">
          키보드(WASD / 방향키) 또는 화면 터치/클릭으로 이동하세요. 건물에 다가가 클릭하면 해당 시설로 이동합니다.
        </p>
      </div>
      
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <button class="btn-quick" onclick="if(window.__metaEngine) window.__metaEngine.sendEmote('wave')" style="padding:6px 12px; font-size:13px; background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">👋 인사</button>
        <button class="btn-quick" onclick="if(window.__metaEngine) window.__metaEngine.sendEmote('jump')" style="padding:6px 12px; font-size:13px; background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">🦘 점프</button>
        <button class="btn-quick" onclick="if(window.__metaEngine) window.__metaEngine.sendEmote('heart')" style="padding:6px 12px; font-size:13px; background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.1); border-radius:10px; cursor:pointer;">❤️ 하트</button>
        <button class="btn-quick" onclick="if(window.__metaEngine) window.__metaEngine.sendEmote('money')" style="padding:6px 12px; font-size:13px; background:#1e293b; color:#fbbf24; border:1px solid rgba(251,191,36,0.3); border-radius:10px; cursor:pointer;">💸 돈뿌리기</button>
      </div>
    </div>

    <!-- 2D 캔버스 맵 영역 -->
    <div style="position:relative; width:100%; border-radius:16px; overflow:hidden; border:1px solid rgba(251,191,36,0.4); box-shadow:0 0 40px rgba(251,191,36,0.15); background:#0f172a;">
      <canvas id="metaverse-canvas" style="width:100%; height:auto; display:block; aspect-ratio:1200/720; background:#0f172a; cursor:crosshair;"></canvas>
    </div>

    <!-- 말풍선 실시간 채팅 입력 바 -->
    <div style="width:100%; margin-top:14px; display:flex; gap:10px;">
      <input type="text" id="metaverse-chat-input" placeholder="VIP 광장에 말풍선 띄우기 (엔터를 치면 머리 위에 말풍선이 뜹니다)..." maxlength="100" style="flex:1; background:#1e293b; border:1px solid rgba(251,191,36,0.4); border-radius:12px; padding:14px 18px; color:#f8fafc; font-size:14px; outline:none;" onkeydown="if(event.key==='Enter'&&window.__metaEngine){window.__metaEngine.sendChat(this.value); this.value='';}">
      <button style="padding:0 24px; font-weight:800; background:linear-gradient(135deg,#f59e0b,#fbbf24); border:none; border-radius:12px; color:#000; cursor:pointer; font-size:14px;" onclick="const inp=document.getElementById('metaverse-chat-input'); if(inp&&window.__metaEngine){window.__metaEngine.sendChat(inp.value); inp.value='';}">말하기</button>
    </div>

    <script src="/static/js/metaversePlaza.js"></script>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof MetaversePlazaEngine === 'function') {
          window.__metaEngine = new MetaversePlazaEngine('metaverse-canvas', 'metaverse-container');
        }
      });
    </script>

  <% } else { %>
    <!-- 🔒 2. 캐릭터 미해금 유저를 위한 VIP 라운지 안내 카드 -->
    <div style="max-width:680px; width:100%; margin:40px auto; background:linear-gradient(180deg, rgba(30,27,75,0.85) 0%, rgba(15,23,42,0.95) 100%); border:1px solid rgba(251,191,36,0.35); border-radius:24px; padding:40px 32px; text-align:center; box-shadow:0 0 60px rgba(0,0,0,0.8), 0 0 30px rgba(251,191,36,0.1);">
      
      <div style="font-size:64px; margin-bottom:16px; filter:drop-shadow(0 0 20px rgba(251,191,36,0.5));">👑</div>
      
      <div style="display:inline-block; padding:4px 14px; background:rgba(251,191,36,0.15); border:1px solid rgba(251,191,36,0.4); border-radius:20px; color:#fbbf24; font-size:12px; font-weight:800; margin-bottom:16px;">
        VIP HIGH-ROLLER EXCLUSIVE
      </div>

      <h2 style="font-size:26px; font-weight:900; color:#fff; margin:0 0 12px 0;">월덕 VIP 메타버스 라운지</h2>
      
      <p style="font-size:15px; color:#94a3b8; line-height:1.6; margin:0 0 24px 0;">
        이곳은 <strong>캐릭터 외형을 해금한 상위 자산가 오리들</strong>만을 위한 프라이빗 메타버스 사교 공간입니다.<br>
        나만의 특별한 외형 아이템을 장착하고 자산가 전용 메타버스에 입장하세요!
      </p>

      <!-- 해금 조건 박스 -->
      <div style="background:rgba(15,23,42,0.7); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:20px; text-align:left; margin-bottom:28px;">
        <div style="font-size:13px; font-weight:800; color:#fbbf24; margin-bottom:12px; display:flex; align-items:center; gap:6px;">
          <span>🔑</span> <span>캐릭터 해금 조건 (1개 이상 충족 시 즉시 입장)</span>
        </div>
        <ul style="margin:0; padding-left:20px; font-size:13px; color:#cbd5e1; line-height:1.8;">
          <li>명품 상점에서 <strong>닉네임 컬러</strong> 해금 및 장착</li>
          <li>명품 상점에서 <strong>프로필 테두리 (아우라)</strong> 해금 및 장착</li>
          <li>명품 상점에서 <strong>명예 배지 또는 칭호</strong> 해금 및 장착</li>
        </ul>
      </div>

      <div style="display:flex; flex-direction:column; gap:12px;">
        <a href="/shop#tab-cosmetics" style="display:block; width:100%; padding:16px; background:linear-gradient(135deg,#f59e0b,#fbbf24); border-radius:14px; text-decoration:none; color:#000; font-weight:900; font-size:16px; box-shadow:0 0 20px rgba(251,191,36,0.3); transition:transform 0.2s ease;">
          🛍️ 명품관에서 캐릭터 외형 해금하고 입장하기 ➔
        </a>
        <a href="/stocks" style="display:block; width:100%; padding:12px; background:rgba(30,41,59,0.8); border:1px solid rgba(255,255,255,0.1); border-radius:14px; text-decoration:none; color:#94a3b8; font-weight:700; font-size:14px;">
          📈 메인 주식 거래소로 돌아가기
        </a>
      </div>

    </div>
  <% } %>

</main>

<%- include('layout/footer', { activePage: 'plaza' }) %>
