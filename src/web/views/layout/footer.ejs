    <a href="/shop" class="mob-nav-btn <%= (typeof activePage !== 'undefined' && activePage === 'shop') ? 'active' : '' %>">
      <span class="mob-icon">🛍️</span>
      <span class="mob-label">상점</span>
    </a>
    <a href="/casino" class="mob-nav-btn <%= (typeof activePage !== 'undefined' && activePage === 'casino') ? 'active' : '' %>">
      <span class="mob-icon">🎰</span>
      <span class="mob-label">게임</span>
    </a>
    <a href="/mining" class="mob-nav-btn <%= (typeof activePage !== 'undefined' && activePage === 'mining') ? 'active' : '' %>">
      <span class="mob-icon">⛏️</span>
