<%
function formatKoreanMoney(val) {
  try {
    const n = BigInt(val || 0);
    if (n === 0n) return '0원';
    const jo = n / 1000000000000n;
    const eok = (n % 1000000000000n) / 100000000n;
    const man = (n % 100000000n) / 10000n;
    const won = n % 10000n;
    let res = '';
    if (jo > 0n) res += jo.toLocaleString() + '조 ';
    if (eok > 0n) res += eok.toLocaleString() + '억 ';
    if (man > 0n && jo === 0n) res += man.toLocaleString() + '만 ';
    if (!res) res = won.toLocaleString() + '원';
    else res += '원';
    return res.trim();
  } catch (e) {
    return Number(val || 0).toLocaleString() + '원';
  }
}
const isTestEnv = (typeof isTest !== 'undefined' && isTest) || (typeof process !== 'undefined' && process.env.PROCESS_TYPE === 'test_web') || (typeof req !== 'undefined' && req.headers && (req.headers.host || '').includes('test.'));
%>
<!DOCTYPE html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <title><%= (typeof pageTitle !== 'undefined' ? pageTitle + ' - ' : '') %><%= isTestEnv ? '[테스트 서버] ' : '' %>월덕 (WTRD) 실시간 가상 경제</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦆</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Pretendard:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/wtrd-design.css?v=2.0.3">
  <link rel="stylesheet" href="/static/css/app.css?v=2.0.3">
  <script>
    window.__currentUser = {
      id: "<%= (typeof user !== 'undefined' && user && user.id) ? user.id : '' %>",
      username: "<%= (typeof user !== 'undefined' && user && user.username) ? user.username : '여행자' %>",
      avatar: "<%= (typeof user !== 'undefined' && user && user.avatar) ? user.avatar : '' %>",
      avatarUrl: "<%= (typeof user !== 'undefined' && user && user.avatar) ? user.avatar : '' %>",
      title: "<%= (typeof userLoadout !== 'undefined' && userLoadout && userLoadout.TITLE) ? userLoadout.TITLE.name : '' %>"
    };
  </script>
  
  <style>
    :root {
      --bg-dark: #07090e;
      --bg-card: rgba(15, 23, 42, 0.85);
      --border-glow: rgba(99, 102, 241, 0.35);
      --primary: #6366F1;
      --accent-gold: #F59E0B;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      min-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      scroll-behavior: smooth;
    }
    body {
      background: var(--bg-dark);
      background-image: 
        radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(245, 158, 11, 0.1) 0px, transparent 50%),
        radial-gradient(at 50% 50%, rgba(56, 189, 248, 0.05) 0px, transparent 50%);
      color: #f8fafc;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      overflow-y: auto !important;
    }

    /* 🌐 고품격 글로벌 핀테크 헤더 */
    .w-top-navbar {
      position: sticky;
      top: 0;
      z-index: 500;
      background: rgba(11, 15, 25, 0.92);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0 20px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .w-nav-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #fff;
      font-size: 19px;
      font-weight: 900;
      font-family: 'Outfit', sans-serif;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .w-nav-menu {
      display: flex;
      align-items: center;
      gap: 6px;
      list-style: none;
      white-space: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .w-nav-menu::-webkit-scrollbar { display: none; }

    .w-nav-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 13px;
      border-radius: 10px;
      color: #94a3b8;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 700;
      transition: all 0.2s ease;
      white-space: nowrap;
      border: 1px solid transparent;
    }
    .w-nav-link:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
    }
    .w-nav-link.active {
      color: #fff;
      background: rgba(99, 102, 241, 0.15);
      border-color: rgba(99, 102, 241, 0.4);
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.2);
    }

    /* VIP 메타버스 골드 버튼 */
    .w-nav-vip {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.25));
      border: 1px solid rgba(245, 158, 11, 0.45);
      color: #fbbf24 !important;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
    }
    .w-nav-vip:hover {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(217, 119, 6, 0.4));
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.4);
      transform: translateY(-1px);
    }

    .w-user-panel {
      display: flex;
      align-items: center;
      gap: 12px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .w-balance-pill {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 13px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-login-discord {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #5865F2;
      color: #fff;
      text-decoration: none;
      padding: 7px 14px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 800;
      transition: all 0.2s ease;
      box-shadow: 0 0 15px rgba(88, 101, 242, 0.4);
    }
    .btn-login-discord:hover {
      background: #4752C4;
      box-shadow: 0 0 25px rgba(88, 101, 242, 0.6);
    }

    .btn-logout-clean {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
      text-decoration: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .btn-logout-clean:hover {
      background: rgba(239, 68, 68, 0.25);
      color: #fff;
    }

    @media (max-width: 900px) {
      .w-nav-menu { display: none; }
    }
    @media (max-width: 600px) {
      .w-top-navbar { padding: 8px 12px; }
      .w-user-panel { gap: 6px; }
      .w-balance-pill { padding: 3px 8px; font-size: 11.5px; }
      .btn-logout-clean { padding: 5px 8px; font-size: 11px; }
      .btn-logout-clean span.logout-label { display: none; }
      .w-nav-brand span:not(:first-child) { font-size: 14px; }
    }
  </style>
</head>
<body>

  <header class="w-top-navbar">
    <a href="/stocks" class="w-nav-brand">
      <span style="font-size:24px;">🦆</span>
      <span>월덕 <span style="color:#818cf8; font-size:14px; font-weight:700;">WTRD</span></span>
      <% if (isTestEnv) { %>
        <span style="background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; font-size: 10px; padding: 2px 7px; border-radius: 6px; font-weight: 900; letter-spacing: 0.5px; box-shadow: 0 0 10px rgba(245,158,11,0.5);">[테스트 서버]</span>
      <% } %>
    </a>

    <!-- 데스크탑 네비게이션 -->
    <nav class="w-nav-menu">
      <a href="/stocks" class="w-nav-link <%= (typeof activePage !== 'undefined' && activePage === 'stocks') ? 'active' : '' %>">
        <span>📈</span> <span>주식</span>
      </a>
      <a href="/shop" class="w-nav-link <%= (typeof activePage !== 'undefined' && activePage === 'shop') ? 'active' : '' %>">
        <span>🛍️</span> <span>명품·상점</span>
      </a>
      <a href="/casino" class="w-nav-link <%= (typeof activePage !== 'undefined' && activePage === 'casino') ? 'active' : '' %>">
        <span>🎰</span> <span>게임</span>
      </a>
      <a href="/mining" class="w-nav-link <%= (typeof activePage !== 'undefined' && activePage === 'mining') ? 'active' : '' %>">
        <span>⛏️</span> <span>채굴</span>
      </a>
      <a href="/ranking" class="w-nav-link <%= (typeof activePage !== 'undefined' && activePage === 'ranking') ? 'active' : '' %>">
        <span>🏆</span> <span>랭킹</span>
      </a>
      <a href="/plaza" class="w-nav-link w-nav-vip <%= (typeof activePage !== 'undefined' && activePage === 'plaza') ? 'active' : '' %>">
        <span>👑</span> <span>VIP 메타버스</span>
        <span style="background:rgba(239,68,68,0.25); color:#fca5a5; font-size:9.5px; font-weight:900; padding:1px 5px; border-radius:4px; border:1px solid rgba(239,68,68,0.4);">BETA</span>
      </a>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/admin" class="w-nav-link" style="color:#38bdf8;">
          <span>🛡️</span> <span>관리자</span>
        </a>
      <% } %>
    </nav>

    <!-- 사용자 프로필 / 로그인 / 로그아웃 -->
    <div class="w-user-panel">
      <% if (typeof user !== 'undefined' && user && user.id) { %>
        <div class="w-balance-pill" title="현금: <%= Number(userAssets.cash).toLocaleString() %>원 | 은행: <%= Number(userAssets.bank).toLocaleString() %>원">
          <span style="color:#34d399;">💵</span>
          <span id="user-cash-display" style="color:#34d399;"><%= formatKoreanMoney(userAssets.cash) %></span>
        </div>

        <div onclick="openUserProfileModal()" style="display:flex; align-items:center; gap:8px; cursor:pointer; padding:4px 8px; border-radius:10px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); transition:all 0.2s ease;" onmouseover="this.style.background='rgba(99,102,241,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.04)'" title="내 프로필 및 칭호 관리 열기">
          <img src="<%= user.avatar %>" alt="avatar" style="width:32px; height:32px; border-radius:50%; border:2px solid #818cf8;">
          <div style="display:flex; flex-direction:column; text-align:left;">
            <span style="font-weight:700; font-size:13px; color:#f8fafc; display:flex; align-items:center; gap:4px;">
              <%= user.username %> <span style="font-size:10px; color:#94a3b8;">▼</span>
            </span>
            <% if (typeof userLoadout !== 'undefined' && userLoadout && userLoadout.TITLE) { %>
              <span style="font-size:10px; color:#38bdf8; font-weight:800;"><%= userLoadout.TITLE.name %></span>
            <% } else { %>
              <span style="font-size:10px; color:#94a3b8; font-weight:700;">칭호 관리</span>
            <% } %>
          </div>
        </div>

        <a href="/logout" class="btn-logout-clean" title="완전 로그아웃">
          <span>🚪</span> <span class="logout-label">로그아웃</span>
        </a>
      <% } else { %>
        <a href="/auth/discord" class="btn-login-discord">
          <span>🎮</span>
          <span>Discord 로그인</span>
        </a>
      <% } %>
    </div>
  </header>

  <!-- 👤 유저 상세 프로필 & 칭호 관리 모달 -->
  <% if (typeof user !== 'undefined' && user && user.id) { %>
    <div id="userProfileModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.75); backdrop-filter:blur(8px); z-index:9999; justify-content:center; align-items:center;">
      <div style="background:#0f172a; border:1px solid rgba(99,102,241,0.35); box-shadow:0 20px 50px rgba(0,0,0,0.9), 0 0 30px rgba(99,102,241,0.2); border-radius:20px; width:92%; max-width:480px; overflow:hidden; animation:modalPop 0.2s ease;">
        
        <!-- Header -->
        <div style="padding:16px 20px; background:rgba(30,41,59,0.8); border-bottom:1px solid rgba(255,255,255,0.08); display:flex; justify-content:space-between; align-items:center;">
          <h3 style="font-size:16px; font-weight:900; color:#f8fafc; margin:0; display:flex; align-items:center; gap:8px;">
            <span>👤</span> 내 프로필 &amp; 칭호 관리
          </h3>
          <button onclick="closeUserProfileModal()" style="background:transparent; border:none; color:#94a3b8; font-size:20px; cursor:pointer; padding:4px;">✕</button>
        </div>

        <!-- Body -->
        <div style="padding:20px; max-height:75vh; overflow-y:auto;">
          
          <!-- User Summary Card -->
          <div style="display:flex; align-items:center; gap:16px; background:rgba(15,23,42,0.8); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:16px; margin-bottom:16px;">
            <img src="<%= user.avatar %>" alt="avatar" style="width:64px; height:64px; border-radius:50%; border:3px solid #6366f1; box-shadow:0 0 15px rgba(99,102,241,0.4);">
            <div style="flex:1;">
              <div style="font-size:17px; font-weight:900; color:#fff;"><%= user.username %></div>
              <div style="font-size:11px; color:#64748b; font-family:'JetBrains Mono',monospace;">ID: <%= user.id %></div>
              <div style="margin-top:6px; display:flex; gap:10px; font-size:12px;">
                <span style="color:#34d399; font-weight:700;">💵 현금: <%= Number(userAssets.cash).toLocaleString() %>원</span>
                <span style="color:#38bdf8; font-weight:700;">🏦 예금: <%= Number(userAssets.bank).toLocaleString() %>원</span>
              </div>
            </div>
          </div>

          <!-- Current Equipped Title -->
          <div style="background:rgba(30,41,59,0.5); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:14px; margin-bottom:16px;">
            <div style="font-size:12px; color:#94a3b8; font-weight:700; margin-bottom:6px;">현재 장착된 대표 칭호</div>
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <div>
                <% if (typeof userLoadout !== 'undefined' && userLoadout && userLoadout.TITLE) { %>
                  <span style="<%= userLoadout.TITLE.previewCss || 'background:linear-gradient(135deg,#38bdf8,#818cf8); color:#fff; font-weight:900; padding:4px 10px; border-radius:6px; font-size:13px;' %>">
                    <%= userLoadout.TITLE.icon || '👑' %> <%= userLoadout.TITLE.name %>
                  </span>
                <% } else { %>
                  <span style="color:#64748b; font-size:13px; font-weight:700;">미장착</span>
                <% } %>
              </div>
              <% if (typeof userLoadout !== 'undefined' && userLoadout && userLoadout.TITLE) { %>
                <button onclick="unequipTitleAction()" style="background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.3); color:#f87171; border-radius:6px; padding:4px 8px; font-size:11px; font-weight:700; cursor:pointer;">
                  해제
                </button>
              <% } %>
            </div>
          </div>

          <!-- Owned Titles Selector -->
          <div style="margin-bottom:16px;">
            <div style="font-size:13px; font-weight:800; color:#f8fafc; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
              <span>🏷️</span> 보유 칭호 목록 (선택하여 즉시 장착)
            </div>
            <div id="modalTitleList" style="display:flex; flex-direction:column; gap:8px;">
              <p style="color:#64748b; font-size:12px; text-align:center; padding:10px;">보유 칭호 목록을 불러오는 중...</p>
            </div>
          </div>

          <!-- Admin Direct Link (관리자 권한 보유 시 표시) -->
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <div style="margin-bottom:12px;">
              <a href="/admin" style="display:flex; align-items:center; justify-content:center; gap:8px; background:linear-gradient(135deg, rgba(56,189,248,0.2), rgba(99,102,241,0.2)); border:1px solid rgba(56,189,248,0.4); border-radius:12px; padding:10px; color:#38bdf8; text-decoration:none; font-weight:800; font-size:13px; box-shadow:0 4px 12px rgba(56,189,248,0.15);">
                <span>🛡️</span> <span>관리자 콘솔 접속</span>
              </a>
            </div>
          <% } %>

          <!-- Quick Navigation Links -->
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <a href="/shop" style="display:flex; align-items:center; justify-content:center; gap:6px; background:rgba(99,102,241,0.15); border:1px solid rgba(99,102,241,0.35); color:#818cf8; text-decoration:none; padding:10px; border-radius:10px; font-size:13px; font-weight:800; transition:all 0.2s;">
              <span>🛍️</span> 명품관/보관함
            </a>
            <a href="/stocks" style="display:flex; align-items:center; justify-content:center; gap:6px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:#fff; text-decoration:none; padding:10px; border-radius:10px; font-size:13px; font-weight:800; transition:all 0.2s;">
              <span>🏠</span> 메인 홈으로
            </a>
          </div>

        </div>
      </div>
    </div>

    <script>
      function openUserProfileModal() {
        const modal = document.getElementById('userProfileModal');
        if (modal) {
          modal.style.display = 'flex';
          loadUserOwnedTitles();
        }
      }
      function closeUserProfileModal() {
        const modal = document.getElementById('userProfileModal');
        if (modal) modal.style.display = 'none';
      }

      async function loadUserOwnedTitles() {
        const container = document.getElementById('modalTitleList');
        if (!container) return;
        try {
          const res = await fetch('/api/economy/cosmetics/loadout');
          const data = await res.json();
          if (data.success) {
            const titles = (data.items || []).filter(i => i.itemType === 'TITLE');
            const currentTitleKey = data.loadout?.TITLE?.itemKey;
            
            if (titles.length === 0) {
              container.innerHTML = '<p style="color:#64748b; font-size:12px; text-align:center; padding:10px;">보유한 칭호가 없습니다.</p>';
              return;
            }

            container.innerHTML = titles.map(t => {
              const isEquipped = (t.itemKey === currentTitleKey);
              return `
                <div style="display:flex; align-items:center; justify-content:space-between; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:10px 14px;">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:16px;">${t.icon || '👑'}</span>
                    <span style="font-size:13px; font-weight:800; color:#fff;">${t.name}</span>
                  </div>
                  ${isEquipped 
                    ? '<span style="font-size:11px; color:#34d399; font-weight:800; background:rgba(52,211,153,0.15); padding:3px 8px; border-radius:6px;">장착중</span>'
                    : `<button onclick="equipTitleAction('${t.itemKey}')" style="background:#6366f1; border:none; color:#fff; border-radius:6px; padding:4px 10px; font-size:11px; font-weight:800; cursor:pointer;">장착하기</button>`
                  }
                </div>
              `;
            }).join('');
          }
        } catch (e) {
          container.innerHTML = '<p style="color:#ef4444; font-size:12px; text-align:center;">칭호 목록을 불러오지 못했습니다.</p>';
        }
      }

      async function equipTitleAction(itemKey) {
        try {
          const res = await fetch('/api/economy/cosmetics/equip', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slot: 'TITLE', itemKey })
          });
          const data = await res.json();
          if (data.success) {
            location.reload();
          } else {
            alert('장착 실패: ' + data.error);
          }
        } catch (e) {
          alert('네트워크 오류');
        }
      }

      async function unequipTitleAction() {
        try {
          const res = await fetch('/api/economy/cosmetics/unequip', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slot: 'TITLE' })
          });
          const data = await res.json();
          if (data.success) {
            location.reload();
          } else {
            alert('해제 실패: ' + data.error);
          }
        } catch (e) {
          alert('네트워크 오류');
        }
      }
    </script>
  <% } %>
