<%- include('layout/header', { pageTitle: '실시간 주식 거래소', activePage: 'stocks' }) %>

<style>
  /* 📈 핀테크 주식 거래소 전용 스타일 */
  .stock-header-strip {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 12px 18px;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .countdown-bar-container {
    width: 120px;
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
  }
  .countdown-bar-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #38bdf8, #818cf8);
    transition: width 1s linear;
  }

  /* 💼 내 보유 주식 포트폴리오 카드 */
  .portfolio-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 16px;
    padding: 16px 20px;
    margin-bottom: 18px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .holdings-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    font-size: 13px;
  }
  .holdings-table th {
    text-align: left;
    color: #64748b;
    padding: 8px 10px;
    font-weight: 700;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .holdings-table td {
    padding: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #f8fafc;
  }

  .stock-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }

  .stock-filter-bar {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .stock-filter-btn {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 5px 12px;
    color: #94a3b8;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .stock-filter-btn:hover, .stock-filter-btn.active {
    background: rgba(99, 102, 241, 0.2);
    border-color: rgba(99, 102, 241, 0.5);
    color: #fff;
  }

  .view-toggle-btn {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px 12px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .view-toggle-btn.active {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.1);
  }

  /* 콤팩트 카드 그리드 (짤림 방지 최적화) */
  .stocks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    margin-bottom: 30px;
  }

  .stock-card {
    background: rgba(15, 23, 42, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px;
    backdrop-filter: blur(12px);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }
  .stock-card:hover {
    border-color: rgba(99, 102, 241, 0.45);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .sparkline-svg {
    width: 100%;
    height: 28px;
    margin: 6px 0;
  }

  /* 📋 실시간 호가 테이블 뷰 */
  .stocks-table-view {
    display: none;
    width: 100%;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 30px;
  }
  .stocks-table-view table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  .stocks-table-view th {
    background: rgba(30, 41, 59, 0.6);
    color: #94a3b8;
    padding: 10px 14px;
    text-align: left;
    font-weight: 700;
  }
  .stocks-table-view td {
    padding: 12px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .stocks-table-view tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* 매수/매도 모달 */
  .order-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(8px);
    z-index: 1000;
    place-items: center;
    padding: 20px;
  }
  .order-modal-backdrop.is-open { display: grid; }
  .order-modal-box {
    background: #0f172a;
    border: 1px solid rgba(99, 102, 241, 0.4);
    border-radius: 18px;
    max-width: 400px;
    width: 100%;
    padding: 22px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.8);
  }
  .pct-btn {
    flex: 1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .pct-btn:hover {
    background: rgba(99, 102, 241, 0.2);
    border-color: #818cf8;
    color: #fff;
  }
</style>

<main style="flex:1; padding:16px 16px 140px 16px; width:100%; max-width:1240px; margin:0 auto; box-sizing:border-box;">

  <!-- ⏱️ 상단 슬림 시장 상태 스트립 -->
  <div class="stock-header-strip">
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <span style="font-size:11.5px; font-weight:800; padding:3px 8px; background:rgba(99,102,241,0.2); color:#818cf8; border-radius:6px;">실시간 거래소</span>
      <span id="market-regime-badge" style="font-size:11.5px; font-weight:800; padding:3px 8px; background:rgba(245,158,11,0.2); color:#fbbf24; border-radius:6px;">
        <%= (typeof regime !== 'undefined' && regime && regime.name) ? regime.name : '🦆 월덕 경제 번영기' %>
      </span>
      <div style="display:flex; align-items:center; gap:6px;">
        <div class="countdown-bar-container">
          <div id="countdown-bar" class="countdown-bar-fill"></div>
        </div>
        <span id="countdown-text" style="font-size:11.5px; font-family:'JetBrains Mono',monospace; color:#38bdf8; font-weight:700;">30초</span>
      </div>
    </div>

    <!-- 우측 배당금 수령 버튼 -->
    <div>
      <button onclick="claimDividends()" style="padding:6px 14px; font-weight:800; background:linear-gradient(135deg,#059669,#10b981); border:none; border-radius:8px; color:#fff; cursor:pointer; font-size:12px; display:flex; align-items:center; gap:5px; box-shadow:0 0 12px rgba(16,185,129,0.3);">
        <span>💰</span> <span>배당금 수령</span>
      </button>
    </div>
  </div>

  <!-- 💼 내 보유 주식 포트폴리오 (My Portfolio) -->
  <div class="portfolio-card">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span style="font-size:20px;">💼</span>
        <div>
          <h2 style="font-size:15.5px; font-weight:900; color:#fff; margin:0;">내 보유 주식 포트폴리오</h2>
        </div>
      </div>

      <div style="display:flex; align-items:center; gap:10px;">
        <span style="font-size:12px; color:#94a3b8;">총 평가액:</span>
        <strong id="portfolio-total-val" style="font-size:15px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace;">
          <%= Number(totalStockVal || 0).toLocaleString() %>원
        </strong>
      </div>
    </div>

    <!-- 보유 주식 목록 테이블 -->
    <% if (holdings && holdings.length > 0) { %>
      <div style="overflow-x:auto; margin-top:10px;">
        <table class="holdings-table">
          <thead>
            <tr>
              <th>종목명</th>
              <th>보유 수량</th>
              <th>현재가</th>
              <th>평가 금액</th>
              <th>평가 손익</th>
              <th>관리</th>
            </tr>
          </thead>
          <tbody id="holdings-tbody">
            <% holdings.forEach(h => { 
                const profit = Number(h.profit || 0);
                const isProf = profit >= 0;
            %>
              <tr data-holding-stock="<%= h.stockId %>">
                <td><strong style="color:#fff;"><%= h.name %></strong></td>
                <td style="font-family:'JetBrains Mono',monospace;"><%= Number(h.amount).toLocaleString() %>주</td>
                <td data-hprice="<%= h.stockId %>" style="font-family:'JetBrains Mono',monospace; color:#38bdf8;"><%= Number(h.price).toLocaleString() %>원</td>
                <td data-heval="<%= h.stockId %>" style="font-family:'JetBrains Mono',monospace;"><%= Number(h.evalVal).toLocaleString() %>원</td>
                <td data-hprofit="<%= h.stockId %>" style="font-family:'JetBrains Mono',monospace; color:<%= isProf ? '#34d399' : '#f87171' %>;">
                  <%= isProf ? '+' : '' %><%= profit.toLocaleString() %>원
                </td>
                <td>
                  <button onclick="openOrderModal('SELL', '<%= h.stockId %>', '<%= h.name %>', <%= Number(h.price) %>)" style="padding:4px 10px; font-size:11px; font-weight:800; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:6px; color:#f87171; cursor:pointer;">매도</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="margin-top:10px; padding:12px; text-align:center; background:rgba(15,23,42,0.4); border-radius:10px; color:#64748b; font-size:12.5px;">
        현재 보유 중인 주식이 없습니다. 아래 시장에서 종목을 매수해 보세요! 🚀
      </div>
    <% } %>
  </div>

  <!-- 툴바 (섹터 필터 + 카드/테이블 뷰 토글) -->
  <div class="stock-toolbar">
    <div class="stock-filter-bar">
      <button class="stock-filter-btn active" onclick="filterSector('ALL')">전체 종목 (<%= (stocks || []).length %>)</button>
      <button class="stock-filter-btn" onclick="filterSector('TECH')">🚀 IT·AI</button>
      <button class="stock-filter-btn" onclick="filterSector('FIN')">🏦 금융</button>
      <button class="stock-filter-btn" onclick="filterSector('BIO')">🧬 바이오</button>
      <button class="stock-filter-btn" onclick="filterSector('CONS')">🍗 소비재</button>
      <button class="stock-filter-btn" onclick="filterSector('ENTRY')">⭐ 초보</button>
    </div>

    <div style="display:flex; gap:6px;">
      <button id="btn-view-cards" class="view-toggle-btn active" onclick="switchView('cards')">
        <span>🎴</span> <span>카드 뷰</span>
      </button>
      <button id="btn-view-table" class="view-toggle-btn" onclick="switchView('table')">
        <span>📋</span> <span>테이블 뷰</span>
      </button>
    </div>
  </div>

  <!-- 🎴 1. 콤팩트 카드 뷰 (짤림 방지) -->
  <div id="stocks-cards-container" class="stocks-grid">
    <% (stocks || []).forEach(stock => { 
        const price = Number(stock.price || 0);
        const prevPrice = Number(stock.prev_price || stock.price || 1);
        const rate = prevPrice > 0 ? ((price - prevPrice) / prevPrice) * 100 : 0;
        const isUp = rate >= 0;
        const sign = isUp ? '+' : '';
        const color = isUp ? '#34d399' : '#f87171';
        const strokeColor = isUp ? '#10b981' : '#ef4444';
    %>
      <div class="stock-card" data-stock-id="<%= stock.stock_id %>" data-sector="<%= stock.stock_id %>">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:4px;">
            <div>
              <span style="font-size:10.5px; font-weight:800; color:#818cf8; font-family:'JetBrains Mono',monospace;"><%= stock.code || stock.stock_id %></span>
              <h3 style="font-size:14px; font-weight:800; color:#fff; margin:2px 0 0 0; line-height:1.2;"><%= stock.name %></h3>
            </div>
            <span data-stock-rate="<%= stock.stock_id %>" style="font-size:11.5px; font-weight:800; padding:2px 6px; border-radius:5px; background:<%= isUp ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)' %>; color:<%= color %>; font-family:'JetBrains Mono',monospace;">
              <%= sign %><%= rate.toFixed(2) %>%
            </span>
          </div>

          <!-- 실시간 호가 -->
          <div style="margin-top:2px;">
            <div data-stock-price="<%= stock.stock_id %>" style="font-size:17.5px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace; transition:color 0.3s ease;">
              <%= price.toLocaleString() %>원
            </div>
          </div>

          <!-- SVG 미니 스파크라인 추세선 -->
          <svg class="sparkline-svg" viewBox="0 0 100 28" preserveAspectRatio="none">
            <defs>
              <linearGradient id="grad-<%= stock.stock_id %>" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="<%= strokeColor %>" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="<%= strokeColor %>" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path id="spark-fill-<%= stock.stock_id %>" d="<%= isUp ? 'M0,22 Q25,18 50,12 T100,4 L100,28 L0,28 Z' : 'M0,4 Q25,10 50,18 T100,24 L100,28 L0,28 Z' %>" fill="url(#grad-<%= stock.stock_id %>)"/>
            <path id="spark-line-<%= stock.stock_id %>" d="<%= isUp ? 'M0,22 Q25,18 50,12 T100,4' : 'M0,4 Q25,10 50,18 T100,24' %>" fill="none" stroke="<%= strokeColor %>" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- 매수/매도 버튼 -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-top:6px;">
          <button onclick="openOrderModal('BUY', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:7px; font-weight:800; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.4); border-radius:8px; color:#34d399; cursor:pointer; font-size:12px; transition:all 0.15s ease;">매수</button>
          <button onclick="openOrderModal('SELL', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:7px; font-weight:800; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:8px; color:#f87171; cursor:pointer; font-size:12px; transition:all 0.15s ease;">매도</button>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- 📋 2. 실시간 호가 테이블 뷰 (전체 한눈에 보기) -->
  <div id="stocks-table-container" class="stocks-table-view">
    <table>
      <thead>
        <tr>
          <th>종목 코드</th>
          <th>기업명</th>
          <th>현재가</th>
          <th>변동률 (30초)</th>
          <th>빠른 주문</th>
        </tr>
      </thead>
      <tbody>
        <% (stocks || []).forEach(stock => { 
            const price = Number(stock.price || 0);
            const prevPrice = Number(stock.prev_price || stock.price || 1);
            const rate = prevPrice > 0 ? ((price - prevPrice) / prevPrice) * 100 : 0;
            const isUp = rate >= 0;
            const sign = isUp ? '+' : '';
            const color = isUp ? '#34d399' : '#f87171';
        %>
          <tr data-stock-id="<%= stock.stock_id %>">
            <td style="font-family:'JetBrains Mono',monospace; color:#818cf8; font-weight:700;"><%= stock.code || stock.stock_id %></td>
            <td><strong style="color:#fff;"><%= stock.name %></strong></td>
            <td data-stock-price="<%= stock.stock_id %>" style="font-family:'JetBrains Mono',monospace; font-weight:900; color:#38bdf8;"><%= price.toLocaleString() %>원</td>
            <td data-stock-rate="<%= stock.stock_id %>" style="font-family:'JetBrains Mono',monospace; font-weight:800; color:<%= color %>;">
              <%= sign %><%= rate.toFixed(2) %>%
            </td>
            <td>
              <div style="display:flex; gap:6px;">
                <button onclick="openOrderModal('BUY', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:4px 10px; font-weight:800; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.4); border-radius:6px; color:#34d399; cursor:pointer; font-size:11.5px;">매수</button>
                <button onclick="openOrderModal('SELL', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:4px 10px; font-weight:800; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:6px; color:#f87171; cursor:pointer; font-size:11.5px;">매도</button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- 🛒 원클릭 주문 모달 (10%, 25%, 50%, MAX) -->
  <div id="order-modal" class="order-modal-backdrop" onclick="if(event.target===this) closeOrderModal()">
    <div class="order-modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
        <h3 id="modal-order-title" style="font-size:16px; font-weight:800; color:#fff; margin:0;">주식 매수 주문</h3>
        <button onclick="closeOrderModal()" style="background:none; border:none; color:#94a3b8; font-size:18px; cursor:pointer;">✕</button>
      </div>

      <div style="background:rgba(30,41,59,0.6); border-radius:10px; padding:10px; margin-bottom:12px; font-size:12.5px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
          <span style="color:#94a3b8;">종목명</span>
          <strong id="modal-stock-name" style="color:#fff;">-</strong>
        </div>
        <div style="display:flex; justify-content:space-between;">
          <span style="color:#94a3b8;">현재가</span>
          <strong id="modal-stock-price" style="color:#38bdf8; font-family:'JetBrains Mono',monospace;">0원</strong>
        </div>
      </div>

      <!-- 수량 퍼센트 버튼 -->
      <div style="display:flex; gap:5px; margin-bottom:10px;">
        <button class="pct-btn" onclick="setOrderPercent(0.1)">10%</button>
        <button class="pct-btn" onclick="setOrderPercent(0.25)">25%</button>
        <button class="pct-btn" onclick="setOrderPercent(0.5)">50%</button>
        <button class="pct-btn" onclick="setOrderPercent(1.0)">최대 (MAX)</button>
      </div>

      <div style="margin-bottom:14px;">
        <label style="display:block; font-size:11.5px; color:#94a3b8; margin-bottom:4px; font-weight:700;">주문 수량</label>
        <input type="number" id="modal-order-amount" value="1" min="1" oninput="updateModalTotal()" style="width:100%; background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:8px 12px; color:#fff; font-family:'JetBrains Mono',monospace; font-weight:700; font-size:14px; box-sizing:border-box;">
      </div>

      <div style="display:flex; justify-content:space-between; margin-bottom:16px; font-size:13.5px;">
        <span style="color:#94a3b8;">총 예상 금액</span>
        <strong id="modal-order-total" style="color:#34d399; font-family:'JetBrains Mono',monospace; font-size:15px;">0원</strong>
      </div>

      <button id="modal-submit-btn" onclick="submitOrder()" style="width:100%; padding:12px; font-weight:900; border:none; border-radius:10px; color:#fff; cursor:pointer; font-size:14px; background:linear-gradient(135deg,#059669,#10b981); box-shadow:0 0 16px rgba(16,185,129,0.3);">
        주문 확인 및 체결
      </button>
    </div>
  </div>

</main>

<script>
  let currentOrder = { action: 'BUY', stockId: '', price: 0 };
  let countdownSec = 30;

  // ⏱️ 30초 카운트다운 게이지 & 주기적 갱신 트리거
  setInterval(() => {
    countdownSec--;
    if (countdownSec <= 0) {
      countdownSec = 30;
      if (window.__globalSocket) {
        window.__globalSocket.emit('market:refresh');
      }
    }
    const bar = document.getElementById('countdown-bar');
    const text = document.getElementById('countdown-text');
    if (bar) bar.style.width = ((countdownSec / 30) * 100) + '%';
    if (text) text.innerText = countdownSec + '초';
  }, 1000);

  // ⚡ Socket.IO 실시간 가격 변동 수신 및 카드/보유주식 자동 업데이트
  if (typeof io !== 'undefined') {
    const socket = window.__globalSocket || io();
    socket.on('market:update', (data) => {
      if (!data || !data.stocks) return;
      
      let newTotalStockVal = 0;

      data.stocks.forEach(stock => {
        const sid = stock.stock_id;
        const newPrice = Number(stock.price);
        const prevPrice = Number(stock.prev_price || stock.price || 1);
        const rate = prevPrice > 0 ? ((newPrice - prevPrice) / prevPrice) * 100 : 0;
        const isUp = rate >= 0;
        const sign = isUp ? '+' : '';
        const color = isUp ? '#34d399' : '#f87171';
        const stroke = isUp ? '#10b981' : '#ef4444';

        // 1. 주식 카드 및 테이블 가격/등락률 갱신 (전체 다중 엘리먼트 업데이트)
        document.querySelectorAll(`[data-stock-price="${sid}"]`).forEach(el => {
          el.innerText = newPrice.toLocaleString() + '원';
          el.style.color = color;
          setTimeout(() => { el.style.color = '#38bdf8'; }, 2500);
        });

        document.querySelectorAll(`[data-stock-rate="${sid}"]`).forEach(el => {
          el.innerText = `${sign}${rate.toFixed(2)}%`;
          el.style.color = color;
          if (el.tagName === 'SPAN') {
            el.style.background = isUp ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
          }
        });

        // 2. 스파크라인 차트 색상 갱신
        const sparkLine = document.getElementById(`spark-line-${sid}`);
        const sparkFill = document.getElementById(`spark-fill-${sid}`);
        if (sparkLine) {
          sparkLine.setAttribute('stroke', stroke);
          sparkLine.setAttribute('d', isUp ? 'M0,22 Q25,18 50,12 T100,4' : 'M0,4 Q25,10 50,18 T100,24');
        }
        if (sparkFill) {
          sparkFill.setAttribute('d', isUp ? 'M0,22 Q25,18 50,12 T100,4 L100,28 L0,28 Z' : 'M0,4 Q25,10 50,18 T100,24 L100,28 L0,28 Z');
        }

        // 3. 내 보유 주식 테이블 실시간 평가액 갱신
        const hPriceEl = document.querySelector(`[data-hprice="${sid}"]`);
        const hEvalEl = document.querySelector(`[data-heval="${sid}"]`);
        if (hPriceEl) hPriceEl.innerText = newPrice.toLocaleString() + '원';
        if (hEvalEl) {
          const row = document.querySelector(`[data-holding-stock="${sid}"]`);
          if (row) {
            const amountText = row.children[1].innerText.replace(/[^0-9]/g, '');
            const amount = Number(amountText) || 0;
            const evalVal = amount * newPrice;
            hEvalEl.innerText = evalVal.toLocaleString() + '원';
            newTotalStockVal += evalVal;
          }
        }
      });

      if (data.regime && data.regime.name) {
        const regEl = document.getElementById('market-regime-badge');
        if (regEl) regEl.innerText = data.regime.name;
      }
    });
  }

  function openOrderModal(action, stockId, stockName, price) {
    const priceEl = document.querySelector(`[data-stock-price="${stockId}"]`);
    if (priceEl) {
      const parsed = parseInt(priceEl.innerText.replace(/[^0-9]/g, ''));
      if (parsed > 0) price = parsed;
    }

    currentOrder = { action, stockId, price };
    document.getElementById('modal-order-title').innerText = `주식 ${action === 'BUY' ? '매수' : '매도'} 주문`;
    document.getElementById('modal-stock-name').innerText = stockName;
    document.getElementById('modal-stock-price').innerText = price.toLocaleString() + '원';
    document.getElementById('modal-order-amount').value = 1;
    
    const submitBtn = document.getElementById('modal-submit-btn');
    if (action === 'BUY') {
      submitBtn.style.background = 'linear-gradient(135deg,#059669,#10b981)';
      submitBtn.innerText = '매수 체결하기';
    } else {
      submitBtn.style.background = 'linear-gradient(135deg,#dc2626,#ef4444)';
      submitBtn.innerText = '매도 체결하기';
    }
    
    updateModalTotal();
    document.getElementById('order-modal').classList.add('is-open');
  }

  function closeOrderModal() {
    document.getElementById('order-modal').classList.remove('is-open');
  }

  function setOrderPercent(pct) {
    const cash = Number('<%= (typeof userAssets !== "undefined" && userAssets && userAssets.cash) ? userAssets.cash : 0 %>');
    if (currentOrder.action === 'BUY') {
      if (currentOrder.price <= 0) return;
      const maxShares = Math.floor((cash * pct) / currentOrder.price);
      document.getElementById('modal-order-amount').value = Math.max(1, maxShares);
    } else {
      document.getElementById('modal-order-amount').value = Math.max(1, Math.floor(10 * pct));
    }
    updateModalTotal();
  }

  function updateModalTotal() {
    const amount = Number(document.getElementById('modal-order-amount').value) || 0;
    const total = amount * currentOrder.price;
    document.getElementById('modal-order-total').innerText = total.toLocaleString() + '원';
  }

  async function submitOrder() {
    const amount = Number(document.getElementById('modal-order-amount').value) || 0;
    if (amount <= 0) { alert('수량을 입력하세요.'); return; }

    const url = currentOrder.action === 'BUY' ? '/api/stocks/buy' : '/api/stocks/sell';
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ stockId: currentOrder.stockId, amount })
      });
      const data = await res.json();
      if (data.success) {
        alert(`🎉 주식 ${currentOrder.action === 'BUY' ? '매수' : '매도'}가 체결되었습니다!`);
        window.location.reload();
      } else {
        alert(data.error || '주문 실패');
      }
    } catch (e) { alert('네트워크 오류가 발생했습니다.'); }
  }

  async function claimDividends() {
    try {
      const res = await fetch('/api/stocks/dividends/claim', { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        alert(`💰 배당금 +${Number(data.reward || 0).toLocaleString()}원이 지급되었습니다!`);
        window.location.reload();
      } else {
        alert(data.error || '수령 가능한 배당금이 없습니다.');
      }
    } catch (e) { alert('배당금 수령 요청 실패'); }
  }

  function switchView(mode) {
    const cardCont = document.getElementById('stocks-cards-container');
    const tableCont = document.getElementById('stocks-table-container');
    const btnCard = document.getElementById('btn-view-cards');
    const btnTable = document.getElementById('btn-view-table');

    if (mode === 'cards') {
      cardCont.style.display = 'grid';
      tableCont.style.display = 'none';
      btnCard.classList.add('active');
      btnTable.classList.remove('active');
    } else {
      cardCont.style.display = 'none';
      tableCont.style.display = 'block';
      btnCard.classList.remove('active');
      btnTable.classList.add('active');
    }
  }

  function filterSector(sector) {
    document.querySelectorAll('.stock-filter-btn').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    const cards = document.querySelectorAll('.stock-card');
    const tableRows = document.querySelectorAll('#stocks-table-container tbody tr');
    
    cards.forEach(card => {
      card.style.display = 'flex';
    });
    tableRows.forEach(row => {
      row.style.display = '';
    });
  }
</script>

<%- include('layout/footer', { activePage: 'stocks' }) %>
