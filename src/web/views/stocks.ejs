<%- include('layout/header', { pageTitle: '실시간 주식 거래소', activePage: 'stocks' }) %>

<style>
  /* 📈 핀테크 주식 거래소 전용 스타일 */
  .stock-header-strip {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 12px 18px;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .countdown-bar-container {
    width: 120px;
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
  }
  .countdown-bar-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #38bdf8, #818cf8);
    transition: width 1s linear;
  }

  /* 💼 내 보유 주식 포트폴리오 카드 */
  .portfolio-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 16px;
    padding: 16px 20px;
    margin-bottom: 18px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .holdings-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    font-size: 13px;
  }
  .holdings-table th {
    text-align: left;
    color: #64748b;
    padding: 8px 10px;
    font-weight: 700;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .holdings-table td {
    padding: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #f8fafc;
  }

  .stock-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }

  .stock-filter-bar {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .stock-filter-btn {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 5px 12px;
    color: #94a3b8;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .stock-filter-btn:hover, .stock-filter-btn.active {
    background: rgba(99, 102, 241, 0.2);
    border-color: rgba(99, 102, 241, 0.5);
    color: #fff;
  }

  .view-toggle-btn {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px 12px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .view-toggle-btn.active {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.1);
  }

  .chart-tf-btn {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 3px 10px;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .chart-tf-btn:hover, .chart-tf-btn.active {
    background: rgba(56, 189, 248, 0.2);
    border-color: rgba(56, 189, 248, 0.5);
    color: #38bdf8;
  }

  /* 콤팩트 카드 그리드 (짤림 방지 최적화) */
  .stocks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    margin-bottom: 30px;
  }

  .stock-card {
    background: rgba(15, 23, 42, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px;
    backdrop-filter: blur(12px);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }
  .stock-card:hover {
    border-color: rgba(99, 102, 241, 0.45);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .sparkline-svg {
    width: 100%;
    height: 28px;
    margin: 6px 0;
  }

  /* 📋 실시간 호가 테이블 뷰 */
  .stocks-table-view {
    display: none;
    width: 100%;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 30px;
  }
  .stocks-table-view table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  .stocks-table-view th {
    background: rgba(30, 41, 59, 0.6);
    color: #94a3b8;
    padding: 10px 14px;
    text-align: left;
    font-weight: 700;
  }
  .stocks-table-view td {
    padding: 12px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .stocks-table-view tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* 매수/매도 모달 */
  .order-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(8px);
    z-index: 1000;
    place-items: center;
    padding: 20px;
  }
  .order-modal-backdrop.is-open { display: grid; }
  .order-modal-box {
    background: #0f172a;
    border: 1px solid rgba(99, 102, 241, 0.4);
    border-radius: 18px;
    max-width: 400px;
    width: 100%;
    padding: 22px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.8);
  }
  .pct-btn {
    flex: 1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .pct-btn:hover {
    background: rgba(99, 102, 241, 0.2);
    border-color: #818cf8;
    color: #fff;
  }
</style>

<main style="flex:1; padding:16px 16px 140px 16px; width:100%; max-width:1240px; margin:0 auto; box-sizing:border-box;">

  <!-- ⏱️ 상단 슬림 시장 상태 스트립 -->
  <div class="stock-header-strip">
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <span style="font-size:11.5px; font-weight:800; padding:3px 8px; background:rgba(99,102,241,0.2); color:#818cf8; border-radius:6px;">실시간 거래소</span>
      <span id="market-regime-badge" style="font-size:11.5px; font-weight:800; padding:3px 8px; background:rgba(245,158,11,0.2); color:#fbbf24; border-radius:6px;">
        <%= (typeof regime !== 'undefined' && regime && regime.name) ? regime.name : '🦆 월덕 경제 번영기' %>
      </span>

    </div>

    <!-- 우측 배당금 수령 버튼 -->
    <div>
      <button onclick="claimDividends()" style="padding:6px 14px; font-weight:800; background:linear-gradient(135deg,#059669,#10b981); border:none; border-radius:8px; color:#fff; cursor:pointer; font-size:12px; display:flex; align-items:center; gap:5px; box-shadow:0 0 12px rgba(16,185,129,0.3);">
        <span>💰</span> <span>배당금 수령</span>
      </button>
    </div>
  </div>

  <!-- 💼 내 보유 주식 포트폴리오 (My Portfolio) -->
  <div class="portfolio-card">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span style="font-size:20px;">💼</span>
        <div>
          <h2 style="font-size:15.5px; font-weight:900; color:#fff; margin:0;">내 보유 주식 포트폴리오</h2>
        </div>
      </div>

      <div style="display:flex; align-items:center; gap:10px;">
        <span style="font-size:12px; color:#94a3b8;">총 평가액:</span>
        <strong id="portfolio-total-val" style="font-size:15px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace;">
          <%= Number(totalStockVal || 0).toLocaleString() %>원
        </strong>
      </div>
    </div>

    <!-- 보유 주식 목록 테이블 -->
    <% if (holdings && holdings.length > 0) { %>
      <div style="overflow-x:auto; margin-top:10px;">
        <table class="holdings-table">
          <thead>
            <tr>
              <th>종목명</th>
              <th>보유 수량</th>
              <th>현재가</th>
              <th>평가 금액</th>
              <th>평가 손익</th>
              <th>관리</th>
            </tr>
          </thead>
          <tbody id="holdings-tbody">
            <% holdings.forEach(h => { 
                const profit = Number(h.profit || 0);
                const isProf = profit >= 0;
            %>
              <tr data-holding-stock="<%= h.stockId %>">
                <td><strong style="color:#fff;"><%= h.name %></strong></td>
                <td style="font-family:'JetBrains Mono',monospace;"><%= Number(h.amount).toLocaleString() %>주</td>
                <td data-hprice="<%= h.stockId %>" style="font-family:'JetBrains Mono',monospace; color:#38bdf8;"><%= Number(h.price).toLocaleString() %>원</td>
                <td data-heval="<%= h.stockId %>" style="font-family:'JetBrains Mono',monospace;"><%= Number(h.evalVal).toLocaleString() %>원</td>
                <td data-hprofit="<%= h.stockId %>" style="font-family:'JetBrains Mono',monospace; color:<%= isProf ? '#34d399' : '#f87171' %>;">
                  <%= isProf ? '+' : '' %><%= profit.toLocaleString() %>원
                </td>
                <td>
                  <button onclick="openOrderModal('SELL', '<%= h.stockId %>', '<%= h.name %>', <%= Number(h.price) %>)" style="padding:4px 10px; font-size:11px; font-weight:800; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:6px; color:#f87171; cursor:pointer;">매도</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="margin-top:10px; padding:12px; text-align:center; background:rgba(15,23,42,0.4); border-radius:10px; color:#64748b; font-size:12.5px;">
        현재 보유 중인 주식이 없습니다. 아래 시장에서 종목을 매수해 보세요! 🚀
      </div>
    <% } %>
  </div>

  <!-- 툴바 (섹터 필터 + 카드/테이블 뷰 토글) -->
  <div class="stock-toolbar">
    <div class="stock-filter-bar">
      <button class="stock-filter-btn active" onclick="filterSector('ALL', this)">전체 종목 (<%= (stocks || []).length %>)</button>
      <button class="stock-filter-btn" onclick="filterSector('AI', this)">🧠 AI·반도체</button>
      <button class="stock-filter-btn" onclick="filterSector('IT', this)">💻 IT·빅데이터</button>
      <button class="stock-filter-btn" onclick="filterSector('FIN', this)">🏦 금융·은행</button>
      <button class="stock-filter-btn" onclick="filterSector('BIO', this)">🧬 바이오</button>
      <button class="stock-filter-btn" onclick="filterSector('CONS', this)">🍗 소비재</button>
      <button class="stock-filter-btn" onclick="filterSector('ENTRY', this)">⭐ 초보추천</button>
    </div>

    <div style="display:flex; gap:6px;">
      <button id="btn-view-cards" class="view-toggle-btn active" onclick="switchView('cards')">
        <span>🎴</span> <span>카드 뷰</span>
      </button>
      <button id="btn-view-table" class="view-toggle-btn" onclick="switchView('table')">
        <span>📋</span> <span>테이블 뷰</span>
      </button>
    </div>
  </div>

  <!-- 🎴 1. 콤팩트 카드 뷰 (짤림 방지) -->
  <div id="stocks-cards-container" class="stocks-grid">
    <% (stocks || []).forEach(stock => { 
        const price = Number(stock.price || 0);
        const prevPrice = Number(stock.prev_price || stock.price || 1);
        const rate = prevPrice > 0 ? ((price - prevPrice) / prevPrice) * 100 : 0;
        const isUp = rate >= 0;
        const sign = isUp ? '+' : '';
        const color = isUp ? '#34d399' : '#f87171';
        const strokeColor = isUp ? '#10b981' : '#ef4444';
        
        let cats = ['ALL'];
        const sid = stock.stock_id;
        if (sid === 'AICH' || sid === 'WTRD' || sid === 'NEKO') cats.push('AI');
        if (sid === 'DUCK' || sid === 'SCRP' || sid === 'AICH' || sid === 'SPAC' || sid === 'WTRD') cats.push('IT', 'TECH');
        if (sid === 'BANK') cats.push('FIN');
        if (sid === 'BIOX') cats.push('BIO');
        if (sid === 'CHKN' || sid === 'SLOT') cats.push('CONS');
        if (sid === 'SLOT' || sid === 'CHKN') cats.push('ENTRY');
        const isSoldOut = stock.max_buy_limit != null && stock.remaining_shares != null && stock.remaining_shares <= 0;
        const catStr = cats.join(' ');
    %>
      <div class="stock-card" data-stock-id="<%= stock.stock_id %>" data-remaining-shares="<%= stock.remaining_shares != null ? stock.remaining_shares : '' %>" data-total-shares-limit="<%= stock.max_buy_limit != null ? stock.max_buy_limit : '' %>" data-categories="<%= catStr %>" tabindex="0" role="button" aria-label="<%= stock.name %> (<%= stock.stock_id %>) 현재가 <%= price.toLocaleString() %>원, 상세 차트 및 거래 열기" onclick="openDetailModal('<%= stock.stock_id %>')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault(); openDetailModal('<%= stock.stock_id %>');}" style="cursor:pointer; outline:none; <%= isSoldOut ? 'border-color:rgba(239,68,68,0.4); background:rgba(25,15,20,0.85);' : '' %>">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:4px;">
            <div>
              <span style="font-size:10.5px; font-weight:800; color:#818cf8; font-family:'JetBrains Mono',monospace;"><%= stock.code || stock.stock_id %></span>
              <h3 style="font-size:14px; font-weight:800; color:#fff; margin:2px 0 0 0; line-height:1.2;"><%= stock.name %></h3>
            </div>
            <span data-stock-rate="<%= stock.stock_id %>" style="font-size:11.5px; font-weight:800; padding:2px 6px; border-radius:5px; background:<%= isUp ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)' %>; color:<%= color %>; font-family:'JetBrains Mono',monospace;">
              <%= sign %><%= rate.toFixed(2) %>%
            </span>
          </div>

          <!-- 실시간 호가 & 차트보기 뱃지 -->
          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:2px;">
            <div data-stock-price="<%= stock.stock_id %>" style="font-size:17.5px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace; transition:color 0.3s ease;">
              <%= price.toLocaleString() %>원
            </div>
            <button type="button" onclick="event.stopPropagation(); openDetailModal('<%= stock.stock_id %>')" style="background:rgba(129,140,248,0.15); border:1px solid rgba(129,140,248,0.3); border-radius:6px; padding:2px 6px; font-size:11px; color:#818cf8; font-weight:700; cursor:pointer;" aria-label="<%= stock.name %> 상세 차트 보기">
              🔍 차트
            </button>
          </div>

          <!-- 🛡️ 전체 발행 한도 및 잔여 주식 수량 표시 -->
          <div style="font-size:11px; margin-top:4px;">
            <% if (stock.max_buy_limit != null) { %>
              <% if (isSoldOut) { %>
                <span style="color:#ef4444; font-weight:900; background:rgba(239,68,68,0.15); padding:1px 6px; border-radius:4px;">🔴 전역 매진 (총 <%= Number(stock.max_buy_limit).toLocaleString() %>주 소진)</span>
              <% } else { %>
                <span style="color:#94a3b8;">발행 잔여: <b style="color:#34d399; font-family:'JetBrains Mono',monospace;"><%= Number(stock.remaining_shares).toLocaleString() %>주</b> / <%= Number(stock.max_buy_limit).toLocaleString() %>주</span>
              <% } %>
            <% } else { %>
              <span style="color:#64748b;">발행 한도: 무제한</span>
            <% } %>
          </div>

          <!-- SVG 미니 스파크라인 추세선 -->
          <svg class="sparkline-svg" viewBox="0 0 100 28" preserveAspectRatio="none">
            <defs>
              <linearGradient id="grad-<%= stock.stock_id %>" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="<%= strokeColor %>" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="<%= strokeColor %>" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path id="spark-fill-<%= stock.stock_id %>" d="<%= isUp ? 'M0,22 Q25,18 50,12 T100,4 L100,28 L0,28 Z' : 'M0,4 Q25,10 50,18 T100,24 L100,28 L0,28 Z' %>" fill="url(#grad-<%= stock.stock_id %>)"/>
            <path id="spark-line-<%= stock.stock_id %>" d="<%= isUp ? 'M0,22 Q25,18 50,12 T100,4' : 'M0,4 Q25,10 50,18 T100,24' %>" fill="none" stroke="<%= strokeColor %>" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- 매수/매도 버튼 -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-top:6px;">
          <button onclick="event.stopPropagation(); openOrderModal('BUY', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:7px; font-weight:800; background:<%= isSoldOut ? 'rgba(100,116,139,0.2)' : 'rgba(16,185,129,0.15)' %>; border:1px solid <%= isSoldOut ? 'rgba(100,116,139,0.4)' : 'rgba(16,185,129,0.4)' %>; border-radius:8px; color:<%= isSoldOut ? '#94a3b8' : '#34d399' %>; cursor:pointer; font-size:12px; transition:all 0.15s ease;">
            <%= isSoldOut ? '매진' : '매수' %>
          </button>
          <button onclick="event.stopPropagation(); openOrderModal('SELL', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:7px; font-weight:800; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:8px; color:#f87171; cursor:pointer; font-size:12px; transition:all 0.15s ease;">매도</button>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- 📋 2. 실시간 호가 테이블 뷰 (전체 한눈에 보기) -->
  <div id="stocks-table-container" class="stocks-table-view">
    <table>
      <thead>
        <tr>
          <th>종목 코드</th>
          <th>기업명</th>
          <th>현재가</th>
          <th>변동률 (30초)</th>
          <th>발행 잔여 수량</th>
          <th>분석 & 주문</th>
        </tr>
      </thead>
      <tbody>
        <% (stocks || []).forEach(stock => { 
            const price = Number(stock.price || 0);
            const prevPrice = Number(stock.prev_price || stock.price || 1);
            const rate = prevPrice > 0 ? ((price - prevPrice) / prevPrice) * 100 : 0;
            const isUp = rate >= 0;
            const sign = isUp ? '+' : '';
            const color = isUp ? '#34d399' : '#f87171';
            const isSoldOut = stock.max_buy_limit != null && stock.remaining_shares != null && stock.remaining_shares <= 0;

            let cats = ['ALL'];
            const sid = stock.stock_id;
            if (sid === 'AICH' || sid === 'WTRD' || sid === 'NEKO') cats.push('AI');
            if (sid === 'DUCK' || sid === 'SCRP' || sid === 'AICH' || sid === 'SPAC' || sid === 'WTRD') cats.push('IT', 'TECH');
            if (sid === 'BANK') cats.push('FIN');
            if (sid === 'BIOX') cats.push('BIO');
            if (sid === 'CHKN' || sid === 'SLOT') cats.push('CONS');
            if (sid === 'SLOT' || sid === 'CHKN') cats.push('ENTRY');
            const catStr = cats.join(' ');
        %>
          <tr data-stock-id="<%= stock.stock_id %>" data-remaining-shares="<%= stock.remaining_shares != null ? stock.remaining_shares : '' %>" data-total-shares-limit="<%= stock.max_buy_limit != null ? stock.max_buy_limit : '' %>" data-categories="<%= catStr %>" onclick="openDetailModal('<%= stock.stock_id %>')" style="cursor:pointer;">
            <td style="font-family:'JetBrains Mono',monospace; color:#818cf8; font-weight:700;"><%= stock.code || stock.stock_id %></td>
            <td><strong style="color:#fff;"><%= stock.name %></strong></td>
            <td data-stock-price="<%= stock.stock_id %>" style="font-family:'JetBrains Mono',monospace; font-weight:900; color:#38bdf8;"><%= price.toLocaleString() %>원</td>
            <td data-stock-rate="<%= stock.stock_id %>" style="font-family:'JetBrains Mono',monospace; font-weight:800; color:<%= color %>;">
              <%= sign %><%= rate.toFixed(2) %>%
            </td>
            <td>
              <% if (stock.max_buy_limit != null) { %>
                <% if (isSoldOut) { %>
                  <span style="color:#ef4444; font-weight:800;">🔴 매진 (0 / <%= Number(stock.max_buy_limit).toLocaleString() %>주)</span>
                <% } else { %>
                  <span style="color:#34d399; font-family:'JetBrains Mono',monospace; font-weight:700;"><%= Number(stock.remaining_shares).toLocaleString() %>주</span>
                  <span style="color:#64748b; font-size:11px;">/ <%= Number(stock.max_buy_limit).toLocaleString() %>주</span>
                <% } %>
              <% } else { %>
                <span style="color:#64748b;">무제한</span>
              <% } %>
            </td>
            <td>
              <div style="display:flex; gap:6px;">
                <button onclick="event.stopPropagation(); openDetailModal('<%= stock.stock_id %>')" style="padding:4px 8px; font-weight:800; background:rgba(99,102,241,0.15); border:1px solid rgba(99,102,241,0.4); border-radius:6px; color:#a5b4fc; cursor:pointer; font-size:11.5px;">🔍 차트</button>
                <button onclick="event.stopPropagation(); openOrderModal('BUY', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:4px 10px; font-weight:800; background:<%= isSoldOut ? 'rgba(100,116,139,0.2)' : 'rgba(16,185,129,0.15)' %>; border:1px solid <%= isSoldOut ? 'rgba(100,116,139,0.4)' : 'rgba(16,185,129,0.4)' %>; border-radius:6px; color:<%= isSoldOut ? '#94a3b8' : '#34d399' %>; cursor:pointer; font-size:11.5px;">
                  <%= isSoldOut ? '매진' : '매수' %>
                </button>
                <button onclick="event.stopPropagation(); openOrderModal('SELL', '<%= stock.stock_id %>', '<%= stock.name %>', <%= price %>)" style="padding:4px 10px; font-weight:800; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:6px; color:#f87171; cursor:pointer; font-size:11.5px;">매도</button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- 📈 실시간 주식 상세 차트 & 기업 분석 모달 -->
  <div id="detail-modal" class="order-modal-backdrop" onclick="if(event.target===this) closeDetailModal()" style="display:none;">
    <div class="order-modal-box" style="max-width: 540px; width: 92%;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px;">
        <div>
          <div style="display:flex; align-items:center; gap:6px;">
            <span id="detail-symbol" style="font-size:11px; font-weight:800; color:#818cf8; font-family:'JetBrains Mono',monospace;">[CODE]</span>
            <span id="detail-sector" style="font-size:11px; background:rgba(99,102,241,0.15); color:#a5b4fc; padding:2px 6px; border-radius:4px; font-weight:700;">주식</span>
          </div>
          <h3 id="detail-stock-name" style="font-size:18px; font-weight:900; color:#fff; margin:4px 0 0 0;">종목명</h3>
        </div>
        <button onclick="closeDetailModal()" style="background:none; border:none; color:#94a3b8; font-size:20px; cursor:pointer; padding:4px;">✕</button>
      </div>

      <!-- 실시간 시세 & 변동률 헤더 -->
      <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:12px; padding:10px 14px; background:rgba(15,23,42,0.6); border-radius:10px; border:1px solid rgba(255,255,255,0.06);">
        <div>
          <div style="font-size:11px; color:#94a3b8;">현재가</div>
          <div id="detail-price" style="font-size:22px; font-weight:900; color:#38bdf8; font-family:'JetBrains Mono',monospace;">0원</div>
        </div>
        <div style="text-align:right;">
          <div id="detail-rate" style="font-size:15px; font-weight:900; font-family:'JetBrains Mono',monospace; color:#34d399;">+0.00%</div>
          <div id="detail-prev" style="font-size:11px; color:#64748b;">이전가 0원</div>
        </div>
      </div>

      <!-- 타임프레임 탭 -->
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button type="button" class="chart-tf-btn active" onclick="switchChartTf(this, 15)">1분</button>
          <button type="button" class="chart-tf-btn" onclick="switchChartTf(this, 30)">5분</button>
          <button type="button" class="chart-tf-btn" onclick="switchChartTf(this, 60)">15분</button>
          <button type="button" class="chart-tf-btn" onclick="switchChartTf(this, 100)">1일</button>
        </div>
        <span style="font-size:11px; color:#64748b;">30초 주기 실시간 캔들/추세</span>
      </div>

      <!-- 📊 메인 인터랙티브 차트 캔버스 영역 -->
      <div id="detail-chart-svg" style="width:100%; height:180px; background:#0b0f19; border:1px solid rgba(255,255,255,0.08); border-radius:10px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; position:relative; overflow:hidden;">
        <span style="color:#94a3b8; font-size:13px;">차트를 불러오는 중...</span>
      </div>

      <!-- 24H 시세 지표 & 기업 정보 -->
      <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; margin-bottom:14px; font-size:11.5px;">
        <div style="background:rgba(30,41,59,0.5); padding:8px 10px; border-radius:8px;">
          <span style="color:#94a3b8; display:block;">24H 최고가</span>
          <b id="detail-high" style="color:#34d399; font-family:'JetBrains Mono',monospace;">0원</b>
        </div>
        <div style="background:rgba(30,41,59,0.5); padding:8px 10px; border-radius:8px;">
          <span style="color:#94a3b8; display:block;">24H 최저가</span>
          <b id="detail-low" style="color:#f87171; font-family:'JetBrains Mono',monospace;">0원</b>
        </div>
        <div style="background:rgba(30,41,59,0.5); padding:8px 10px; border-radius:8px;">
          <span style="color:#94a3b8; display:block;">시가총액</span>
          <b id="detail-cap" style="color:#cbd5e1;">-</b>
        </div>
      </div>

      <!-- 내 보유 현황 & 기업 설명 -->
      <div style="background:rgba(30,41,59,0.4); border-radius:8px; padding:10px; margin-bottom:16px; font-size:12px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
          <span style="color:#94a3b8;">내 보유 수량</span>
          <b id="detail-my-holding" style="color:#fff;">0주 (0스택)</b>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
          <span style="color:#94a3b8;">매수 평균단가</span>
          <b id="detail-my-avg" style="color:#38bdf8; font-family:'JetBrains Mono',monospace;">0원</b>
        </div>
        <p id="detail-description" style="color:#94a3b8; font-size:11.5px; margin:6px 0 0 0; line-height:1.4; border-top:1px solid rgba(255,255,255,0.05); padding-top:6px;">-</p>
      </div>

      <!-- 매수 / 매도 버튼 -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <button onclick="tradeFromDetail('BUY')" style="padding:12px; font-weight:900; background:linear-gradient(135deg,#059669,#10b981); border:none; border-radius:10px; color:#fff; cursor:pointer; font-size:14px; box-shadow:0 0 14px rgba(16,185,129,0.3);">🛒 매수하기</button>
        <button onclick="tradeFromDetail('SELL')" style="padding:12px; font-weight:900; background:linear-gradient(135deg,#dc2626,#ef4444); border:none; border-radius:10px; color:#fff; cursor:pointer; font-size:14px; box-shadow:0 0 14px rgba(239,68,68,0.3);">💰 매도하기</button>
      </div>
    </div>
  </div>

  <!-- 🛒 원클릭 주문 모달 (10%, 25%, 50%, MAX) -->
  <div id="order-modal" class="order-modal-backdrop" onclick="if(event.target===this) closeOrderModal()">
    <div class="order-modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
        <h3 id="modal-order-title" style="font-size:16px; font-weight:800; color:#fff; margin:0;">주식 매수 주문</h3>
        <button onclick="closeOrderModal()" style="background:none; border:none; color:#94a3b8; font-size:18px; cursor:pointer;">✕</button>
      </div>

      <div style="background:rgba(30,41,59,0.6); border-radius:10px; padding:10px; margin-bottom:12px; font-size:12.5px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
          <span style="color:#94a3b8;">종목명</span>
          <strong id="modal-stock-name" style="color:#fff;">-</strong>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
          <span style="color:#94a3b8;">현재가</span>
          <strong id="modal-stock-price" style="color:#38bdf8; font-family:'JetBrains Mono',monospace;">0원</strong>
        </div>
        <div id="modal-supply-row" style="display:flex; justify-content:space-between;">
          <span style="color:#94a3b8;">전체 발행 잔여량</span>
          <strong id="modal-stock-remaining" style="color:#34d399; font-family:'JetBrains Mono',monospace;">-</strong>
        </div>
      </div>

      <!-- 수량 퍼센트 버튼 -->
      <div style="display:flex; gap:5px; margin-bottom:10px;">
        <button class="pct-btn" onclick="setOrderPercent(0.1)">10%</button>
        <button class="pct-btn" onclick="setOrderPercent(0.25)">25%</button>
        <button class="pct-btn" onclick="setOrderPercent(0.5)">50%</button>
        <button class="pct-btn" onclick="setOrderPercent(1.0)">최대 (MAX)</button>
      </div>

      <div style="margin-bottom:14px;">
        <label style="display:block; font-size:11.5px; color:#94a3b8; margin-bottom:4px; font-weight:700;">주문 수량</label>
        <input type="number" id="modal-order-amount" value="1" min="1" oninput="updateModalTotal()" style="width:100%; background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:8px 12px; color:#fff; font-family:'JetBrains Mono',monospace; font-weight:700; font-size:14px; box-sizing:border-box;">
      </div>

      <div style="display:flex; justify-content:space-between; margin-bottom:16px; font-size:13.5px;">
        <span style="color:#94a3b8;">총 예상 금액</span>
        <strong id="modal-order-total" style="color:#34d399; font-family:'JetBrains Mono',monospace; font-size:15px;">0원</strong>
      </div>

      <button id="modal-submit-btn" onclick="submitOrder()" style="width:100%; padding:12px; font-weight:900; border:none; border-radius:10px; color:#fff; cursor:pointer; font-size:14px; background:linear-gradient(135deg,#059669,#10b981); box-shadow:0 0 16px rgba(16,185,129,0.3);">
        주문 확인 및 체결
      </button>
    </div>
  </div>

</main>

<script>
  let currentOrder = { action: 'BUY', stockId: '', price: 0 };
  let countdownSec = 30;

  // ⏱️ 30초 카운트다운 게이지 & 주기적 갱신 트리거
  setInterval(() => {
    countdownSec--;
    if (countdownSec <= 0) {
      countdownSec = 30;
      if (window.__globalSocket) {
        window.__globalSocket.emit('market:refresh');
      }
    }
    const bar = document.getElementById('countdown-bar');
    const text = document.getElementById('countdown-text');
    if (bar) bar.style.width = ((countdownSec / 30) * 100) + '%';
    if (text) text.innerText = countdownSec + '초';
  }, 1000);

  // ⚡ Socket.IO 실시간 가격 변동 수신 및 카드/보유주식 자동 업데이트
  if (typeof io !== 'undefined') {
    const socket = window.__globalSocket || io();
    socket.on('market:update', (data) => {
      if (!data || !data.stocks) return;
      
      let newTotalStockVal = 0;

      data.stocks.forEach(stock => {
        const sid = stock.stock_id;
        const newPrice = Number(stock.price);
        const prevPrice = Number(stock.prev_price || stock.price || 1);
        const rate = prevPrice > 0 ? ((newPrice - prevPrice) / prevPrice) * 100 : 0;
        const isUp = rate >= 0;
        const sign = isUp ? '+' : '';
        const color = isUp ? '#34d399' : '#f87171';
        const stroke = isUp ? '#10b981' : '#ef4444';

        // 1. 주식 카드 및 테이블 가격/등락률 갱신 (전체 다중 엘리먼트 업데이트)
        document.querySelectorAll(`[data-stock-price="${sid}"]`).forEach(el => {
          el.innerText = newPrice.toLocaleString() + '원';
          el.style.color = color;
          setTimeout(() => { el.style.color = '#38bdf8'; }, 2500);
        });

        document.querySelectorAll(`[data-stock-rate="${sid}"]`).forEach(el => {
          el.innerText = `${sign}${rate.toFixed(2)}%`;
          el.style.color = color;
          if (el.tagName === 'SPAN') {
            el.style.background = isUp ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
          }
        });

        // 2. 스파크라인 차트 색상 갱신
        const sparkLine = document.getElementById(`spark-line-${sid}`);
        const sparkFill = document.getElementById(`spark-fill-${sid}`);
        if (sparkLine) {
          sparkLine.setAttribute('stroke', stroke);
          sparkLine.setAttribute('d', isUp ? 'M0,22 Q25,18 50,12 T100,4' : 'M0,4 Q25,10 50,18 T100,24');
        }
        if (sparkFill) {
          sparkFill.setAttribute('d', isUp ? 'M0,22 Q25,18 50,12 T100,4 L100,28 L0,28 Z' : 'M0,4 Q25,10 50,18 T100,24 L100,28 L0,28 Z');
        }

        // 3. 내 보유 주식 테이블 실시간 평가액 갱신
        const hPriceEl = document.querySelector(`[data-hprice="${sid}"]`);
        const hEvalEl = document.querySelector(`[data-heval="${sid}"]`);
        if (hPriceEl) hPriceEl.innerText = newPrice.toLocaleString() + '원';
        if (hEvalEl) {
          const row = document.querySelector(`[data-holding-stock="${sid}"]`);
          if (row) {
            const amountText = row.children[1].innerText.replace(/[^0-9]/g, '');
            const amount = Number(amountText) || 0;
            const evalVal = amount * newPrice;
            hEvalEl.innerText = evalVal.toLocaleString() + '원';
            newTotalStockVal += evalVal;
          }
        }
      });

      if (data.regime && data.regime.name) {
        const regEl = document.getElementById('market-regime-badge');
        if (regEl) regEl.innerText = data.regime.name;
      }
    });
  }

  function openOrderModal(action, stockId, stockName, price) {
    const priceEl = document.querySelector(`[data-stock-price="${stockId}"]`);
    if (priceEl) {
      const parsed = parseInt(priceEl.innerText.replace(/[^0-9]/g, ''));
      if (parsed > 0) price = parsed;
    }

    const stockCard = document.querySelector(`.stock-card[data-stock-id="${stockId}"]`) || document.querySelector(`tr[data-stock-id="${stockId}"]`);
    let remainingShares = null;
    let totalSharesLimit = null;
    if (stockCard) {
      const rem = stockCard.getAttribute('data-remaining-shares');
      const tot = stockCard.getAttribute('data-total-shares-limit');
      if (rem !== null && rem !== '') remainingShares = Number(rem);
      if (tot !== null && tot !== '') totalSharesLimit = Number(tot);
    }

    currentOrder = { action, stockId, price, remainingShares, totalSharesLimit };
    document.getElementById('modal-order-title').innerText = `주식 ${action === 'BUY' ? '매수' : '매도'} 주문`;
    document.getElementById('modal-stock-name').innerText = stockName;
    document.getElementById('modal-stock-price').innerText = price.toLocaleString() + '원';
    document.getElementById('modal-order-amount').value = 1;
    
    const remEl = document.getElementById('modal-stock-remaining');
    if (remEl) {
      if (action === 'BUY') {
        if (remainingShares !== null) {
          if (remainingShares <= 0) {
            remEl.innerHTML = '<span style="color:#ef4444; font-weight:900;">🔴 매진됨 (추가 매수 불가)</span>';
          } else {
            remEl.innerHTML = `<span style="color:#34d399; font-weight:800;">잔여 ${remainingShares.toLocaleString()}주 / 총 ${totalSharesLimit.toLocaleString()}주</span>`;
          }
        } else {
          remEl.innerText = '무제한 공급';
        }
      } else {
        remEl.innerText = '보유 수량 내 자유 매도 가능';
      }
    }

    const submitBtn = document.getElementById('modal-submit-btn');
    if (action === 'BUY') {
      submitBtn.style.background = (remainingShares !== null && remainingShares <= 0) ? '#475569' : 'linear-gradient(135deg,#059669,#10b981)';
      submitBtn.innerText = (remainingShares !== null && remainingShares <= 0) ? '❌ 매진되어 매수 불가' : '매수 체결하기';
      submitBtn.disabled = (remainingShares !== null && remainingShares <= 0);
    } else {
      submitBtn.style.background = 'linear-gradient(135deg,#dc2626,#ef4444)';
      submitBtn.innerText = '매도 체결하기';
      submitBtn.disabled = false;
    }
    
    updateModalTotal();
    document.getElementById('order-modal').classList.add('is-open');
  }

  function closeOrderModal() {
    document.getElementById('order-modal').classList.remove('is-open');
  }

  function setOrderPercent(pct) {
    const cash = Number('<%= (typeof userAssets !== "undefined" && userAssets && userAssets.cash) ? userAssets.cash : 0 %>');
    if (currentOrder.action === 'BUY') {
      if (currentOrder.price <= 0) return;
      let maxShares = Math.floor((cash * pct) / currentOrder.price);
      if (currentOrder.remainingShares !== null && currentOrder.remainingShares !== undefined) {
        maxShares = Math.min(maxShares, currentOrder.remainingShares);
      }
      document.getElementById('modal-order-amount').value = Math.max(1, maxShares);
    } else {
      document.getElementById('modal-order-amount').value = Math.max(1, Math.floor(10 * pct));
    }
    updateModalTotal();
  }

  function updateModalTotal() {
    const amount = Number(document.getElementById('modal-order-amount').value) || 0;
    const total = amount * currentOrder.price;
    document.getElementById('modal-order-total').innerText = total.toLocaleString() + '원';
  }

  function showStockToast(msg, isSuccess = true) {
    const toast = document.createElement('div');
    toast.style.position = 'fixed';
    toast.style.top = '24px';
    toast.style.right = '24px';
    toast.style.zIndex = '99999';
    toast.style.background = isSuccess ? 'rgba(15, 23, 42, 0.95)' : 'rgba(30, 10, 15, 0.95)';
    toast.style.border = isSuccess ? '1px solid rgba(52, 211, 153, 0.5)' : '1px solid rgba(239, 68, 68, 0.5)';
    toast.style.boxShadow = '0 10px 30px rgba(0,0,0,0.8), 0 0 15px ' + (isSuccess ? 'rgba(52,211,153,0.3)' : 'rgba(239,68,68,0.3)');
    toast.style.borderRadius = '12px';
    toast.style.padding = '12px 20px';
    toast.style.color = '#fff';
    toast.style.fontSize = '13.5px';
    toast.style.fontWeight = '800';
    toast.innerText = msg;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(-10px)';
      toast.style.transition = 'all 0.3s ease';
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  async function submitOrder() {
    const amount = Number(document.getElementById('modal-order-amount').value) || 0;
    if (amount <= 0) { showStockToast('수량을 입력하세요.', false); return; }

    const url = currentOrder.action === 'BUY' ? '/api/stocks/buy' : '/api/stocks/sell';
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ stockId: currentOrder.stockId, amount })
      });
      const data = await res.json();
      if (data.success) {
        showStockToast(`🎉 주식 ${currentOrder.action === 'BUY' ? '매수' : '매도'}가 체결되었습니다!`, true);
        closeOrderModal();
        setTimeout(() => window.location.reload(), 800);
      } else {
        showStockToast(data.error || '주문 실패', false);
      }
    } catch (e) { showStockToast('네트워크 오류가 발생했습니다.', false); }
  }

  async function claimDividends() {
    try {
      const res = await fetch('/api/stocks/dividends/claim', { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        showStockToast(`💰 배당금 +${Number(data.reward || 0).toLocaleString()}원이 지급되었습니다!`, true);
        setTimeout(() => window.location.reload(), 800);
      } else {
        showStockToast(data.error || '수령 가능한 배당금이 없습니다.', false);
      }
    } catch (e) { showStockToast('배당금 수령 요청 실패', false); }
  }

  function switchView(mode) {
    const cardCont = document.getElementById('stocks-cards-container');
    const tableCont = document.getElementById('stocks-table-container');
    const btnCard = document.getElementById('btn-view-cards');
    const btnTable = document.getElementById('btn-view-table');

    if (mode === 'cards') {
      cardCont.style.display = 'grid';
      tableCont.style.display = 'none';
      btnCard.classList.add('active');
      btnTable.classList.remove('active');
    } else {
      cardCont.style.display = 'none';
      tableCont.style.display = 'block';
      btnCard.classList.remove('active');
      btnTable.classList.add('active');
    }
  }

  function filterSector(category, btn) {
    document.querySelectorAll('.stock-filter-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    else if (event && event.currentTarget) event.currentTarget.classList.add('active');

    const cards = document.querySelectorAll('.stock-card');
    const tableRows = document.querySelectorAll('#stocks-table-container tbody tr');
    
    cards.forEach(card => {
      const cats = (card.dataset.categories || '').split(' ');
      if (category === 'ALL' || cats.includes(category)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    tableRows.forEach(row => {
      const cats = (row.dataset.categories || '').split(' ');
      if (category === 'ALL' || cats.includes(category)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  // 📈 실시간 종목 상세 차트 모달 & 타임프레임 전환
  let currentDetailStock = null;
  let cachedDetailHistory = [];
  let currentTfLimit = 15;

  async function openDetailModal(stockId) {
    const modal = document.getElementById('detail-modal');
    modal.classList.add('is-open');
    modal.style.display = 'flex';
    document.getElementById('detail-stock-name').innerText = '데이터 로딩 중...';
    document.getElementById('detail-chart-svg').innerHTML = '<span style="color:#94a3b8; font-size:13px;">차트를 불러오는 중...</span>';

    try {
      const res = await fetch('/api/stocks/' + stockId);
      const data = await res.json();
      if (!data.success || !data.stock) {
        alert(data.error || '종목 정보를 불러올 수 없습니다.');
        closeDetailModal();
        return;
      }

      const s = data.stock;
      currentDetailStock = s;
      cachedDetailHistory = data.history || [];

      const price = Number(s.price || 0);
      const prevPrice = Number(s.prev_price || price || 1);
      const diff = price - prevPrice;
      const rate = prevPrice > 0 ? ((diff / prevPrice) * 100) : 0;
      const isUp = diff >= 0;
      const sign = isUp ? '+' : '';
      const color = isUp ? '#34d399' : '#f87171';

      document.getElementById('detail-symbol').innerText = '[' + (s.stock_id) + ']';
      document.getElementById('detail-sector').innerText = s.sector || '주식';
      document.getElementById('detail-stock-name').innerText = s.name;
      document.getElementById('detail-price').innerText = price.toLocaleString() + '원';
      document.getElementById('detail-rate').innerText = `${sign}${rate.toFixed(2)}%`;
      document.getElementById('detail-rate').style.color = color;
      document.getElementById('detail-prev').innerText = `이전가 ${prevPrice.toLocaleString()}원`;

      document.getElementById('detail-high').innerText = Number(s.high_24h || price).toLocaleString() + '원';
      document.getElementById('detail-low').innerText = Number(s.low_24h || price).toLocaleString() + '원';
      
      const cap = Number(s.market_cap || (price * 10000000));
      document.getElementById('detail-cap').innerText = (cap >= 1000000000000) 
        ? (cap / 1000000000000).toFixed(1) + '조원' 
        : (cap / 100000000).toLocaleString() + '억원';

      const userHold = Number(s.userHolding || 0);
      const stackStr = userHold > 0 ? (userHold / 10).toFixed(1) + '스택' : '0스택';
      document.getElementById('detail-my-holding').innerText = `${userHold.toLocaleString()}주 (${stackStr})`;
      document.getElementById('detail-my-avg').innerText = Number(s.userAvgPrice || 0).toLocaleString() + '원';
      document.getElementById('detail-description').innerText = s.description || `${s.name} 실시간 거래 종목`;

      renderDetailChart(cachedDetailHistory.slice(-currentTfLimit), isUp);
    } catch (e) {
      alert('종목 정보 통신에 실패했습니다.');
      closeDetailModal();
    }
  }

  function closeDetailModal() {
    const modal = document.getElementById('detail-modal');
    modal.classList.remove('is-open');
    modal.style.display = 'none';
  }

  function switchChartTf(btn, limit) {
    document.querySelectorAll('.chart-tf-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    currentTfLimit = limit;
    if (cachedDetailHistory && cachedDetailHistory.length > 0) {
      const isUp = currentDetailStock ? (currentDetailStock.price >= currentDetailStock.prev_price) : true;
      renderDetailChart(cachedDetailHistory.slice(-limit), isUp);
    }
  }

  function tradeFromDetail(action) {
    if (!currentDetailStock) return;
    const s = currentDetailStock;
    closeDetailModal();
    openOrderModal(action, s.stock_id, s.name, Number(s.price || 0));
  }

  function renderDetailChart(historyData, isUp) {
    const box = document.getElementById('detail-chart-svg');
    let prices = (historyData || []).map(h => typeof h === 'number' ? h : Number(h.price || 0)).filter(p => p > 0);
    if (!prices || prices.length < 2) {
      const p = currentDetailStock ? Number(currentDetailStock.price || 1000) : 1000;
      prices = [Math.round(p * 0.98), Math.round(p * 0.99), p, Math.round(p * 1.01), p];
    }

    const min = Math.min(...prices);
    const max = Math.max(...prices);
    const range = max - min || 1;
    const width = 480;
    const height = 180;
    const padX = 14;
    const padY = 20;

    const points = prices.map((p, i) => {
      const x = padX + (i / (prices.length - 1)) * (width - padX * 2);
      const y = height - padY - ((p - min) / range) * (height - padY * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    }).join(' ');

    const stroke = isUp ? '#10b981' : '#ef4444';
    const fill = isUp ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)';
    const area = `${padX},${height} ${points} ${width - padX},${height}`;

    box.innerHTML = `
      <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" style="display:block;">
        <line x1="${padX}" y1="${padY}" x2="${width - padX}" y2="${padY}" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4,4"/>
        <line x1="${padX}" y1="${height / 2}" x2="${width - padX}" y2="${height / 2}" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4,4"/>
        <line x1="${padX}" y1="${height - padY}" x2="${width - padX}" y2="${height - padY}" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4,4"/>
        <polygon points="${area}" fill="${fill}"/>
        <polyline points="${points}" fill="none" stroke="${stroke}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="${points.split(' ').pop().split(',')[0]}" cy="${points.split(' ').pop().split(',')[1]}" r="4" fill="${stroke}" stroke="#fff" stroke-width="1.5"/>
      </svg>
      <div style="position:absolute; top:6px; right:10px; font-size:11px; font-family:'JetBrains Mono',monospace; color:#64748b;">
        최고 ${max.toLocaleString()} / 최저 ${min.toLocaleString()}
      </div>
    `;
  }
</script>

<%- include('layout/footer', { activePage: 'stocks' }) %>
