<%- include('layout/header', { pageTitle: '월덕 럭셔리 카지노 & 게임 허브', activePage: 'casino' }) %>

<style>
  /* 🎰 럭셔리 카지노 허브 스타일 */
  .casino-hero {
    background: radial-gradient(circle at 50% 0%, rgba(244, 63, 94, 0.15), rgba(15, 23, 42, 0.95) 70%);
    border: 1px solid rgba(244, 63, 94, 0.3);
    border-radius: 20px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .casino-nav-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    margin-bottom: 20px;
    padding-bottom: 4px;
  }
  .casino-tab-btn {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 8px 16px;
    color: #94a3b8;
    font-size: 13.5px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .casino-tab-btn:hover, .casino-tab-btn.active {
    background: rgba(244, 63, 94, 0.2);
    border-color: rgba(244, 63, 94, 0.6);
    color: #fff;
    box-shadow: 0 0 15px rgba(244, 63, 94, 0.3);
  }

  .game-container {
    background: #0b0f19;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7);
    display: none;
  }
  .game-container.active {
    display: block;
    animation: fadeIn 0.25s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 🔴 플링코 보드 */
  .plinko-canvas {
    background: #070a13;
    border: 2px solid rgba(244, 63, 94, 0.3);
    border-radius: 16px;
    width: 100%;
    max-width: 500px;
    height: 380px;
    display: block;
    margin: 0 auto 16px auto;
  }

  /* 💣 마인즈 5x5 그리드 */
  .mines-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    max-width: 380px;
    margin: 0 auto 16px auto;
  }
  .mine-tile {
    aspect-ratio: 1/1;
    background: #1e293b;
    border: 2px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }
  .mine-tile:hover {
    background: #334155;
    border-color: #38bdf8;
    transform: scale(1.04);
  }
  .mine-tile.revealed {
    background: #0f172a;
    border-color: #10b981;
    cursor: default;
    transform: none;
  }
  .mine-tile.boom {
    background: rgba(239, 68, 68, 0.3);
    border-color: #ef4444;
  }

  /* 🃏 블랙잭 테이블 */
  .bj-table {
    background: radial-gradient(circle, #065f46 0%, #022c22 100%);
    border: 4px solid #b45309;
    border-radius: 24px;
    padding: 24px;
    color: #fff;
    max-width: 600px;
    margin: 0 auto 16px auto;
    box-shadow: inset 0 0 40px rgba(0,0,0,0.6);
  }
  .card-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 76px;
    background: #fff;
    color: #000;
    border-radius: 8px;
    font-weight: 900;
    font-size: 18px;
    margin: 0 4px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
  }

  /* 🎰 777 슬롯머신 */
  .slot-machine {
    background: linear-gradient(180deg, #1e1b4b 0%, #0f172a 100%);
    border: 3px solid #f59e0b;
    border-radius: 24px;
    padding: 24px;
    max-width: 480px;
    margin: 0 auto 16px auto;
    text-align: center;
    box-shadow: 0 0 40px rgba(245, 158, 11, 0.3);
  }
  .slot-reels {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 16px 0;
  }
  .slot-reel {
    width: 80px;
    height: 100px;
    background: #fff;
    color: #000;
    border-radius: 12px;
    font-size: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 15px rgba(0,0,0,0.4);
  }

  /* 공통 컨트롤 */
  .bet-control-box {
    display: flex;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto 16px auto;
  }
  .bet-input {
    flex: 1;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 10px 14px;
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    font-weight: 700;
  }
  .btn-action-glow {
    padding: 12px 24px;
    font-weight: 900;
    border: none;
    border-radius: 12px;
    color: #fff;
    cursor: pointer;
    font-size: 15px;
    transition: all 0.2s ease;
  }
</style>

<main style="flex:1; padding:16px 16px 140px 16px; width:100%; max-width:1240px; margin:0 auto;">

  <!-- 🏆 카지노 헤더 배너 -->
  <div class="casino-hero">
    <div>
      <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
        <span style="font-size:12px; font-weight:800; padding:3px 8px; background:rgba(244,63,94,0.2); color:#fb7185; border-radius:6px;">공정 확률 100% 검증</span>
      </div>
      <h1 style="font-size:22px; font-weight:900; color:#fff; margin:0;">월덕 럭셔리 카지노 & 엔터테인먼트 허브</h1>
      <p style="font-size:13px; color:#94a3b8; margin:4px 0 0 0;">
        플링코, 마인즈, 블랙잭, 777 슬롯, 복권, 오리 경마 등 실시간 인터랙티브 게임
      </p>
    </div>

    <div>
      <a href="/arcade" style="padding:8px 16px; font-weight:800; background:linear-gradient(135deg,#06b6d4,#3b82f6); border-radius:10px; text-decoration:none; color:#fff; font-size:12.5px; display:inline-flex; align-items:center; gap:6px;">
        <span>🎮</span> <span>보석 맞추기 퍼즐</span>
      </a>
    </div>
  </div>

  <!-- 🎴 게임 전환 네비게이션 탭 -->
  <div class="casino-nav-tabs">
    <button class="casino-tab-btn active" onclick="showGame('plinko')">
      <span>🔴</span> <span>플링코 (Plinko)</span>
    </button>
    <button class="casino-tab-btn" onclick="showGame('mines')">
      <span>💣</span> <span>마인즈 (Mines 5x5)</span>
    </button>
    <button class="casino-tab-btn" onclick="showGame('blackjack')">
      <span>🃏</span> <span>블랙잭 (Blackjack)</span>
    </button>
    <button class="casino-tab-btn" onclick="showGame('slot')">
      <span>🎰</span> <span>777 슬롯머신</span>
    </button>
    <button class="casino-tab-btn" onclick="showGame('lottery')">
      <span>🎫</span> <span>황금 즉석복권</span>
    </button>
    <button class="casino-tab-btn" onclick="showGame('race')">
      <span>🏇</span> <span>오리 그랑프리 경마</span>
    </button>
  </div>

  <!-- 🔴 1. 플링코 (Plinko) 인터랙티브 보드 -->
  <div id="game-plinko" class="game-container active">
    <div style="text-align:center; margin-bottom:16px;">
      <h2 style="font-size:18px; font-weight:900; color:#fb7185; margin:0;">🔴 플링코 (Plinko 12-Pin)</h2>
      <p style="font-size:12.5px; color:#94a3b8; margin:2px 0 0 0;">핀을 타고 떨어지는 공의 최종 슬롯에 따라 최대 100배 당첨!</p>
    </div>

    <canvas id="plinkoCanvas" class="plinko-canvas" width="500" height="380"></canvas>

    <div class="bet-control-box">
      <input type="number" id="plinko-bet" class="bet-input" value="1000" min="100" step="500">
      <select id="plinko-risk" onchange="drawPlinkoBoard()" style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:10px; padding:0 12px; color:#fff; font-weight:700;">
        <option value="low">로우 (안정)</option>
        <option value="medium" selected>미디엄 (표준)</option>
        <option value="high">하이 (대박 55x)</option>
      </select>
      <button onclick="playPlinkoInteractive()" class="btn-action-glow" style="background:linear-gradient(135deg,#f43f5e,#fb7185);">공 투하!</button>
    </div>
  </div>

  <!-- 💣 2. 마인즈 (Mines 5x5) 인터랙티브 보드 -->
  <div id="game-mines" class="game-container">
    <div style="text-align:center; margin-bottom:16px;">
      <h2 style="font-size:18px; font-weight:900; color:#34d399; margin:0;">💣 마인즈 5x5 (Mines)</h2>
      <p style="font-size:12.5px; color:#94a3b8; margin:2px 0 0 0;">숨겨진 지뢰를 피해 다이아몬드를 수집하고 언제든 캐시아웃하세요!</p>
    </div>

    <div style="text-align:center; margin-bottom:12px;">
      <span style="font-size:14px; color:#94a3b8;">현재 캐시아웃 배율: </span>
      <strong id="mines-mult" style="font-size:20px; color:#38bdf8; font-family:'JetBrains Mono',monospace;">1.00x</strong>
    </div>

    <div id="mines-grid-box" class="mines-grid">
      <!-- 25개 타일 동적 생성 -->
    </div>

    <div class="bet-control-box">
      <input type="number" id="mines-bet" class="bet-input" value="2000" min="500" step="1000">
      <select id="mines-count" style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:10px; padding:0 12px; color:#fff; font-weight:700;">
        <option value="1">지뢰 1개</option>
        <option value="3" selected>지뢰 3개</option>
        <option value="5">지뢰 5개</option>
      </select>
      <button id="mines-start-btn" onclick="startMinesInteractive()" class="btn-action-glow" style="background:linear-gradient(135deg,#059669,#10b981);">탐사 시작</button>
      <button id="mines-cashout-btn" onclick="cashoutMinesInteractive()" class="btn-action-glow" style="background:linear-gradient(135deg,#d97706,#f59e0b); display:none;">💰 캐시아웃</button>
    </div>
  </div>

  <!-- 🃏 3. 블랙잭 (Blackjack) 인터랙티브 테이블 -->
  <div id="game-blackjack" class="game-container">
    <div style="text-align:center; margin-bottom:16px;">
      <h2 style="font-size:18px; font-weight:900; color:#c084fc; margin:0;">🃏 블랙잭 정통 카드 대전</h2>
      <p style="font-size:12.5px; color:#94a3b8; margin:2px 0 0 0;">딜러와의 1대1 두뇌 심리전! 21점에 가장 가깝게 만드세요.</p>
    </div>

    <div class="bj-table">
      <!-- 딜러 영역 -->
      <div style="text-align:center; margin-bottom:20px;">
        <div style="font-size:12px; color:#a7f3d0; margin-bottom:6px; font-weight:700;">DEALER</div>
        <div id="dealer-cards">
          <div class="card-slot">🂠</div>
          <div class="card-slot">🂠</div>
        </div>
      </div>

      <!-- 플레이어 영역 -->
      <div style="text-align:center;">
        <div id="player-cards" style="margin-bottom:6px;">
          <div class="card-slot">🂠</div>
          <div class="card-slot">🂠</div>
        </div>
        <div style="font-size:12px; color:#a7f3d0; font-weight:700;">PLAYER</div>
      </div>
    </div>

    <div class="bet-control-box">
      <input type="number" id="bj-bet" class="bet-input" value="5000" min="1000" step="1000">
      <button onclick="startBlackjackGame()" class="btn-action-glow" style="background:linear-gradient(135deg,#9333ea,#c084fc);">베팅 & 카드 받기</button>
    </div>
  </div>

  <!-- 🎰 4. 777 슬롯머신 -->
  <div id="game-slot" class="game-container">
    <div style="text-align:center; margin-bottom:16px;">
      <h2 style="font-size:18px; font-weight:900; color:#fbbf24; margin:0;">🎰 행운의 777 슬롯머신</h2>
      <p style="font-size:12.5px; color:#94a3b8; margin:2px 0 0 0;">3개의 릴이 일치하면 대박 당첨!</p>
    </div>

    <div class="slot-machine">
      <div class="slot-reels">
        <div id="slot-reel-1" class="slot-reel">7️⃣</div>
        <div id="slot-reel-2" class="slot-reel">7️⃣</div>
        <div id="slot-reel-3" class="slot-reel">7️⃣</div>
      </div>
      <div id="slot-msg" style="font-size:14px; color:#fbbf24; font-weight:800; min-height:20px;">레버를 당겨 잭팟에 도전하세요!</div>
    </div>

    <div class="bet-control-box">
      <input type="number" id="slot-bet" class="bet-input" value="1000" min="500" step="500">
      <button onclick="spinSlotInteractive()" class="btn-action-glow" style="background:linear-gradient(135deg,#f59e0b,#fbbf24); color:#000;">레버 당기기</button>
    </div>
  </div>

  <!-- 🎫 5. 즉석복권 -->
  <div id="game-lottery" class="game-container">
    <div style="text-align:center; margin-bottom:16px;">
      <h2 style="font-size:18px; font-weight:900; color:#38bdf8; margin:0;">🎫 황금 즉석복권 (Scratch)</h2>
      <p style="font-size:12.5px; color:#94a3b8; margin:2px 0 0 0;">3개의 심볼을 긁어 즉석에서 최대 77배 당첨금을 획득하세요!</p>
    </div>

    <div class="slot-machine" style="border-color:#38bdf8; box-shadow:0 0 30px rgba(56,189,248,0.2);">
      <div class="slot-reels">
        <div id="lottery-1" class="slot-reel">💰</div>
        <div id="lottery-2" class="slot-reel">🦆</div>
        <div id="lottery-3" class="slot-reel">💎</div>
      </div>
      <div id="lottery-msg" style="font-size:14px; color:#38bdf8; font-weight:800; min-height:20px;">즉석복권을 긁어보세요!</div>
    </div>

    <div class="bet-control-box">
      <input type="number" id="lottery-bet" class="bet-input" value="1000" min="500" step="500">
      <button onclick="scratchLotteryInteractive()" class="btn-action-glow" style="background:linear-gradient(135deg,#0284c7,#38bdf8);">복권 긁기</button>
    </div>
  </div>

  <!-- 🏇 6. 오리 그랑프리 경마 -->
  <div id="game-race" class="game-container">
    <div style="text-align:center; margin-bottom:16px;">
      <h2 style="font-size:18px; font-weight:900; color:#facc15; margin:0;">🏇 오리 그랑프리 경마장</h2>
      <p style="font-size:12.5px; color:#94a3b8; margin:2px 0 0 0;">5마리의 오리 질주에 베팅하세요!</p>
    </div>

    <div style="background:#1e293b; border-radius:16px; padding:16px; max-width:560px; margin:0 auto 16px auto;">
      <div style="display:flex; flex-direction:column; gap:8px;">
        <div style="background:#0f172a; padding:8px 12px; border-radius:8px; display:flex; justify-content:space-between; font-size:13px;">
          <span>🦆 1번: 바람의 오리</span> <strong style="color:#facc15;">2.5x</strong>
        </div>
        <div style="background:#0f172a; padding:8px 12px; border-radius:8px; display:flex; justify-content:space-between; font-size:13px;">
          <span>🦆 2번: 황금 꽥꽥이</span> <strong style="color:#facc15;">3.8x</strong>
        </div>
        <div style="background:#0f172a; padding:8px 12px; border-radius:8px; display:flex; justify-content:space-between; font-size:13px;">
          <span>🦆 3번: 폭풍 질주</span> <strong style="color:#facc15;">5.2x</strong>
        </div>
        <div style="background:#0f172a; padding:8px 12px; border-radius:8px; display:flex; justify-content:space-between; font-size:13px;">
          <span>🦆 4번: 벼락 부리</span> <strong style="color:#facc15;">7.0x</strong>
        </div>
        <div style="background:#0f172a; padding:8px 12px; border-radius:8px; display:flex; justify-content:space-between; font-size:13px;">
          <span>🦆 5번: 다크 덕</span> <strong style="color:#facc15;">12.0x</strong>
        </div>
      </div>
    </div>

    <div class="bet-control-box">
      <select id="race-lane" style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:10px; padding:0 12px; color:#fff; font-weight:700;">
        <option value="1">1번: 바람의 오리</option>
        <option value="2">2번: 황금 꽥꽥이</option>
        <option value="3">3번: 폭풍 질주</option>
        <option value="4">4번: 벼락 부리</option>
        <option value="5">5번: 다크 덕</option>
      </select>
      <input type="number" id="race-bet" class="bet-input" value="2000" min="500" step="500">
      <button onclick="startRaceInteractive()" class="btn-action-glow" style="background:linear-gradient(135deg,#ca8a04,#facc15); color:#000;">경마 출발!</button>
    </div>
  </div>

  <!-- 🎮 카지노/게임 결과 예쁜 팝업 모달 -->
  <div id="gameResultModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); backdrop-filter:blur(8px); z-index:99999; align-items:center; justify-content:center; animation:fadeIn 0.2s ease;">
    <div style="background:linear-gradient(145deg, #1e293b, #0f172a); border:1px solid rgba(255,255,255,0.15); border-radius:24px; width:90%; max-width:400px; padding:28px 24px; text-align:center; box-shadow:0 25px 50px -12px rgba(0,0,0,0.8), 0 0 30px rgba(99,102,241,0.25); position:relative;">
      <div id="grm-icon" style="font-size:52px; margin-bottom:12px;">🏇</div>
      <h3 id="grm-title" style="font-size:18px; font-weight:800; color:#fff; margin-bottom:8px;">월덕 그랑프리 경마</h3>
      <div id="grm-badge" style="display:inline-block; padding:4px 14px; border-radius:20px; font-size:13px; font-weight:800; margin-bottom:14px; background:rgba(239,68,68,0.15); color:#f87171; border:1px solid rgba(239,68,68,0.3);">단승 불발</div>
      <div id="grm-message" style="font-size:14.5px; color:#cbd5e1; font-weight:700; line-height:1.5; margin-bottom:20px; background:rgba(0,0,0,0.3); padding:14px 16px; border-radius:12px; border:1px solid rgba(255,255,255,0.06);">1착 2번 질풍노도</div>
      <button type="button" onclick="closeGameResultModal()" style="width:100%; padding:12px; border-radius:12px; background:linear-gradient(135deg, #6366f1, #4f46e5); color:#fff; border:none; font-size:15px; font-weight:800; cursor:pointer; box-shadow:0 4px 15px rgba(99,102,241,0.4);">확인</button>
    </div>
  </div>

</main>

<script>
  function showGame(gameId) {
    document.querySelectorAll('.casino-tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.game-container').forEach(c => c.classList.remove('active'));
    if (window.event && window.event.currentTarget) window.event.currentTarget.classList.add('active');
    const target = document.getElementById('game-' + gameId);
    if (target) {
      target.classList.add('active');
      if (gameId === 'plinko') drawPlinkoBoard();
    }
    try { localStorage.setItem('active_casino_tab', gameId); } catch(e) {}
  }

  // 페이지 진입 시 이전 플레이 탭 복원
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const saved = localStorage.getItem('active_casino_tab') || 'plinko';
      if (saved && document.getElementById('game-' + saved)) {
        document.querySelectorAll('.casino-tab-btn').forEach(b => {
          if (b.getAttribute('onclick') && b.getAttribute('onclick').includes(saved)) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
        document.querySelectorAll('.game-container').forEach(c => c.classList.remove('active'));
        document.getElementById('game-' + saved).classList.add('active');
      }
      drawPlinkoBoard();
      initMinesGrid();
    } catch(e) {}
  });

  function updateLiveHeaderCash(newCash) {
    if (!newCash) return;
    const cashEl = document.getElementById('user-cash-display');
    if (cashEl) cashEl.innerText = Number(newCash).toLocaleString() + '원';
  }

  // 🔴 플링코 인터랙티브 캔버스 렌더러
  function drawPlinkoBoard() {
    const canvas = document.getElementById('plinkoCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, 500, 380);
    // 핀 그리기
    const rows = 9;
    for (let r = 0; r < rows; r++) {
      const cols = r + 3;
      const y = 40 + r * 30;
      const startX = 250 - (cols - 1) * 18;
      for (let c = 0; c < cols; c++) {
        const x = startX + c * 36;
        ctx.beginPath();
        ctx.arc(x, y, 3.5, 0, Math.PI * 2);
        ctx.fillStyle = '#f8fafc';
        ctx.shadowColor = '#fb7185';
        ctx.shadowBlur = 4;
        ctx.fill();
      }
    }
    // 하단 슬롯 배율 그리기 (난이도 동적 연동)
    const riskEl = document.getElementById('plinko-risk');
    const risk = riskEl ? riskEl.value : 'medium';
    const mults = (risk === 'high')
      ? ['55x', '15x', '6x', '2.2x', '0.7x', '0.4x', '0.3x', '0.4x', '0.7x', '2.2x', '6x', '15x', '55x']
      : (risk === 'low')
      ? ['8.8x', '4x', '2.5x', '1.4x', '1.1x', '0.8x', '0.7x', '0.8x', '1.1x', '1.4x', '2.5x', '4x', '8.8x']
      : ['24x', '8x', '4.5x', '1.8x', '0.9x', '0.6x', '0.5x', '0.6x', '0.9x', '1.8x', '4.5x', '8x', '24x'];
    const slotW = 500 / mults.length;
    mults.forEach((m, i) => {
      ctx.fillStyle = (i === 0 || i === mults.length - 1) ? '#ef4444' : (i < 3 || i > mults.length - 4) ? '#f59e0b' : '#3b82f6';
      ctx.fillRect(i * slotW + 2, 330, slotW - 4, 30);
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 10px JetBrains Mono';
      ctx.textAlign = 'center';
      ctx.fillText(m, i * slotW + slotW / 2, 350);
    });
  }

  function showGameResultModal(opt) {
    const modal = document.getElementById('gameResultModal');
    if (!modal) return;
    const isWin = !!opt.isWin;
    document.getElementById('grm-icon').innerText = opt.icon || (isWin ? '🎉' : '💀');
    document.getElementById('grm-title').innerText = opt.title || '게임 결과';
      
      const badge = document.getElementById('grm-badge');
      badge.innerText = opt.badge || (isWin ? '당첨 축하!' : '다음 기회에...');
      if (isWin) {
        badge.style.background = 'rgba(16,185,129,0.15)';
        badge.style.color = '#34d399';
        badge.style.border = '1px solid rgba(16,185,129,0.3)';
      } else {
        badge.style.background = 'rgba(239,68,68,0.15)';
        badge.style.color = '#f87171';
        badge.style.border = '1px solid rgba(239,68,68,0.3)';
      }
      
      document.getElementById('grm-message').innerText = opt.message || '';
      modal.style.display = 'flex';
    }

    function closeGameResultModal() {
      const modal = document.getElementById('gameResultModal');
      if (modal) modal.style.display = 'none';
    }

    async function playPlinkoInteractive() {
      const bet = Number(document.getElementById('plinko-bet').value) || 1000;
      const risk = document.getElementById('plinko-risk').value || 'medium';
      try {
        const res = await fetch('/api/game/plinko', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bet, risk })
        });
        const data = await res.json();
        if (data.success) {
          showGameResultModal({
            title: '🔴 플링코 게임',
            icon: data.isWin ? '🎉' : '🔴',
            isWin: data.isWin,
            badge: data.isWin ? `${data.multiplier}배 당첨!` : '낙첨',
            message: data.message || `결과: ${data.multiplier}배`
          });
          if (data.newCash) updateLiveHeaderCash(data.newCash);
        } else {
          showGameResultModal({ title: '플링코 안내', icon: '⚠️', isWin: false, badge: '오류', message: data.error || '플링코 실패' });
        }
      } catch (e) {
        showGameResultModal({ title: '네트워크 오류', icon: '📡', isWin: false, badge: '오류', message: '서버와 통신할 수 없습니다.' });
      }
    }

    // 💣 마인즈 인터랙티브 5x5 초기화
    let minesActive = false;
    let currentMinesBet = 2000;
    let foundGems = 0;

    function initMinesGrid() {
      const box = document.getElementById('mines-grid-box');
      if (!box) return;
      box.innerHTML = '';
      for (let i = 0; i < 25; i++) {
        const tile = document.createElement('div');
        tile.className = 'mine-tile';
        tile.dataset.index = i;
        tile.innerText = '❓';
        tile.onclick = () => onMineTileClick(tile);
        box.appendChild(tile);
      }
    }
    initMinesGrid();

    function startMinesInteractive() {
      minesActive = true;
      foundGems = 0;
      currentMinesBet = Number(document.getElementById('mines-bet').value) || 2000;
      document.getElementById('mines-mult').innerText = '1.00x';
      document.getElementById('mines-start-btn').style.display = 'none';
      document.getElementById('mines-cashout-btn').style.display = 'inline-block';
      initMinesGrid();
    }

    function onMineTileClick(tile) {
      if (!minesActive || tile.classList.contains('revealed')) return;
      tile.classList.add('revealed');
      // 85% 확률 다이아몬드, 15% 지뢰
      if (Math.random() < 0.85) {
        tile.innerText = '💎';
        foundGems++;
        const mult = (1 + foundGems * 0.35).toFixed(2);
        document.getElementById('mines-mult').innerText = mult + 'x';
      } else {
        tile.classList.add('boom');
        tile.innerText = '💣';
        minesActive = false;
        showGameResultModal({
          title: '💣 마인즈 게임',
          icon: '💥',
          isWin: false,
          badge: '폭탄 폭발',
          message: '지뢰를 밟았습니다! 베팅금을 잃었습니다.'
        });
        document.getElementById('mines-start-btn').style.display = 'inline-block';
        document.getElementById('mines-cashout-btn').style.display = 'none';
      }
    }

    async function cashoutMinesInteractive() {
      if (!minesActive || foundGems === 0) {
        showGameResultModal({ title: '마인즈 안내', icon: '💎', isWin: false, badge: '안내', message: '먼저 다이아몬드를 1개 이상 찾으세요!' });
        return;
      }
      const mult = (1 + foundGems * 0.35).toFixed(2);
      try {
        const res = await fetch('/api/game/mines/cashout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bet: currentMinesBet, multiplier: Number(mult) })
        });
        const data = await res.json();
        if (data.success) {
          showGameResultModal({
            title: '💣 마인즈 게임',
            icon: '💎',
            isWin: true,
            badge: `${mult}배 캐시아웃 성공!`,
            message: data.message || `안전하게 보상을 수령했습니다.`
          });
          if (data.newCash) updateLiveHeaderCash(data.newCash);
        } else {
          showGameResultModal({ title: '마인즈 안내', icon: '⚠️', isWin: false, badge: '실패', message: data.error || '캐시아웃 실패' });
        }
      } catch (e) {
        showGameResultModal({ title: '네트워크 오류', icon: '📡', isWin: false, badge: '오류', message: '서버와 통신할 수 없습니다.' });
      }
      minesActive = false;
      document.getElementById('mines-start-btn').style.display = 'inline-block';
      document.getElementById('mines-cashout-btn').style.display = 'none';
    }

    // 🃏 블랙잭 게임
