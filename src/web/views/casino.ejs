          });
          if (data.newCash) updateLiveHeaderCash(data.newCash);
        } else {
          showGameResultModal({ title: '블랙잭 안내', icon: '⚠️', isWin: false, badge: '실패', message: data.error || '게임 시작 실패' });
        }
      } catch (e) {
        showGameResultModal({ title: '네트워크 오류', icon: '📡', isWin: false, badge: '오류', message: '서버와 통신할 수 없습니다.' });
      }
    }

    // 🎰 슬롯머신
    async function spinSlotInteractive() {
      const bet = Number(document.getElementById('slot-bet').value) || 1000;
      try {
        const res = await fetch('/api/game/slot', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bet })
        });
        const data = await res.json();
        if (data.success) {
          const reels = data.payload?.reels || data.details?.slots;
          if (reels && reels.length >= 3) {
            document.getElementById('slot-reel-1').innerText = reels[0];
            document.getElementById('slot-reel-2').innerText = reels[1];
            document.getElementById('slot-reel-3').innerText = reels[2];
          }
          document.getElementById('slot-msg').innerText = data.message || (data.isWin ? '🎉 축하합니다! 당첨되었습니다!' : '아쉽게도 낙첨되었습니다.');
          if (data.newCash) updateLiveHeaderCash(data.newCash);
        } else {
          showGameResultModal({ title: '슬롯머신 안내', icon: '⚠️', isWin: false, badge: '실패', message: data.error || '슬롯 실행 실패' });
        }
      } catch (e) {
        showGameResultModal({ title: '네트워크 오류', icon: '📡', isWin: false, badge: '오류', message: '서버와 통신할 수 없습니다.' });
      }
    }

    // 🎫 즉석복권
