  return `
    <section id="features" class="w-landing__features">
      <div class="w-landing__features-head">
        <h2 class="w-landing__features-title">주요 기능</h2>
        <p class="w-text-muted">실제 경제처럼 작동하는 6가지 핵심 시스템</p>
      </div>
      <div class="w-landing__features-grid">
        ${html}
      </div>
    </section>
  `;
}

function renderMarkets(stocks, leaderboard, regime, news) {
  const stockList = (stocks || []).slice(0, 8);
  const stocksHtml = stockList.length > 0
    ? stockList.map(s => {
      const up = Number(s.rate || 0) >= 0;
      const sign = up ? '+' : '';
      return `
        <div class="w-stat" style="cursor:pointer;" onclick="document.getElementById('wtrd-login-modal').classList.add('is-open')">
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="w-badge w-badge--accent">${escapeHtml(s.stock_id)}</span>
            <span style="font-size:var(--w-text-xs);color:var(--w-text-muted);">${escapeHtml(s.sector || '가상 증시')}</span>
          </div>
          <div style="font-weight:700;font-size:var(--w-text-sm);margin-top:6px;">${escapeHtml(s.name || '')}</div>
          <div class="w-stat__value" style="font-size:var(--w-text-lg);color:${up ? 'var(--w-positive)' : 'var(--w-negative)'};">
            ${fmtMoney(s.price)}원
          </div>
          <div class="w-stat__sub" style="color:${up ? 'var(--w-positive)' : 'var(--w-negative)'};font-weight:700;">
            ${up ? '▲' : '▼'} ${sign}${fmtPercent(s.rate)}%
          </div>
        </div>
      `;
    }).join('')
    : `<div class="w-empty"><div class="w-empty__icon">📉</div><div class="w-empty__title">시장 데이터 로딩 중...</div></div>`;

  const lbHtml = (leaderboard || []).slice(0, 5).map((u, i) => {
    const medal = ['🥇', '🥈', '🥉'][i] || `#${i + 1}`;
    return `
      <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--w-divider);">
        <span style="font-size:22px;width:32px;text-align:center;">${medal}</span>
        <div style="flex:1;min-width:0;">
          <div style="font-weight:700;font-size:var(--w-text-sm);" class="w-truncate">${escapeHtml(u.username || '익명')}</div>
          <div style="font-size:var(--w-text-xs);color:var(--w-text-muted);">순자산</div>
        </div>
        <div style="font-family:var(--w-font-mono);font-weight:800;color:var(--w-accent-hover);font-size:var(--w-text-sm);">
          ${fmtMoney(u.net_worth || u.cash || 0)}원
        </div>
      </div>
    `;
  }).join('');

  const newsHtml = news
    ? `<div class="w-embed w-embed--info">
        <div style="font-weight:700;margin-bottom:6px;font-size:var(--w-text-sm);">📰 최신 속보</div>
        <div>${escapeHtml(news.title || news.text || '')}</div>
      </div>`
    : '';

  return `
    <section id="markets" class="w-landing__features" style="padding-top:0;">
      <div class="w-landing__features-head">
        <h2 class="w-landing__features-title">📈 실시간 시장</h2>
        <p style="color:var(--w-text-muted);">Discord 로그인 후 모든 데이터에 접근할 수 있습니다</p>
      </div>

      ${regime ? `
      <div class="w-card w-mb-4" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <div>
          <div class="w-stat__label">현재 시장 국면</div>
          <div style="font-size:var(--w-text-lg);font-weight:800;">${escapeHtml(regime.name || '—')}</div>
        </div>
        <div>
          <div class="w-stat__label">자동조절</div>
          <span class="w-badge w-badge--positive">🟢 가동 중</span>
        </div>
        <div>
          <div class="w-stat__label">국고</div>
          <div style="font-family:var(--w-font-mono);font-weight:800;">${fmtMoney(treasury(stocks))}원</div>
        </div>
      </div>` : ''}

      ${newsHtml}

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-bottom:var(--w-space-5);">
        ${stocksHtml}
      </div>

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;">
        <div class="w-card">
          <h3 class="w-card__title" style="margin-bottom:12px;">🏆 TOP 5 부자</h3>
          ${lbHtml || '<div class="w-empty">순위 데이터 로딩 중...</div>'}
        </div>
        <div class="w-card">
          <h3 class="w-card__title" style="margin-bottom:12px;">🎮 한 번 시작하기</h3>
          <p style="color:var(--w-text-secondary);font-size:var(--w-text-sm);line-height:1.6;">
            Discord로 로그인하면 즉시 1만 정착금이 지급됩니다. 무료 출석과 지원금으로 무한 성장 가능합니다.
          </p>
          <button type="button" onclick="document.getElementById('wtrd-login-modal').classList.add('is-open')" class="w-btn w-btn--primary" style="margin-top:16px;width:100%;">
            🎮 Discord로 시작
          </button>
        </div>
      </div>
    </section>
  `;
}

function treasury(_stocks) {
  // server에서 받은 treasuryBalance을 options.treasuryBalance로 받음
  return ''; // placeholder; 실제값은 renderLandingPage에서 처리
}

function renderLoginModal(discordLoginUrl) {
  return `
    <div id="wtrd-login-modal" class="w-modal-backdrop" style="display:none;">
      <div class="w-modal">
        <div class="w-modal__head">
          <h3 class="w-modal__title">
            <span style="font-size:24px;">🔐</span>
            <span>Discord 로그인</span>
          </h3>
          <button type="button" class="w-modal__close" onclick="document.getElementById('wtrd-login-modal').classList.remove('is-open')">×</button>
        </div>
        <div class="w-modal__body">
          <p style="color:var(--w-text-secondary);margin-bottom:16px;">
            디스코드 계정으로 로그인하면 다음이 가능합니다:
          </p>
          <ul style="margin:0 0 20px 20px;color:var(--w-text-secondary);line-height:1.8;">
            <li>월덕 가상 경제 전체 기능</li>
            <li>주식 거래, 카지노, 사업, 채굴</li>
            <li>다른 유저와 송금/채팅</li>
            <li>관리자 페이지 접근 (권한자)</li>
          </ul>
          <a href="${escapeHtml(discordLoginUrl)}" class="w-btn w-btn--primary w-btn--lg w-btn--block">
            <span style="font-size:18px;">🎮</span>
            <span>Discord로 계속</span>
          </a>
          <p style="text-align:center;font-size:var(--w-text-xs);color:var(--w-text-muted);margin-top:12px;">
            처음 오셨나요? 새 Discord 계정 생성 →
            <a href="https://discord.com/register" target="_blank" rel="noopener">discord.com/register</a>
          </p>
        </div>
      </div>
    </div>
  `;
}

function renderClosingCta() {
  return `
    <section class="w-landing__features" style="text-align:center;padding-bottom:var(--w-space-9);">
      <div class="w-card" style="background:linear-gradient(135deg,rgba(99,102,241,0.1),rgba(168,85,247,0.1));border-color:rgba(99,102,241,0.3);">
        <h2 class="w-landing__features-title" style="margin-bottom:12px;">지금 바로 시작하세요</h2>
        <p style="color:var(--w-text-secondary);max-width:520px;margin:0 auto var(--w-space-5);">
          Discord 계정과 이메일만 있으면 됩니다. 1분 안에 정착금을 받고 거래를 시작할 수 있습니다.
        </p>
        <button type="button" onclick="document.getElementById('wtrd-login-modal').classList.add('is-open')" class="w-landing__hero-cta">
          <span style="font-size:20px;">🎮</span>
          <span>무료로 시작하기</span>
        </button>
      </div>
    </section>
  `;
}

function renderFooter() {
  return `
    <footer style="border-top:1px solid var(--w-border);padding:var(--w-space-6);text-align:center;color:var(--w-text-muted);font-size:var(--w-text-sm);">
      <div style="max-width:1280px;margin:0 auto;">
        <p>© 2026 월덕 (WTRD) · 디스코드 가상 경제 플랫폼</p>
        <p style="margin-top:var(--w-space-2);font-size:var(--w-text-xs);">
          <a href="/privacy" style="color:var(--w-text-muted);text-decoration:underline;margin:0 var(--w-space-2);">개인정보처리방침</a> ·
          <a href="/auth/guide" style="color:var(--w-text-muted);text-decoration:underline;margin:0 var(--w-space-2);">OAuth 안내</a> ·
          <a href="/api/version" style="color:var(--w-text-muted);text-decoration:underline;margin:0 var(--w-space-2);">상태 확인</a>
        </p>
      </div>
    </footer>
  `;
}

function renderInlineScript(stocks, regime) {
  // 페이지 내장 JS (외부 파일 없어도 동작)
  return `
    <script>
      // 다크/라이트/고대비 테마 자동 감지
      (function() {
        const saved = localStorage.getItem('wtrd-theme');
        if (saved) document.documentElement.setAttribute('data-theme', saved);
        // 자동 새로고침 (3분마다 시장 갱신)
        const stockJson = ${JSON.stringify((stocks || []).slice(0, 8))};
        const regimeJson = ${JSON.stringify(regime || {})};
        function fmtMoney(v) {
          if (!v) return '0';
          return Number(String(v).split('.')[0] || 0).toLocaleString('ko-KR');
        }
        async function refreshMarket() {
          try {
            const res = await fetch('/api/stocks', { credentials: 'same-origin', cache: 'no-store' });
            const data = await res.json();
            if (data && data.stocks) {
              // 작은 데이터 업데이트는 별도 element 없음 (랜딩은 정적)
            }
          } catch (e) {}
        }
        setInterval(refreshMarket, 3 * 60 * 1000);
      })();

      // ESC 키로 모달 닫기
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          const modal = document.getElementById('wtrd-login-modal');
          if (modal) modal.classList.remove('is-open');
        }
      });

      // 모달 배경 클릭으로 닫기
      document.addEventListener('click', function(e) {
        const modal = document.getElementById('wtrd-login-modal');
        if (modal && e.target === modal) modal.classList.remove('is-open');
      });

      // 부드러운 스크롤
      document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', function(e) {
          const target = document.querySelector(this.getAttribute('href'));
          if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        });
      });
    </script>
  `;
}

function renderLandingPage(options) {
  const {
    stocks = [],
    leaderboard = [],
    regime = {},
    news = null,
    treasuryBalance = '0',
    discordLoginUrl = '/auth/discord'
  } = options;

  const memberCount = (leaderboard && leaderboard.length > 0) ? Math.max(...leaderboard.map(u => Number(u.net_worth || u.cash || 0))) : 158;

  return `<!DOCTYPE html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>월덕 (WTRD) - 디스코드 가상 경제 플랫폼</title>
  <meta name="description" content="디스코드 최대 규모의 실시간 가상 경제. 18개 상장 종목 실시간 주식 거래, 자동 배당, 카지노/아케이드, 중앙은행 정책까지.">
  <meta property="og:title" content="월덕 (WTRD) - 가상 경제 플랫폼">
  <meta property="og:description" content="디스코드에서 무료로 시작하는 가상 경제 시스템">
  <link rel="icon" href="/static/img/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Pretendard:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/wtrd-design.css">
  <link rel="stylesheet" href="/static/css/dashboard-ux.css">
  <style>
    /* 랜딩 인라인 보강 스타일 */
    body { font-family: var(--w-font-sans); }
  </style>
</head>
<body>
  <div class="w-landing">
    <div class="w-landing__bg"></div>
    ${renderNav(stocks, regime)}
    ${renderHero(treasuryBalance, (stocks || []).length, memberCount)}
    ${renderMarkets(stocks.map(s => ({ ...s, treasuryBalance })), leaderboard, regime, news)}
    ${renderFeatures()}
    ${renderClosingCta()}
    ${renderFooter()}
    ${renderLoginModal(discordLoginUrl)}
  </div>
  ${renderInlineScript(stocks, regime)}
</body>
</html>`;
}

module.exports = { renderLandingPage };
