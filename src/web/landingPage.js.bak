/**
 * 🦆 월덕(WTRD) 랜딩 페이지 v3
 *
 * 비로그인 방문자에게 표시되는 마케팅/소개 페이지
 * 디자인 시스템: wtrd-design.css (Light/Dark/HighContrast)
 */

function escapeHtml(str) {
  if (str == null) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function fmtMoney(v) {
  if (v === null || v === undefined || v === '') return '0';
  let s = String(v).split('.')[0];
  return Number(s || 0).toLocaleString('ko-KR');
}

function fmtPercent(v) {
  const n = Number(v || 0);
  const sign = n >= 0 ? '+' : '';
  return sign + n.toFixed(2);
}

function fmtDate(d) {
  if (!d) return '';
  try {
    return new Date(d).toLocaleString('ko-KR', { hour: '2-digit', minute: '2-digit' });
  } catch (e) { return ''; }
}

function renderNav(stocks, regime) {
  const liveStocks = (stocks || []).slice(0, 3);
  const liveHtml = liveStocks.map(s => {
    const up = Number(s.rate || 0) >= 0;
    const color = up ? 'var(--w-positive)' : 'var(--w-negative)';
    const arrow = up ? '▲' : '▼';
    return `<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;background:var(--w-bg-input);border-radius:var(--w-radius-pill);font-size:var(--w-text-xs);">
      <span style="font-weight:700;">${escapeHtml(s.stock_id)}</span>
      <span style="color:${color};font-weight:700;">${arrow} ${fmtPercent(s.rate)}%</span>
    </span>`;
  }).join('');
  const regimeName = regime && regime.name ? regime.name : '—';
  return `
    <nav class="w-landing__nav">
      <div class="w-landing__nav-brand">
        <div class="w-sidebar__brand-logo">🦆</div>
        <span>월덕 (WTRD)</span>
      </div>
      <div class="w-landing__nav-actions" style="display:flex;align-items:center;gap:12px;">
        <span class="w-badge w-badge--neutral" title="현재 시장 국면">📊 ${escapeHtml(regimeName)}</span>
        ${liveHtml}
        <a href="#features" class="w-btn w-btn--ghost w-btn--sm">기능</a>
        <a href="#markets" class="w-btn w-btn--ghost w-btn--sm">시세</a>
        <button type="button" onclick="document.getElementById('wtrd-login-modal').classList.add('is-open')" class="w-btn w-btn--primary w-btn--sm">
          로그인 / 시작하기
        </button>
      </div>
    </nav>
  `;
}

function renderHero(treasuryBalance, stockCount, memberCount) {
  return `
    <section class="w-landing__hero">
      <div class="w-landing__hero-badge">
        <span>🚀</span>
        <span>현재 ${memberCount || 158}명 활동 중</span>
      </div>
      <h1 class="w-landing__hero-title">디스코드 최대 규모의<br>가상 경제 & 거래 플랫폼</h1>
      <p class="w-landing__hero-subtitle">
        18개 상장 종목의 실시간 주식 거래, 자동 배당, 중앙은행 정책, 카지노/아케이드 게이밍까지.<br>
        Discord 계정 하나면 무료로 시작할 수 있습니다.
      </p>
      <button type="button" onclick="document.getElementById('wtrd-login-modal').classList.add('is-open')" class="w-landing__hero-cta">
        <span style="font-size:20px;">🎮</span>
        <span>Discord로 무료 시작</span>
        <span style="font-size:18px;">→</span>
      </button>

      <div class="w-landing__stats">
        <div class="w-landing__stat">
          <div class="w-landing__stat-num">${stockCount || 18}</div>
          <div class="w-landing__stat-label">상장 종목</div>
        </div>
        <div class="w-landing__stat">
          <div class="w-landing__stat-num">${memberCount || 158}</div>
          <div class="w-landing__stat-label">활동 유저</div>
        </div>
        <div class="w-landing__stat">
          <div class="w-landing__stat-num">${fmtMoney(treasuryBalance)}</div>
          <div class="w-landing__stat-label">국고 보유액</div>
        </div>
        <div class="w-landing__stat">
          <div class="w-landing__stat-num">24/7</div>
          <div class="w-landing__stat-label">실시간 운영</div>
        </div>
      </div>
    </section>
  `;
}

function renderFeatures() {
  const features = [
    {
      icon: '📈', emoji: '📊',
      title: '실시간 주식 거래',
      desc: '24시간 자동 매칭 엔진. 매수/매도 시 0.3% 슬리피지로 차익거래 차단. 지정가 주문, 배당 자동 지급.'
    },
    {
      icon: '🏦', emoji: '💰',
      title: '중앙은행 정책',
      desc: '자동 균형 알고리즘이 인플레이션/디플레이션을 감지하고 세율·금리·국면을 자동 조절합니다.'
    },
    {
      icon: '⛏️', emoji: '🪙',
      title: '골드 마이닝',
      desc: '클리커 채굴과 자동 채굴 봇. 매일 출석 보상과 정기 지원금으로 시작 자금 보충.'
    },
    {
      icon: '🏢', emoji: '📺',
      title: '12단계 사업',
      desc: '골목 편의점부터 월덕 타운몰까지. 자동 수금 시스템과 직원 고용으로 패시브 인컴.'
    },
    {
      icon: '🎰', emoji: '🎲',
      title: '카지노 + 아케이드',
      desc: '슬롯, 주사위, 블랙잭, 포커, 토토, 크래시, 마인즈, 플링코, 7포커, 경마 — 미션으로 무손실 보상.'
    },
    {
      icon: '💬', emoji: '🌐',
      title: '실시간 광장 채팅',
      desc: '전 서버 유저와 함께하는 라이브 채팅. WebSocket 푸시로 즉시 반영, 멘션/스레드 지원.'
    }
  ];
  const html = features.map(f => `
    <div class="w-landing__feature">
      <div class="w-landing__feature-icon">${f.emoji}</div>
      <h3 class="w-landing__feature-title">${f.title}</h3>
      <p class="w-landing__feature-desc">${f.desc}</p>
