[Unit]
Description=WTRD Duck Economy Automated Docker and Database Backup
After=network.target docker.service

[Service]
Type=oneshot
User=wtrdd
Group=wtrdd
WorkingDirectory=/home/wtrdd/discord-bot
ExecStart=/bin/bash /home/wtrdd/discord-bot/scripts/server_full_backup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
